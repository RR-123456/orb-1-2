#pin,#pout{font-size:10px;line-height:1.6;color:rgba(18,144,255,.45);padding-left:8px;border-left:1px dashed var(--border);min-height:0}
/* IMAGE CARD */
.img-synth-card{border:1px solid rgba(18,144,255,.28);background:rgba(18,144,255,.02);border-radius:6px;overflow:hidden;margin-top:4px;box-shadow:0 0 18px rgba(18,144,255,.07),inset 0 0 30px rgba(0,0,0,.4);transition:box-shadow .3s}
