    minTrackingConfidence: confidence
  };
  try{
    return await HandLandmarker.createFromOptions(vision, opts);
  }catch(e){
    return await HandLandmarker.createFromOptions(vision, { ...opts, baseOptions: { ...opts.baseOptions, delegate: "CPU" } });
  }
}
async function createFaceLandmarker(vision, confidence){
  const opts = {
    baseOptions: { modelAssetPath: "https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task", delegate: "GPU" },
    runningMode: "VIDEO", numFaces: 1, outputFaceBlendshapes: false,
    minFaceDetectionConfidence: confidence,
    minFacePresenceConfidence: confidence,
    minTrackingConfidence: confidence
  };
  try{
    return await FaceLandmarker.createFromOptions(vision, opts);
  }catch(e){
    return await FaceLandmarker.createFromOptions(vision, { ...opts, baseOptions: { ...opts.baseOptions, delegate: "CPU" } });
  }
}

async function initModels(){
  idleText.textContent = "Loading landmark models…";
  visionFileset = await FilesetResolver.forVisionTasks(
    "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/wasm"
  );
  handLandmarker = await createHandLandmarker(visionFileset, DETECTION_CONFIDENCE);
  faceLandmarker = await createFaceLandmarker(visionFileset, DETECTION_CONFIDENCE);
}

/* Rebuild landmarkers in the background at the new confidence level, then swap them in
   atomically once ready — keeps tracking live instead of requiring a restart. */
let rebuildingModels = false;
let pendingConfidence = null;
async function rebuildModelsForConfidence(confidence){
  if(!visionFileset) return;
  if(rebuildingModels){ pendingConfidence = confidence; return; }
  rebuildingModels = true;
  try{
    const [newHand, newFace] = await Promise.all([
      createHandLandmarker(visionFileset, confidence),
      createFaceLandmarker(visionFileset, confidence)
    ]);
    const oldHand = handLandmarker, oldFace = faceLandmarker;
    handLandmarker = newHand;
    faceLandmarker = newFace;
    try{ oldHand && oldHand.close(); }catch(e){}
    try{ oldFace && oldFace.close(); }catch(e){}
  }catch(err){
    console.error('Failed to rebuild models at new confidence:', err);
  }finally{
    rebuildingModels = false;
    if(pendingConfidence !== null){
      const next = pendingConfidence;
      pendingConfidence = null;
      rebuildModelsForConfidence(next);
    }
  }
}

async function startCamera(){
  startBtn.disabled = true;
  startBtn.textContent = "INITIALIZING…";
  try{
    if(!handLandmarker || !faceLandmarker) await initModels();
    const videoConstraints = [
      { width:{ideal:1280}, height:{ideal:720}, frameRate:{ideal:30, max:60}, facingMode:"user" },
      { width:{ideal:960}, height:{ideal:540}, facingMode:"user" }, // fallback if the first is over-constrained
      true // last-resort: whatever the device supports
    ];
    let lastErr = null;
    for(const constraint of videoConstraints){
      try{
        stream = await navigator.mediaDevices.getUserMedia({ video: constraint, audio:false });
        lastErr = null;
        break;
      }catch(err){
        lastErr = err;
        if(err.name !== 'OverconstrainedError' && err.name !== 'ConstraintNotSatisfiedError') throw err;
      }
    }
    if(!stream) throw lastErr;
    video.srcObject = stream;
    stream.getVideoTracks().forEach(track=>{
      track.addEventListener('ended', ()=>{ if(running) stopCamera(); });
    });
    await video.play();
    video.classList.add('p7-live');
    sizeCanvasToContainer();

    idlePanel.classList.add('p7-hidden');
    scanline.classList.remove('p7-active');
    statusVal.textContent = "TRACKING";
    statusVal.style.color = 'var(--cyan)';
    statusVal.style.textShadow = '0 0 6px var(--cyan-glow)';
    stopBtn.style.display = 'block';
    saveMasterBtn.disabled = false;
    running = true;
    fpsWindowStart = performance.now();
    frameCount = 0;
    renderLoop();
  }catch(err){
    idleText.textContent = cameraErrorMessage(err);
    startBtn.disabled = false;
    startBtn.textContent = "ACTIVATE MODULE";
  }
}

function cameraErrorMessage(err){
  switch(err && err.name){
    case 'NotAllowedError':
    case 'SecurityError':
      return "Camera permission denied. Allow camera access for this page in your browser settings and retry.";
    case 'NotFoundError':
    case 'DevicesNotFoundError':
      return "No camera device found. Connect a webcam and retry.";
    case 'NotReadableError':
    case 'TrackStartError':
      return "Camera is already in use by another app or tab. Close it and retry.";
    case 'OverconstrainedError':
    case 'ConstraintNotSatisfiedError':
      return "Camera doesn't support the requested settings. Retry — a lower-resolution fallback will be used.";
    default:
      return "Camera access blocked or unavailable (" + (err && err.message ? err.message : 'unknown error') + "). Check permissions and retry.";
  }
}

function stopCamera(){
  running = false;
  if(rafId) cancelAnimationFrame(rafId);
  lastTickTime = null;
  renderAnchor = null;
  airMouseTargetActive = false;
  releaseGrabbedTemplate();
  if(stream){ stream.getTracks().forEach(t=>t.stop()); stream = null; }
  video.srcObject = null;
  video.classList.remove('p7-live');
  ctx.clearRect(0,0,canvas.width,canvas.height);
  idlePanel.classList.remove('p7-hidden');
  idleText.textContent = "Grant camera access to begin live hand and face tracking. Inference runs entirely in your browser.";
  startBtn.disabled = false;
  startBtn.textContent = "ACTIVATE MODULE";
  stopBtn.style.display = 'none';
  saveMasterBtn.disabled = true;
  statusVal.textContent = "STANDBY";
  statusVal.style.color = '';
  statusVal.style.textShadow = '';
  fpsVal.textContent = "—";
