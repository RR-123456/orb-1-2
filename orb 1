      const key=f.key;if(!key)return'';
      const type=(f.type||'text').toLowerCase();
      const label=(f.label||key).toUpperCase();
      const val=(sec.values||{})[key];
      const id=`isf-${escH(ns)}-${escH(key)}`;
      let input='';
      if(type==='choice'){
        const opts=(f.options||[]).map(o=>`<option value="${escH(o)}"${String(val)===String(o)?' selected':''}>${escH(o)}</option>`).join('');
        input=`<select id="${id}" data-key="${escH(key)}" data-type="choice" style="width:100%;background:rgba(18,144,255,.04);border:1px solid rgba(18,144,255,.2);color:#1290ff;padding:6px;font-family:var(--mono);font-size:9px;border-radius:3px;box-sizing:border-box">${opts}</select>`;
      }else if(type==='toggle'){
        input=`<div class="fg-toggle${val?' on':''}" id="${id}" data-key="${escH(key)}" data-type="toggle" onclick="this.classList.toggle('on')"><span></span></div>`;
      }else{
        const isPw=type==='password';
        input=`<input id="${id}" data-key="${escH(key)}" data-type="${isPw?'password':'text'}" type="${isPw?'password':'text'}" value="${escH(val==null?'':String(val))}" placeholder="${escH(f.placeholder||'')}" style="width:100%;background:rgba(18,144,255,.04);border:1px solid rgba(18,144,255,.2);color:#1290ff;padding:6px;font-family:var(--mono);font-size:9px;border-radius:3px;box-sizing:border-box">`;
      }
      return `<div class="lf" style="margin-bottom:6px"><label style="font-size:7px;color:rgba(18,144,255,.4)">${escH(label)}</label>${input}</div>`;
    }).join('');
    const actionBtn=sec.action_label?`<button class="tbtn" onclick="integratorSettingTest('${escH(ns)}')" style="font-size:8px;letter-spacing:1px;margin-top:4px">${escH(sec.action_label)}</button>`:'';
    return `<div class="isf-section" data-ns="${escH(ns)}" style="padding:8px 9px;border:1px solid var(--border);border-radius:2px;margin-bottom:8px">
      <div style="font-size:9px;color:rgba(18,144,255,.85);margin-bottom:6px">▸ ${escH(sec.title||ns)}</div>
      ${fields}
      <div style="display:flex;gap:6px;align-items:center;margin-top:4px">
        <button class="tbtn" onclick="integratorSettingSave('${escH(ns)}')" style="font-size:8px;letter-spacing:1px">💾 Save</button>
        ${actionBtn}
        <span id="isf-status-${escH(ns)}" style="font-size:7px;color:rgba(18,144,255,.4)"></span>
      </div>
    </div>`;
  }).join('');
}
function integratorSettingSave(ns){
  if(!ws||ws.readyState!==1){toast('Not connected to PRAGON backend yet');return;}
  const section=document.querySelector(`.isf-section[data-ns="${CSS.escape(ns)}"]`);if(!section)return;
  const values={};
  section.querySelectorAll('[data-key]').forEach(w=>{
    const key=w.getAttribute('data-key'),type=w.getAttribute('data-type');
    if(type==='toggle')values[key]=w.classList.contains('on');
    else values[key]=w.value!==undefined?w.value:(w.textContent||'').trim();
  });
  ws.send(JSON.stringify({type:'integrator_settings_save',namespace:ns,values}));
}
function integratorSettingTest(ns){
  if(!ws||ws.readyState!==1){toast('Not connected to PRAGON backend yet');return;}
  ws.send(JSON.stringify({type:'integrator_settings_test',namespace:ns}));
}

// ══════ INTEGRATION — DOCK A WHOLE PROJECT (integrations/) ══════
let integrationList=[];
function integrationRender(){
  if(ws&&ws.readyState===1)ws.send(JSON.stringify({type:'integration_list'}));
}
const INTEG_STATUS_COLOR={running:'rgba(0,255,136,.8)',stopped:'rgba(18,144,255,.4)',installing:'rgba(255,194,71,.85)',error:'rgba(248,113,113,.8)'};
function renderIntegrationList(){
  const el=document.getElementById('integration-list');if(!el)return;
  if(!integrationList.length){el.innerHTML='<div style="text-align:center;padding:16px;color:rgba(18,144,255,.2);font-size:8px;letter-spacing:2px">No projects docked yet.</div>';return;}
  el.innerHTML=integrationList.map(p=>{
    const color=INTEG_STATUS_COLOR[p.status]||'rgba(18,144,255,.4)';
    const canStart=p.status==='stopped'||p.status==='error';
    const canStop=p.status==='running'||p.status==='installing';
    return `<div style="padding:8px 9px;border:1px solid var(--border);border-radius:2px;margin-bottom:6px">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:6px">
        <div style="font-size:9px;color:rgba(18,144,255,.85);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">▸ ${escH(p.name)} <span style="color:rgba(18,144,255,.3);font-size:7px">(${escH(p.runtime)}${p.serves_http?', HTTP':''})</span></div>
        <span style="font-size:6.5px;letter-spacing:1px;color:${color};border:1px solid ${color};padding:1px 5px;border-radius:2px;flex-shrink:0">${p.status.toUpperCase()}</span>
      </div>
      <div style="font-size:8px;color:${p.status==='error'?'rgba(248,113,113,.7)':'rgba(18,144,255,.4)'};margin-top:4px;line-height:1.5">${escH(p.status==='error'&&p.error?p.error:p.description)}</div>
      <div style="display:flex;gap:6px;margin-top:7px;flex-wrap:wrap">
        ${canStart?`<button onclick="integrationStart('${p.slug}')" style="background:none;border:1px solid rgba(0,255,136,.4);color:rgba(0,255,136,.85);cursor:pointer;font-family:var(--mono);font-size:7px;padding:3px 8px;border-radius:2px">▶ Start</button>`:''}
        ${canStop?`<button onclick="integrationStop('${p.slug}')" style="background:none;border:1px solid rgba(255,194,71,.4);color:rgba(255,194,71,.85);cursor:pointer;font-family:var(--mono);font-size:7px;padding:3px 8px;border-radius:2px">■ Stop</button>`:''}
        <button onclick="integrationLogs('${p.slug}')" style="background:none;border:1px solid rgba(18,144,255,.3);color:rgba(18,144,255,.7);cursor:pointer;font-family:var(--mono);font-size:7px;padding:3px 8px;border-radius:2px"> Logs</button>
        <button onclick="integrationDelete('${p.slug}')" style="background:none;border:1px solid rgba(248,113,113,.4);color:rgba(248,113,113,.8);cursor:pointer;font-family:var(--mono);font-size:7px;padding:3px 8px;border-radius:2px">Undock</button>
      </div>
      <div id="integ-logs-${p.slug}" style="display:none;margin-top:7px;background:rgba(0,0,0,.5);border:1px solid rgba(18,144,255,.1);border-radius:2px;padding:6px;font-size:7px;color:rgba(18,144,255,.55);max-height:160px;overflow-y:auto;white-space:pre-wrap;word-break:break-all"></div>
    </div>`;
  }).join('');
}
function integrationUpload(file){
  if(!file.name.toLowerCase().endsWith('.zip')){toast('Only .zip files can be docked as projects.');return;}
  if(!ws||ws.readyState!==1){toast('Not connected to PRAGON backend.');return;}
  const reader=new FileReader();
  reader.onload=()=>{
    const b64=reader.result.split(',')[1]||'';
    ws.send(JSON.stringify({type:'integration_upload',filename:file.name,content:b64}));
    toast('Docking '+file.name+'… this can take a moment.');
  };
  reader.onerror=()=>toast('Could not read file.');
  reader.readAsDataURL(file);
}
function integrationStart(slug){if(ws&&ws.readyState===1)ws.send(JSON.stringify({type:'integration_start',slug}));}
function integrationStop(slug){if(ws&&ws.readyState===1)ws.send(JSON.stringify({type:'integration_stop',slug}));}
function integrationDelete(slug){
  if(!ws||ws.readyState!==1)return;
  if(!confirm(`Undock ${slug}? This deletes its files and environment.`))return;
  ws.send(JSON.stringify({type:'integration_delete',slug}));
}
function integrationLogs(slug){
  const el=document.getElementById('integ-logs-'+slug);if(!el)return;
  const show=el.style.display==='none';
  el.style.display=show?'block':'none';
  if(show&&ws&&ws.readyState===1)ws.send(JSON.stringify({type:'integration_logs',slug}));
}


// ══════ KEYBOARD SHORTCUTS ══════
document.addEventListener('keydown',e=>{
  if(e.key==='Escape'&&actionRecording){actionStopRecording();return;}
  if(e.key==='Escape'&&customDrawOpen){closeCustomDraw();return;}
  if(e.key==='Escape'&&ksxOpen&&!ksxRec){closeKsx();return;}
  if(e.key==='Escape'&&schedOpen){closeScheduler();return;}
  if(e.key==='Escape'&&pulseOpen){closePulse();return;}
  if(e.key==='Escape'&&compassOpen){closeCompass();return;}
    if(e.key==='Escape'&&spOpen){toggleSettings();return;}
  if(e.key==='Escape'&&filesPanelOpen){toggleFilesPanel();return;}
  if(e.key==='Escape'&&forgeOpen){hideForge();return;}
  if(e.key==='F4'){e.preventDefault();toggleMute();}
});

// Init button
{const _i=$('init');if(_i)_i.remove();setStat('Standby');}


</script>

