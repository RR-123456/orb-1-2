(function initTpResizer(){
  const resizer=$('tp-resizer'), side=document.querySelector('#tp .tp-side');
  if(!resizer||!side) return;
  const MIN=110, MAX=400;
  const saved=parseInt(localStorage.getItem('pragon-tp-side-w'),10);
  if(saved && saved>=MIN && saved<=MAX) side.style.width=saved+'px';
  let dragging=false, startX=0, startW=0;
  resizer.addEventListener('mousedown', e=>{
    dragging=true; startX=e.clientX; startW=side.getBoundingClientRect().width;
    resizer.classList.add('dragging');
    document.body.style.userSelect='none';
    e.preventDefault();
  });
  window.addEventListener('mousemove', e=>{
    if(!dragging) return;
    // side panel is to the right of the resizer, so dragging left (negative dx) widens it
    const dx=e.clientX-startX;
    let w=startW-dx;
    w=Math.max(MIN,Math.min(MAX,w));
    side.style.width=w+'px';
  });
  window.addEventListener('mouseup', ()=>{
    if(!dragging) return;
    dragging=false;
    resizer.classList.remove('dragging');
    document.body.style.userSelect='';
    localStorage.setItem('pragon-tp-side-w', Math.round(side.getBoundingClientRect().width));
  });
})();

