const FP_MIME_MAP={py:'text/x-python',js:'text/javascript',html:'text/html',css:'text/css',json:'application/json',txt:'text/plain',md:'text/markdown',csv:'text/csv',xml:'application/xml',yml:'text/yaml',yaml:'text/yaml'};
