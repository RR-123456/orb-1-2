function initCM(){
  const container=$('fg-cm-wrap');
  if(!container||cm)return;
  cm=CodeMirror(container,{
    value:FS.files[FS.activeFile],mode:CM_MODE[FS.activeFile],theme:'P.R.A.G.O.N',
    lineNumbers:true,indentUnit:FS.tabSize,tabSize:FS.tabSize,indentWithTabs:false,
    lineWrapping:FS.wordWrap,matchBrackets:true,autoCloseBrackets:true,styleActiveLine:true,
    extraKeys:{
      'Ctrl-Z':()=>fgUndo(),'Cmd-Z':()=>fgUndo(),'Ctrl-Y':()=>fgRedo(),
      'Shift-Ctrl-Z':()=>fgRedo(),'Shift-Cmd-Z':()=>fgRedo(),
      'Ctrl-Enter':()=>forgeCompile(),'Cmd-Enter':()=>forgeCompile(),
      'Ctrl-S':(cm)=>{cm.save();fgSave();return false;},'Cmd-S':(cm)=>{fgSave();return false;},
      'Ctrl-F':()=>fgToggleSearch(),'Cmd-F':()=>fgToggleSearch()
    }
  });
  cm.setSize('100%','100%');
  cm.on('change',(instance,changeObj)=>{
    if(cmSuppressChange)return;
    // Capture *which file* this keystroke belongs to right now, rather
    // than re-reading FS.activeFile only when the debounced timers below
    // eventually fire. Without this, typing in CSS/JS and then switching
    // to the HTML tab before the 800ms auto-compile timer (or the 300ms
    // history timer) elapses made the debounced callback treat the OLD
    // (non-HTML) text as if it were the active file at fire-time --
    // corrupting the wrong file's undo history, or tokenizing CSS/JS text
    // as HTML in the compiler.
    const editingFile=FS.activeFile;
    const val=instance.getValue();
    FS.files[editingFile]=val;
    fgUpdateStats();
    clearTimeout(FS.histTimer);
    FS.histTimer=setTimeout(()=>{
      const idx=FS.histIdxs[editingFile];const hist=FS.histories[editingFile];
      const nh=[...hist.slice(0,idx+1),val].slice(-50);
      FS.histories[editingFile]=nh;FS.histIdxs[editingFile]=nh.length-1;
      if(editingFile===FS.activeFile)fgUpdateStats();
    },300);
    if(FS.autoRun){clearTimeout(FS.autoTimer);FS.autoTimer=setTimeout(()=>{
      if(editingFile==='html')forgeCompile(val);else forgeCompile();
    },800);}
  });
  requestAnimationFrame(()=>cm.refresh());
}

function fgSetCMFile(fileKey){
  if(!cm)return;
  cmSuppressChange=true;
  cm.setOption('mode',FS.syntaxHL?CM_MODE[fileKey]:null);
  const val=FS.files[fileKey];
  if(cm.getValue()!==val){cm.setValue(val);cm.setCursor({line:0,ch:0});}
  cmSuppressChange=false;
  cm.setOption('lineWrapping',FS.wordWrap);cm.setOption('tabSize',FS.tabSize);cm.setOption('indentUnit',FS.tabSize);
  cm.getWrapperElement().style.fontSize=FS.fontSize+'px';
  requestAnimationFrame(()=>cm.refresh());
}
function fgActivateFile(fileKey){
  // The one safe way to change "which file is being edited". Several
  // places load AI/voice-generated code straight into a specific file
  // (chat attachments, live WS 'code' messages, chat code-extraction) and
  // used to call fgSetCMFile() directly -- that only swaps what's drawn in
  // the editor, it does NOT update FS.activeFile or the tab highlight. So
  // e.g. generated CSS would appear on screen while FS.activeFile silently
  // stayed 'html' and the HTML tab stayed lit: the very next keystroke ran
  // FS.files[FS.activeFile]=val and overwrote the HTML file with whatever
  // was on screen, destroying it. Routing every such load through here
  // keeps state, editor content, and tab highlight from ever splitting.
  FS.activeFile=fileKey;
  if(!forgeMounted)return;
  fgSetCMFile(fileKey);
  document.querySelectorAll('.fg-ftab').forEach((t,i)=>t.classList.toggle('active',['html','css','js'][i]===fileKey));
  fgUpdateStats();
}

function fgUpdateStats(){
  const code=FS.files[FS.activeFile];const lines=code.split('\n').length;
  const el=$('fg-metrics');if(el)el.textContent=`EL:${FS.metrics.elements} · LN:${lines} · TK:${FS.tokens.length} · ${FS.compileTime}`;
  const fl=$('fg-footer-l');
  if(fl)fl.innerHTML=`<span>FILE: <span style="color:#1290ff">${FS.activeFile.toUpperCase()}</span></span><span>LINES: <span style="color:#1290ff">${lines}</span></span><span>TOKENS: <span style="color:#1290ff">${FS.tokens.length}</span></span>`;
  const ub=$('fg-undo'),rb=$('fg-redo');
  if(ub)ub.disabled=FS.histIdxs[FS.activeFile]<=0;
  if(rb)rb.disabled=FS.histIdxs[FS.activeFile]>=(FS.histories[FS.activeFile]?.length||1)-1;
  const as=$('fg-ai-key-status');
  if(as)as.textContent=getKey()?`Connected · ${getModel()}`:'No key — set in Engine Jarvis';
}

function fgUndo(){const idx=FS.histIdxs[FS.activeFile];if(idx<=0)return;FS.files[FS.activeFile]=FS.histories[FS.activeFile][idx-1];FS.histIdxs[FS.activeFile]=idx-1;fgSetCMFile(FS.activeFile);forgeLog('Undo','sys');}
function fgRedo(){const idx=FS.histIdxs[FS.activeFile];const h=FS.histories[FS.activeFile];if(idx>=h.length-1)return;FS.files[FS.activeFile]=h[idx+1];FS.histIdxs[FS.activeFile]=idx+1;fgSetCMFile(FS.activeFile);forgeLog('Redo','sys');}
function fgSave(){const ext=FS.activeFile,blob=new Blob([FS.files[ext]],{type:'text/'+ext});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`forge_output.${ext}`;a.click();forgeLog(`Saved forge_output.${ext}`,'ok');}
function fgBuildFullBundle(){
  const sc='<'+'script>',se='<'+'/script>';
  const raw=FS.files.html;
  // STYLE.css is layered in *addition* to whatever CSS already lives inside
  // the HTML tab's own <head> -- it must never replace it. Previously this
  // function threw away everything outside <body>...</body>, so any page
  // (including F.O.R.G.E's own default template) that wrote its styling as
  // a <style> tag in <head>, as real-world HTML normally does, lost 100%
  // of its CSS in the preview/export and rendered as an unstyled blank page.
  const extraCss=FS.files.css?`<style>/* STYLE.css */\n${FS.files.css}\n</style>`:'';
  const jsTag=`${sc}${FS.files.js}${se}`;
  if(/<html[\s>]/i.test(raw)){
    let out=raw;
    out=/<\/head>/i.test(out)
      ? out.replace(/<\/head>/i,extraCss+'</head>')
      : /<head[^>]*>/i.test(out)
        ? out.replace(/<head[^>]*>/i,m=>m+extraCss)
        : out.replace(/<html[^>]*>/i,m=>m+`<head>${extraCss}</head>`);
    out=/<\/body>/i.test(out)
      ? out.replace(/<\/body>/i,jsTag+'</body>')
      : out+jsTag;
    return out;
  }
  // Fragment (no <html> wrapper) -- build a full document around it.
  return `<!DOCTYPE html><html><head><meta charset="UTF-8">${extraCss}</head><body>${raw}${jsTag}</body></html>`;
}
function fgExport(){
  const full=fgBuildFullBundle();
  const blob=new Blob([full],{type:'text/html'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='forge_export.html';a.click();
  forgeLog('Exported bundle','ok');
}

function forgeLog(msg,t='sys'){
