#conn-label{color:rgba(18,144,255,0.5);font-size:9px;letter-spacing:2px}
#vol-bar-wrap{display:flex;align-items:flex-end;gap:2px;height:22px}
.vs{width:3px;border-radius:2px;transition:height .08s,background .08s;background:rgba(18,144,255,0.15)}

#init{position:fixed;inset:0;z-index:50;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24px;background:radial-gradient(ellipse at center,rgba(0,30,40,.9) 0%,rgba(0,0,0,.98) 70%);transition:opacity .8s}
