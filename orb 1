.p7-mode-row{display:flex; align-items:center; justify-content:space-between; padding:8px 4px 0;}
.p7-dropdown{position:relative;}
.p7-dropdown-trigger{display:flex; align-items:center; gap:5px; font-size:9.5px; letter-spacing:.06em; color:#8899a6; background:transparent; border:1px solid rgba(18,144,255,.28); border-radius:14px; padding:5px 10px; cursor:pointer;}
