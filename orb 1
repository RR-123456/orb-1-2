#sched-bar button:hover,#ksx-bar button:hover,.ksx-form button:hover,.ksx-row button:hover{color:var(--cyan);border-color:var(--cyan);background:rgba(18,144,255,.08)}
#sched-frame{flex:1;width:100%;border:none;display:block;background:#050508}
#ksx-body{flex:1;overflow:auto;padding:20px 24px;font-family:var(--mono);color:rgba(18,144,255,.8);max-width:900px;width:100%;margin:0 auto}
.ksx-hint{font-size:11px;letter-spacing:1px;line-height:1.7;margin-bottom:16px;color:rgba(18,144,255,.6)}
.ksx-hint b{color:var(--cyan)}
.ksx-form{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:8px}
.ksx-form input{background:rgba(0,0,0,.6);border:1px solid rgba(18,144,255,.25);color:var(--cyan);font-family:var(--mono);font-size:12px;padding:7px 10px;border-radius:3px;outline:none}
.ksx-form input:focus{border-color:var(--cyan)}
#ksx-name{flex:1 1 160px}
#ksx-keys{flex:1 1 200px}
#ksx-delay{width:64px}
