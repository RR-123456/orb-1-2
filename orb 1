// Builds a URL that actually resolves to this file's bytes — either the
// blob/server URL already on the record, or (for raw-text snapshots) a
// fresh object URL built from the stored content, with a best-guess mime.
function fpResolveUrl(f){
  if(f.dataUrl) return f.dataUrl;
  if(f.content!=null) return URL.createObjectURL(new Blob([f.content],{type:FP_MIME_MAP[f.ext]||'text/plain'}));
  return null;
}
