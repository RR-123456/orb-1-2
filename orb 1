#compass-overlay-bar button{background:none;border:1px solid rgba(18,144,255,.25);color:rgba(18,144,255,.6);cursor:pointer;font-family:var(--mono);font-size:9px;letter-spacing:2px;padding:5px 12px;border-radius:3px;transition:all .2s}
#compass-overlay-bar button:hover{color:var(--cyan);border-color:var(--cyan);background:rgba(18,144,255,.08)}
#compass-frame{flex:1;width:100%;border:none;display:block;background:#050508}
/* GALLERY OVERLAY */
#gallery-overlay{position:fixed;inset:0;z-index:60;display:none;flex-direction:column;background:rgba(0,0,0,.92);backdrop-filter:blur(10px)}
#gallery-overlay.open{display:flex}
#gallery-overlay-bar{display:flex;align-items:center;justify-content:space-between;padding:10px 16px;border-bottom:1px solid var(--border);background:rgba(0,0,0,.9);flex-shrink:0}
#gallery-overlay-bar .nb-title{font-family:var(--head);font-size:10px;letter-spacing:4px;color:var(--cyan);text-shadow:0 0 12px var(--cyan)}
#gallery-overlay-bar button{background:none;border:1px solid rgba(18,144,255,.25);color:rgba(18,144,255,.6);cursor:pointer;font-family:var(--mono);font-size:9px;letter-spacing:2px;padding:5px 12px;border-radius:3px;transition:all .2s}
#gallery-overlay-bar button:hover{color:var(--cyan);border-color:var(--cyan);background:rgba(18,144,255,.08)}
#gallery-overlay-status{font-family:var(--mono);font-size:9px;letter-spacing:2px;color:rgba(18,144,255,.5)}
#gallery-grid{flex:1;width:100%;overflow-y:auto;padding:18px;display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px;align-content:start}
.gallery-empty{grid-column:1/-1;text-align:center;padding:60px 20px;color:rgba(18,144,255,.4);font-family:var(--mono);font-size:11px;letter-spacing:2px}
.gallery-card{position:relative;border:1px solid rgba(18,144,255,.22);border-radius:6px;overflow:hidden;background:rgba(18,144,255,.02);cursor:pointer;transition:box-shadow .25s,transform .25s}
.gallery-card:hover{box-shadow:0 0 24px rgba(18,144,255,.16);transform:translateY(-2px)}
.gallery-card img{width:100%;height:150px;object-fit:cover;display:block}
.gallery-card-meta{padding:7px 9px;border-top:1px solid rgba(18,144,255,.12)}
.gallery-card-prompt{font-size:10.5px;color:rgba(230,245,255,.8);line-height:1.3;max-height:2.6em;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.gallery-card-time{font-family:var(--mono);font-size:8.5px;letter-spacing:1px;color:rgba(18,144,255,.4);margin-top:3px}
.gallery-card-del{position:absolute;top:6px;right:6px;width:22px;height:22px;border-radius:50%;background:rgba(0,0,0,.65);border:1px solid rgba(255,90,90,.4);color:rgba(255,140,140,.85);font-size:12px;line-height:1;display:flex;align-items:center;justify-content:center;cursor:pointer;opacity:0;transition:opacity .2s}
.gallery-card:hover .gallery-card-del{opacity:1}
.gallery-card-del:hover{background:rgba(255,60,60,.25);border-color:rgba(255,90,90,.8)}
/* CODE MODULE CARD */
.code-module{display:flex;align-items:center;gap:10px;padding:10px 12px;border:1px solid var(--border);border-radius:6px;background:rgba(18,144,255,.03);cursor:pointer;transition:all .2s;margin-top:2px}
.code-module:hover{border-color:var(--cyan);background:rgba(18,144,255,.07);box-shadow:0 0 14px rgba(18,144,255,.08)}
.code-module .cm-icon{width:32px;height:32px;flex-shrink:0;border:1px solid var(--border);border-radius:6px;display:flex;align-items:center;justify-content:center;color:var(--cyan);font-size:13px;font-family:'JetBrains Mono',monospace}
.code-module .cm-info{flex:1;min-width:0}
.code-module .cm-title{font-size:11px;letter-spacing:1px;color:rgba(18,144,255,.9);font-weight:600}
.code-module .cm-sub{font-size:9px;letter-spacing:1px;color:rgba(18,144,255,.4);margin-top:2px;text-transform:uppercase}
.code-module .cm-btn{flex-shrink:0;border:1px solid var(--border);color:var(--cyan);background:none;font-family:var(--mono);font-size:9px;letter-spacing:2px;padding:5px 10px;border-radius:3px;text-transform:uppercase;transition:all .2s;pointer-events:none}
.code-module:hover .cm-btn{border-color:var(--cyan);background:rgba(18,144,255,.1)}
.fg-ibtn{background:none;border:1px solid rgba(18,144,255,.15);color:rgba(18,144,255,.4);cursor:pointer;padding:3px 8px;border-radius:2px;font-family:'Share Tech Mono',monospace;font-size:9px;letter-spacing:1px;transition:all .2s;display:flex;align-items:center;gap:4px}
.fg-ibtn:hover{color:#1290ff;border-color:#1290ff}
.fg-ibtn.active{color:#1290ff;border-color:#1290ff;background:rgba(18,144,255,.08)}
.fg-ibtn:disabled{opacity:.3;cursor:default}
.fg-ftab{display:flex;align-items:center;gap:6px;padding:0 10px;height:36px;border-bottom:2px solid transparent;cursor:pointer;font-family:'Share Tech Mono',monospace;font-size:10px;letter-spacing:2px;color:rgba(18,144,255,.35);background:transparent;transition:all .2s}
.fg-ftab.active{color:#1290ff;border-bottom-color:#1290ff;background:rgba(18,144,255,.04)}
.fg-vtab{display:flex;align-items:center;gap:5px;padding:0 10px;height:32px;border-bottom:2px solid transparent;cursor:pointer;font-size:9px;letter-spacing:2px;color:rgba(18,144,255,.35);font-family:'Share Tech Mono',monospace;transition:all .2s}
.fg-vtab.active{color:#1290ff;border-bottom-color:#1290ff}
.fg-sinput{flex:1;background:rgba(0,0,0,.5);border:1px solid rgba(18,144,255,.15);color:#1290ff;font-family:'JetBrains Mono',monospace;font-size:10px;padding:3px 7px;outline:none;border-radius:2px}
.fg-sinput:focus{border-color:rgba(18,144,255,.5)}
.fg-toggle{width:32px;height:16px;border-radius:8px;background:rgba(18,144,255,.1);border:1px solid rgba(18,144,255,.2);cursor:pointer;position:relative;transition:all .2s}
.fg-toggle.on{background:rgba(18,144,255,.6);border-color:#1290ff}
.fg-toggle span{position:absolute;top:1px;left:1px;width:12px;height:12px;border-radius:50%;background:rgba(18,144,255,.5);transition:left .2s}
.fg-toggle.on span{left:17px;background:#1290ff}
.fg-sbtn{background:none;border:1px solid transparent;color:rgba(18,144,255,.35);cursor:pointer;width:26px;height:26px;border-radius:2px;font-size:12px;display:flex;align-items:center;justify-content:center;transition:all .2s}
.fg-sbtn:hover{color:#1290ff;background:rgba(18,144,255,.07)}
.fg-sbtn.active{color:#1290ff;border-color:rgba(18,144,255,.35);background:rgba(18,144,255,.08)}
@keyframes forge-dot{0%,80%,100%{transform:scale(0.5);opacity:.3}40%{transform:scale(1);opacity:1}}
.dot-anim{animation:forge-dot 1.2s ease-in-out infinite}
/* CODEMIRROR THEME */
.cm-s-P\.R\.A\.G\.O\.N.CodeMirror{background:transparent!important;font-family:'JetBrains Mono',monospace;font-size:12px;line-height:18px;color:rgba(18,144,255,.85)}
.cm-s-P\.R\.A\.G\.O\.N .CodeMirror-gutters{background:rgba(0,0,0,.35)!important;border-right:1px solid rgba(18,144,255,.12)!important}
.cm-s-P\.R\.A\.G\.O\.N .CodeMirror-linenumber{color:rgba(18,144,255,.22)!important;font-family:'JetBrains Mono',monospace;font-size:11px}
.cm-s-P\.R\.A\.G\.O\.N .CodeMirror-cursor{border-left:1.5px solid var(--cyan)!important}
.cm-s-P\.R\.A\.G\.O\.N .CodeMirror-selected{background:rgba(18,144,255,.12)!important}
.cm-s-P\.R\.A\.G\.O\.N .CodeMirror-activeline-background{background:rgba(18,144,255,.04)!important}
.cm-s-P\.R\.A\.G\.O\.N .cm-tag{color:#7eb8f7;font-weight:600}
.cm-s-P\.R\.A\.G\.O\.N .cm-attribute{color:#9d6eff}
.cm-s-P\.R\.A\.G\.O\.N .cm-string{color:#00e5a0}
.cm-s-P\.R\.A\.G\.O\.N .cm-comment{color:rgba(18,144,255,.25);font-style:italic}
.cm-s-P\.R\.A\.G\.O\.N .cm-keyword{color:#1290ff;font-weight:600}
.cm-s-P\.R\.A\.G\.O\.N .cm-def,.cm-s-P\.R\.A\.G\.O\.N .cm-variable-2{color:#ffc247}
.cm-s-P\.R\.A\.G\.O\.N .cm-number{color:#f97316}
.cm-s-P\.R\.A\.G\.O\.N .cm-property{color:#9d6eff}
.cm-s-P\.R\.A\.G\.O\.N .cm-atom{color:#1290ff}
.cm-s-P\.R\.A\.G\.O\.N .cm-bracket{color:rgba(18,144,255,.8)}
.CodeMirror-scrollbar-filler,.CodeMirror-gutter-filler{background:transparent}
.CodeMirror ::-webkit-scrollbar{width:4px;height:4px}
.CodeMirror ::-webkit-scrollbar-track{background:transparent}
.CodeMirror ::-webkit-scrollbar-thumb{background:rgba(18,144,255,.15);border-radius:2px}
/* TOASTS */
#toasts{position:fixed;top:64px;left:20px;z-index:30;display:flex;flex-direction:column;gap:6px;pointer-events:none}
.toast{font-size:9px;letter-spacing:1.5px;text-transform:uppercase;color:rgba(18,144,255,.75);background:rgba(0,0,0,.8);border:1px solid var(--border);border-left:2px solid var(--cyan);padding:6px 12px;backdrop-filter:blur(10px);border-radius:2px;animation:ti .3s ease forwards}
/* KEYFRAMES */
@keyframes pdot{0%,100%{opacity:1}50%{opacity:.3}}
@keyframes fs{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
@keyframes ti{from{opacity:0;transform:translateX(-12px)}to{opacity:1;transform:translateX(0)}}

#log::-webkit-scrollbar,#lp::-webkit-scrollbar{width:3px}
#log::-webkit-scrollbar-thumb,#lp::-webkit-scrollbar-thumb{background:rgba(18,144,255,.15)}
/* ── SETTINGS PANEL ── */
#sp{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.85);z-index:40;display:flex;align-items:flex-start;justify-content:flex-end;pointer-events:none;opacity:0;transition:opacity .3s}
#sp.open{pointer-events:all;opacity:1}
#sp-panel{width:280px;height:100%;background:rgba(0,0,0,0.97);border-left:1px solid var(--border);display:flex;flex-direction:column;transform:translateX(300px);transition:transform .4s cubic-bezier(.19,1,.22,1)}
#sp.open #sp-panel{transform:translateX(0)}
#sp .sp-tab{flex:0 0 auto;padding:7px 10px;font-family:var(--mono);font-size:7px;letter-spacing:2px;text-transform:uppercase;color:rgba(18,144,255,.35);cursor:pointer;border:none;background:none;border-bottom:2px solid transparent;transition:all .2s;white-space:nowrap}
#sp .sp-tab.active{color:var(--cyan);border-bottom-color:var(--cyan);background:rgba(18,144,255,.04)}
#sp .sp-tabs{display:flex;border-bottom:1px solid var(--border);flex-shrink:0;overflow-x:auto;overflow-y:hidden;scrollbar-width:thin;scrollbar-color:rgba(18,144,255,.25) transparent}
#sp .sp-tabs::-webkit-scrollbar{height:5px}
#sp .sp-tabs::-webkit-scrollbar-thumb{background:rgba(18,144,255,.25);border-radius:3px}
#sp .sp-tabs::-webkit-scrollbar-track{background:transparent}
#sp .fg-toggle,.spf .fg-toggle{width:32px;height:16px;border-radius:8px;background:rgba(18,144,255,.1);border:1px solid rgba(18,144,255,.2);cursor:pointer;position:relative;transition:all .2s;display:inline-block;vertical-align:middle}
#sp .fg-toggle.on,.spf .fg-toggle.on{background:rgba(18,144,255,.6);border-color:#1290ff}
