<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --cyan:#1290ff;--dim:rgba(18,144,255,0.12);--border:rgba(134,140,139,0.30);--bg:#000;
  --mono:'Courier New',monospace;--head:'Arial Black',sans-serif;
