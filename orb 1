function escFg(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}

function fgSetAutoRun(on){
  // Single source of truth for the auto-compile flag. There are two
  // separate controls for it (the toolbar ⟳ AUTO button and the "Auto
  // Compile" row in Settings) -- previously each one flipped FS.autoRun
  // and painted only its own element, so they'd drift out of sync: e.g.
  // toggling it off in Settings left the toolbar button still lit up
  // showing "AUTO ON" while autocompile had actually stopped firing.
  // Routing both controls through this one function keeps every rendered
  // copy of the toggle -- and the debounced compile-on-type behavior --
  // consistent no matter which control was used.
  FS.autoRun=on;
  const btn=$('fg-auto-btn');
  if(btn){btn.classList.toggle('active',FS.autoRun);btn.textContent=FS.autoRun?' AUTO ON':' AUTO';}
  const settingsToggle=document.querySelector('#fg-toggles button[data-key="autoRun"]');
  if(settingsToggle)settingsToggle.classList.toggle('on',FS.autoRun);
  toast(FS.autoRun?'Auto-compile ON':'Auto-compile OFF');
  if(FS.autoRun)forgeCompile();
}

function forgeCompile(src){
  const h=src!==undefined?(FS.activeFile==='html'?src:FS.files.html):FS.files.html;
  const t0=performance.now();
  try{
    const toks=[];let i=0;
    const selfClose=new Set(['meta','link','br','hr','img','input','area','base','col','embed','param','source','track','wbr']);
    const rawTextEls=new Set(['script','style']);
    // Finds the '>' that actually ends a tag, skipping any '>' that appears
    // inside a quoted attribute value (e.g. title="1 > 2"). The previous
    // version used a bare indexOf('>'), which sliced tags in half on any
    // quoted '>' and desynced every token after it.
    function findTagEnd(str,start){
      let q=null;
      for(let k=start+1;k<str.length;k++){
        const c=str[k];
        if(q){if(c===q)q=null;}
        else if(c==='"'||c==="'")q=c;
        else if(c==='>')return k;
      }
      return -1;
    }
    while(i<h.length){
      if(h[i]==='<'){
        // HTML comments: capture whole and don't let their text confuse the
        // parser (previously any '<'/'>' inside a comment became fake tags).
        if(h.startsWith('<!--',i)){
          let end=h.indexOf('-->',i);end=end===-1?h.length:end+3;
          toks.push({type:'COMMENT',tagName:null,val:h.slice(i,end),pos:i});
          i=end;continue;
        }
        const end=findTagEnd(h,i);if(end===-1)break;
        const raw=h.slice(i,end+1);
        const isDoctype=/^<!doctype/i.test(raw);
        const isClose=raw[1]==='/';
        const tagName=isDoctype?'!doctype':raw.replace(/[<>\/]/g,'').split(/[\s>]/)[0].toLowerCase();
        const isSelf=!isDoctype&&(/\/\s*>$/.test(raw)||(!isClose&&selfClose.has(tagName)));
        toks.push({type:isDoctype?'DOCTYPE':isClose?'CLOSE':isSelf?'SELF':'OPEN',tagName,val:raw,pos:i});
        i=end+1;
        // <script>/<style> bodies are raw JS/CSS, not markup -- scanning
        // their arrow functions ("=>"), comparisons ("a<b"), or combinators
        // ("div > p") as tags previously produced garbage tokens/elements.
        // Swallow the whole body as one TEXT token up to the matching close.
        if(!isClose&&!isSelf&&rawTextEls.has(tagName)){
          const closeIdx=h.toLowerCase().indexOf('</'+tagName,i);
          const bodyEnd=closeIdx===-1?h.length:closeIdx;
          const body=h.slice(i,bodyEnd);
          if(body.trim())toks.push({type:'TEXT',val:body.trim(),pos:i});
          i=bodyEnd;
        }
      }
      else{let j=i;while(j<h.length&&h[j]!=='<')j++;if(h.slice(i,j).trim())toks.push({type:'TEXT',val:h.slice(i,j).trim(),pos:i});i=j;}
    }
    const tags=toks.filter(t=>t.type==='OPEN'||t.type==='SELF');
    const unique=[...new Set(tags.map(t=>t.tagName))].filter(Boolean);
    const dur=(performance.now()-t0).toFixed(1);
    FS.tokens=toks;FS.metrics={elements:tags.length,unique:unique.length,lines:h.split('\n').length};
    FS.compileTime=dur+'ms';FS.compiled={html:h};
    forgeLog(`Compiled — ${toks.length} tokens · ${tags.length} elements · ${dur}ms`,'ok');
    fgUpdateStats();fgRenderPreview();fgRenderActivePanel();
  }catch(e){forgeLog('Compile error: '+e.message,'err');}
}

function fgGetPreviewSrc(){
  // Always preview the real merged page (HTML head/body + STYLE.css +
  // MAIN.js), whichever tab is active -- switching tabs while editing one
  // live page shouldn't swap the preview out for an unrelated stub. This
  // also means CSS/JS edits are visible in context instead of in isolation.
  return fgBuildFullBundle();
}
