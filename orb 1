.panel{background:rgba(0,0,0,0.55);border:1px solid var(--border);backdrop-filter:blur(14px) saturate(160%);border-radius:4px}
/* TOPBAR */
#topbar{position:fixed;top:0;left:0;right:0;z-index:20;height:52px;display:flex;align-items:center;padding:0 16px;border-bottom:1px solid var(--border);background:rgba(0,0,0,0.92);backdrop-filter:blur(20px);gap:12px}
