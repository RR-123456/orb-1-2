/* ── FILES IN CHAT ── */
#files-panel{position:fixed;top:0;right:0;width:320px;height:100%;background:rgba(0,0,0,0.97);border-left:1px solid var(--border);z-index:45;display:flex;flex-direction:column;transform:translateX(340px);transition:transform .4s cubic-bezier(.19,1,.22,1)}
#files-panel.open{transform:translateX(0)}
#files-panel .fp-header{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-bottom:1px solid var(--border);flex-shrink:0}
#files-panel .fp-title{font-family:var(--head);font-size:10px;letter-spacing:3px;color:var(--cyan);text-shadow:0 0 12px var(--cyan)}
#files-panel .fp-close{background:none;border:none;color:rgba(18,144,255,.5);cursor:pointer;font-size:16px;line-height:1;padding:4px;transition:color .2s}
#files-panel .fp-close:hover{color:var(--cyan)}
#files-panel .fp-list{flex:1;overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:8px}
#files-panel .fp-empty{font-size:9px;letter-spacing:1.5px;color:rgba(18,144,255,.3);text-align:center;padding:20px 10px;text-transform:uppercase}
#files-panel .fp-item{display:flex;align-items:center;gap:10px;padding:10px 12px;border:1px solid var(--border);border-radius:6px;background:rgba(18,144,255,.03);cursor:pointer;transition:all .2s}
#files-panel .fp-item:hover{border-color:var(--cyan);background:rgba(18,144,255,.07)}
#files-panel .fp-icon{width:32px;height:32px;flex-shrink:0;border:1px solid var(--border);border-radius:6px;display:flex;align-items:center;justify-content:center;color:var(--cyan);font-size:13px;font-family:'JetBrains Mono',monospace}
#files-panel .fp-info{flex:1;min-width:0}
#files-panel .fp-name{font-size:10px;letter-spacing:1px;color:rgba(18,144,255,.9);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#files-panel .fp-size{font-size:8px;letter-spacing:1px;color:rgba(18,144,255,.4);margin-top:2px;text-transform:uppercase}
#files-panel .fp-remove{background:none;border:none;color:rgba(18,144,255,.35);cursor:pointer;font-size:14px;padding:4px;transition:color .2s;flex-shrink:0}
#files-panel .fp-remove:hover{color:#f87171}
#files-panel .fp-view,#files-panel .fp-dl{background:none;border:none;color:rgba(18,144,255,.55);cursor:pointer;padding:4px;transition:color .2s;flex-shrink:0;display:flex;align-items:center;justify-content:center}
#files-panel .fp-view:hover,#files-panel .fp-dl:hover{color:var(--cyan)}
#files-panel .fp-view.fp-disabled,#files-panel .fp-dl.fp-disabled{opacity:.22;cursor:not-allowed}
#files-panel .fp-view.fp-disabled:hover,#files-panel .fp-dl.fp-disabled:hover{color:rgba(18,144,255,.55)}
#file-view-overlay{position:fixed;inset:0;z-index:70;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.75);backdrop-filter:blur(6px)}
#file-view-overlay.open{display:flex}
#file-view-panel{width:min(860px,92vw);height:min(80vh,760px);background:rgba(5,5,10,.98);border:1px solid var(--border);border-radius:8px;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 0 40px rgba(18,144,255,.1)}
#file-view-bar{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-bottom:1px solid var(--border);background:rgba(18,144,255,.03);flex-shrink:0}
#file-view-bar .fv-name{font-family:var(--mono);font-size:10.5px;letter-spacing:1px;color:var(--cyan);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#file-view-bar .fv-actions{display:flex;gap:8px;flex-shrink:0}
#file-view-bar button{background:none;border:1px solid rgba(18,144,255,.25);color:rgba(18,144,255,.7);cursor:pointer;font-family:var(--mono);font-size:9px;letter-spacing:1.5px;padding:5px 10px;border-radius:3px;transition:all .2s}
