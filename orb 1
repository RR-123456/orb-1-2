<script>window.addEventListener("DOMContentLoaded",function(){var f=document.getElementById("p7-camFab"),t=document.getElementById("p7-camToggle"),m=document.getElementById("p7-camModule");if(!f||!t||!m)return;f.addEventListener("click",function(){t.click()});function sync(){f.classList.toggle("active",!m.classList.contains("p7-hidden"))}new MutationObserver(sync).observe(m,{attributes:true,attributeFilter:["class"]});sync()});</script>
