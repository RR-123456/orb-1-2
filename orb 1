#adgen-overlay-bar .nb-title{font-family:var(--head);font-size:10px;letter-spacing:4px;color:var(--cyan);text-shadow:0 0 12px var(--cyan)}
#adgen-overlay-bar button{background:none;border:1px solid rgba(18,144,255,.25);color:rgba(18,144,255,.6);cursor:pointer;font-family:var(--mono);font-size:9px;letter-spacing:2px;padding:5px 12px;border-radius:3px;transition:all .2s}
#adgen-overlay-bar button:hover{color:var(--cyan);border-color:var(--cyan);background:rgba(18,144,255,.08)}
#adgen-frame{flex:1;border:none;width:100%}
#pulse-frame{flex:1;width:100%;border:none;display:block;background:#050508}
#pulse-overlay-status{font-family:var(--mono);font-size:9px;letter-spacing:2px;color:rgba(18,144,255,.5)}
#sched-overlay,#ksx-overlay{position:fixed;inset:0;z-index:60;display:none;flex-direction:column;background:rgba(0,0,0,.92);backdrop-filter:blur(10px)}
#sched-overlay.open,#ksx-overlay.open{display:flex}
#sched-bar,#ksx-bar{display:flex;align-items:center;justify-content:space-between;padding:10px 16px;border-bottom:1px solid var(--border);background:rgba(0,0,0,.9);flex-shrink:0}
