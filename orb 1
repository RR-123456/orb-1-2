      <button onclick="kwDelete(${i})" style="background:none;border:1px solid rgba(248,113,113,.4);color:rgba(248,113,113,.8);cursor:pointer;font-family:var(--mono);font-size:7px;padding:2px 6px;border-radius:2px;flex-shrink:0"></button>
    </div>
    <div style="font-size:8px;color:rgba(18,144,255,.4);margin-top:3px;line-height:1.5">${escH(item.ans)}</div>
  </div>`).join('');
}
function kwMatch(txt){
  const enabled=localStorage.getItem('pragon_kw_enabled');
  if(enabled==='false')return null;
  const list=kwGetAll();
  if(!list.length)return null;
  const low=String(txt).toLowerCase();
  for(const item of list){
    if(item.kw&&low.includes(item.kw.toLowerCase()))return item.ans;
  }
  return null;
}

