function fgRenderAST(){const h=$('fg-ast-head');const b=$('fg-ast-body');if(h)h.textContent=`AST — ${FS.metrics.elements} nodes`;if(!b)return;b.innerHTML=FS.tokens.filter(t=>t.type==='OPEN'||t.type==='SELF').slice(0,80).map(tok=>`<div style="padding:3px 0;border-bottom:1px solid rgba(18,144,255,.04)"><span style="color:#1290ff;font-weight:600">&lt;${escFg(tok.tagName)}&gt;</span><span style="color:rgba(18,144,255,.25);margin-left:8px;font-size:9px">@${tok.pos}</span></div>`).join('');}
