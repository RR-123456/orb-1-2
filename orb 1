.tp-iv-tabs{align-items:center}
.tp-iv-close{flex:0 0 auto;padding:6px 10px;font-size:8px;letter-spacing:1px;color:rgba(18,144,255,.5);cursor:pointer;border-left:1px solid var(--border);transition:color .2s}
.tp-iv-close:hover{color:var(--cyan)}
#tp #forge-toggle{position:static;width:calc(100% - 20px);margin:10px auto 0;text-align:center;padding:4px 8px;font-size:7px;letter-spacing:1px}
#tp .ph{padding:8px 12px;border-bottom:1px solid var(--border);font-size:8px;letter-spacing:3px;color:rgba(18,144,255,.45);display:flex;align-items:center;gap:8px}
