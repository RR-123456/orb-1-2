// WebSocket
function connectWS(){
  if(ws&&(ws.readyState===0||ws.readyState===1))return; // never hold two live sockets
  setConn('connecting');
  const sock=new WebSocket('ws://localhost:8765');ws=sock;
  ws.onopen=()=>{sendLangToBackend();sendVoiceToBackend();setConn('connected');setStat('Online — PRAGON Ready');toast('Neural link established');engineReady=true;
    try{
      if(!localStorage.getItem('pragon_shortcut_prompted')){
        localStorage.setItem('pragon_shortcut_prompted','1');
        setTimeout(()=>toast('Tip: Settings → Desktop Shortcut lets you add a one-click P.R.A.G.O.N icon'),2500);
      }
    }catch(e){}
  };
  ws.onmessage=(ev)=>{
    if(ws!==sock)return; // stale socket
    const data=JSON.parse(ev.data);
    if(data.type==='status'){setStat(data.text);if(data.speaking)isAwake=true;else if(data.text==='Standby')isAwake=false;}
    else if(data.type==='transcript'){const k=data.role+'|'+data.text,t=Date.now();if(window._lastTr&&window._lastTr.k===k&&t-window._lastTr.t<2000)return;window._lastTr={k,t};addMsg(data.role,data.text);}
    else if(data.type==='toast'){toast(data.text);}
    else if(data.type==='lu_state'){luState={settings:data.settings||{},topics:data.topics||[]};luRender();}
    else if(data.type==='live_update'){luShowNote(data);}
    else if(data.type==='voice_changed'){
      // PRAGON changed its own voice by voice/typed command: mirror it in the Voice Shifter + remember it.
      try{buildEngineVoices();const g=$('gsel');if(g&&data.name){g.value=data.name;if(g.value===data.name){localStorage.setItem('jgemvoice',data.name);updateEngineVoiceDesc();}}}catch(e){}
      toast('Engine voice: '+data.name+' - reconnecting...');
    }
    else if(data.type==='confirm_request'){showConfirmBanner(data.id,data.prompt);}
    else if(data.type==='wake_word_status'){
      const btn=$('p7-wakeToggle');
      if(btn){btn.classList.toggle('active',!!data.enabled);btn.title=data.enabled?"Wake Word: ON (say 'Hey Jarvis')":'Wake Word: OFF';}
    }
    else if(data.type==='typer_status'){
      const on=data.mode!=='off', note=data.target==='notepad';
      const a=$('p7-typerToggle'), n=$('p7-typerNote');
      const label=data.mode==='armed'?'listening for ONE sentence':'ON';
      if(a){a.classList.toggle('active',on&&!note);a.title=(on&&!note)?"PragonTyper: "+label+" — say 'pragon typer mode off' or click to stop":"PragonTyper: OFF — say 'pragon typer mode on' or click";}
      if(n){n.classList.toggle('active',on&&note);n.title=(on&&note)?"PragonTyper → Notepad: "+label+" — say 'pragon typer mode off' or click to stop":"PragonTyper → Notepad: OFF — say 'type in notepad' or click";}
    }
    else if(data.type==='mute_state'){
      // Backend-driven mic state change (e.g. wake word just fired) -- keep the
      // mute button and local `muted` flag in sync with what the mic is actually doing.
      muted=!!data.muted;
      const mb=$('mbtn');if(mb)mb.classList.toggle('active',muted);
    }
    else if(data.type==='audio_devices'){
      const inSel=$('sp-audio-in'),outSel=$('sp-audio-out');
      if(inSel){inSel.innerHTML=(data.inputs||['System default']).map(n=>'<option'+(n===data.current_input?' selected':'')+'>'+n+'</option>').join('');}
      if(outSel){outSel.innerHTML=(data.outputs||['System default']).map(n=>'<option'+(n===data.current_output?' selected':'')+'>'+n+'</option>').join('');}
    }
    else if(data.type==='image'){addImageMsg(data.base64,data.mimeType,data.prompt);}
    else if(data.type==='code'){
      const lang=(data.lang&&['html','css','js'].includes(data.lang))?data.lang:'html';
      FS.files[lang]=data.code;
      FS.histories[lang]=[...FS.histories[lang],data.code].slice(-50);
      FS.histIdxs[lang]=FS.histories[lang].length-1;
      if(lang==='html')FS.compiled={html:data.code};
      // Always recompile, not just for HTML: forgeCompile() also rebuilds
      // the live preview from the full merged bundle (HTML+CSS+JS), so a
      // CSS/JS-only generation was previously left showing a stale preview
      // until the user manually hit COMPILE.
      if(forgeMounted){fgActivateFile(lang);forgeCompile();}
      addChatFile({name:'generated_'+Date.now()+'.'+lang,ext:lang,size:(data.code||'').length,model:PROVIDER_NAMES.pragon,kind:'generated',content:data.code||''});
      toast('Code ready — open F.O.R.G.E to view');
    }
    else if(data.type==='vol'){smoothVol=data.vol;updateVol(data.vol);}
    else if(data.type==='friday_status'){const fs=$('friday-stat');if(fs)fs.textContent=data.text;}
    else if(data.type==='friday_transcript'){/* backend-side FRIDAY log line, informational only — reply is also returned directly to queryFriday() */}
    else if(data.type==='ghost_status'){const gs=$('ghost-stat');if(gs)gs.textContent=data.text;}
    else if(data.type==='ghost_transcript'){/* backend-side GHOST log line, informational only — reply is also returned directly to queryGhost() */}
    else if(data.type==='macro_status'){
      actionRecording=!!data.recording;
      const btn=$('action-rec-btn'),st=$('action-rec-status');
      if(btn)btn.textContent=actionRecording?'■ Recording…':'● Record';
      if(st)st.style.display=actionRecording?'block':'none';
      const ni=$('action-name-input');
      if(ni){ni.disabled=actionRecording;if(!actionRecording&&data.saved)ni.value='';}
      if(data.text)toast(data.text);
    }
    else if(data.type==='macro_list'){actionList=data.macros||[];renderActionList();}
    else if(data.type==='plugin_list'){pluginList=data.plugins||[];renderPluginList();}
    else if(data.type==='integrator_settings_list'){integratorSections=data.sections||[];renderIntegratorSettings();}
    else if(data.type==='integrator_settings_saved'){
      const lbl=document.getElementById('isf-status-'+data.namespace);
      if(lbl)lbl.textContent=data.text||'Saved';
      toast(data.text||'Saved');
    }
    else if(data.type==='integrator_settings_tested'){
      const lbl=document.getElementById('isf-status-'+data.namespace);
      if(lbl)lbl.textContent=data.text||'';
      toast(data.text||'');
    }
    else if(data.type==='integration_list'){integrationList=data.integrations||[];renderIntegrationList();}
    else if(data.type==='integration_logs'){
      const el=document.getElementById('integ-logs-'+data.slug);
      if(el)el.textContent=data.text||'(no logs)';
    }
    else if(data.type==='phoneview_pairing'){
      const stat=$('sp-phoneview-stat'),panel=$('sp-phoneview-panel'),img=$('sp-phoneview-qr');
      if(!data.ok){
        if(stat){stat.style.color='rgba(248,113,113,.8)';stat.textContent=data.error||'PhoneView unavailable';}
        if(panel)panel.style.display='none';
        return;
      }
      if($('sp-phoneview-url'))$('sp-phoneview-url').textContent=data.manual||data.url;
      if($('sp-phoneview-key'))$('sp-phoneview-key').textContent=data.key;
      if(img){ if(data.qr){img.src=data.qr;img.style.display='block';} else {img.style.display='none';} }
      if(panel)panel.style.display='block';
      if(stat){stat.style.color='rgba(18,144,255,.6)';stat.textContent='Waiting for phone to scan…';}
    }
    else if(data.type==='set_provider'){
      // Phone tapped a model pill. PhoneView 'ghost' == desktop 'ollama'.
      const want=data.provider==='ghost'?'ollama':data.provider;
      if(['pragon','jarvis','friday','ollama'].includes(want)) J.setProvider(want);
      // Report what is REALLY active (Zen Mode may have refused) so the phone can revert.
      if(ws&&ws.readyState===1)ws.send(JSON.stringify({type:'provider_changed',provider:provider}));
    }
    else if(data.type==='theme'){ try{ PW.theme.apply(data.mode); }catch(e){} }
    else if(data.type==='hotkey'){ try{ if(data.action==='toggle_listening') toggleMute(); }catch(e){} }
    else if(data.type==='pw_open'||data.type==='pw_type'){ try{ PW.fromServer(data); }catch(e){ toast('Could not open window: '+e.message); } }
    else if(data.type==='calls_status'){
      const st=data.status||{},stat=$('sp-calls-stat'),todo=$('sp-calls-todo');
      if(stat){stat.style.color=st.running?'rgba(0,255,136,.8)':(st.enabled?'rgba(245,200,50,.8)':'rgba(18,144,255,.5)');
        stat.textContent=(st.lines||[]).join('\n');}
      if(todo){todo.textContent=(st.problems&&st.problems.length)?('Still needed:\n- '+st.problems.join('\n- ')):'';}
      const be=$('sp-calls-enable'),br=$('sp-calls-run'),bc=$('sp-calls-call'),ba=$('sp-calls-auto');
      if(be){be.textContent=st.enabled?' Disable calling':' Enable calling';be.onclick=()=>J.callsAction(st.enabled?'disable':'enable');}
      if(br){br.textContent=st.running?' Stop PRAGONCALL':' Start PRAGONCALL';br.onclick=()=>J.callsAction(st.running?'stop':'start');}
      if(bc){bc.disabled=!(st.running&&st.can_dial_out);bc.style.opacity=bc.disabled?'.4':'1';}
      if(ba){ba.textContent=st.autostart?' Auto-start: ON (click to turn off)':' Auto-start with PRAGON';ba.onclick=()=>J.callsAction(st.autostart?'autostart_off':'autostart_on');}
      if(data.message)toast(data.message);
    }
    else if(data.type==='phoneview_status'){
      const stat=$('sp-phoneview-stat');
      if(stat && data.connected){stat.style.color='rgba(0,255,136,.8)';stat.textContent=' Phone connected';}
    }
    else if(data.type==='phone_screen_frame'){
      const p=J.ensurePhoneScreen(),im=$('ps-img'),m=$('ps-msg');
      if(p.style.display==='none')p.style.display='block';
      if(im)im.src='data:image/jpeg;base64,'+data.data;
      if(m)m.textContent='Live';
    }
    else if(data.type==='phone_screen_state'){
      const m=$('ps-msg'); if(m&&!data.active)m.textContent='Phone stopped sharing.';
    }
    else if(data.type==='whatsapp_pairing'){
      const stat=$('sp-whatsapp-stat'),panel=$('sp-whatsapp-panel'),img=$('sp-whatsapp-qr');
      if(!data.ok){
        if(stat){stat.style.color='rgba(248,113,113,.8)';stat.textContent=data.error||'PRAGON WhatsUp unavailable';}
        if(panel)panel.style.display='none';
        return;
      }
      if(img){ if(data.qr){img.src=data.qr;img.style.display='block';} else {img.style.display='none';} }
      if(panel)panel.style.display='block';
      if(stat){stat.style.color='rgba(18,144,255,.6)';stat.textContent='Scan the QR code…';}
    }
    else if(data.type==='whatsapp_setup'){
      // First-run "npm install" progress -- in-progress, not an error, so
      // just update the status line without touching the QR panel.
      const stat=$('sp-whatsapp-stat');
      if(stat){stat.style.color='rgba(245,200,50,.7)';stat.textContent=data.message||'Setting up PRAGON WhatsUp…';}
    }
    else if(data.type==='whatsapp_status'){
      const stat=$('sp-whatsapp-stat'),panel=$('sp-whatsapp-panel');
      if(data.connected){
        if(stat){stat.style.color='rgba(0,255,136,.8)';stat.textContent=' WhatsApp connected — FRIDAY is replying';}
        if(panel)panel.style.display='none';
      } else if(stat){
        stat.style.color='rgba(248,113,113,.8)';
        stat.textContent='Disconnected'+(data.reason?': '+data.reason:'');
      }
    }
    else if(data.type==='shortcut_result'){
      toast(data.ok ? ' Desktop shortcut created!' : ('Shortcut failed: '+(data.message||'unknown error')));
    }
    else if(data.type==='autostart_result'){
      toast(data.message || (data.ok ? 'Done' : 'Failed'));
      const btn=$('sp-autostart-btn');
      if(btn && data.ok){btn.textContent=data.enabled?'◉ AUTO-START: ON':'◉ AUTO-START: OFF';}
    }
  };
  ws.onclose=()=>{if(ws!==sock)return;setConn('offline');setStat('Disconnected');engineReady=false;setTimeout(connectWS,3000);};
  ws.onerror=()=>{setConn('error');};
}
