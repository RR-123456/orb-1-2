// ══════ LiveKit voice agent bridge ══════
// Lets the "LiveKit" pill in the input bar swap the voice path from the
// browser's Web Speech API + Jarvis (Gemini) REST calls over to a real-time
// LiveKit room, where livekit_agent.py's VoicePipelineAgent (also Gemini,
// via LiveKit's google plugin) does STT/LLM/TTS server-side.
let lkRoom=null, lkConnecting=false;

function lkRoomName(){return localStorage.getItem('jlk_room')||'pragon-room';}
function lkIdentity(){
  let id=localStorage.getItem('jlk_identity');
  if(!id){id='pragon-user-'+Math.random().toString(36).slice(2,10);localStorage.setItem('jlk_identity',id);}
  return id;
}

async function loadLiveKitSDK(){
  if(window.LivekitClient)return window.LivekitClient;
  await new Promise((res,rej)=>{
    const s=document.createElement('script');
    s.src='https://cdn.jsdelivr.net/npm/livekit-client/dist/livekit-client.umd.min.js';
    s.onload=res;s.onerror=()=>rej(new Error('Could not load the LiveKit SDK (check your network)'));
    document.head.appendChild(s);
  });
  if(!window.LivekitClient)throw new Error('LiveKit SDK loaded but LivekitClient is undefined');
  return window.LivekitClient;
}

function setLkUI(on){
  $('lkbtn')?.classList.toggle('active',on);
  const dot=$('lk-dot');if(dot)dot.style.background=on?'#00e5a0':'#444';
  $('lkbtn')?.setAttribute('title',on?'Voice engine: LiveKit agent — click to switch back to Jarvis (Gemini)':'Voice engine: Jarvis (Gemini) — click to switch to the LiveKit voice agent');
}

async function connectLiveKit(){
  if(lkRoom||lkConnecting)return;
  lkConnecting=true;
  setStat('Connecting to LiveKit voice agent…');
  try{
    const LK=await loadLiveKitSDK();
    const r=await fetch('/livekit/token?room='+encodeURIComponent(lkRoomName())+'&identity='+encodeURIComponent(lkIdentity()));
    const data=await r.json().catch(()=>({}));
    if(data.error)throw new Error(data.error);
    if(!data.token||!data.url)throw new Error('LiveKit token endpoint returned no token');
    const room=new LK.Room({adaptiveStream:true,dynacast:true});
    room.on(LK.RoomEvent.TrackSubscribed,(track)=>{
      if(track.kind===LK.Track.Kind.Audio){
        const el=track.attach();el.autoplay=true;el.dataset.lkTrack='1';el.style.display='none';
        document.body.appendChild(el);
      }
    });
    room.on(LK.RoomEvent.TrackUnsubscribed,(track)=>{track.detach().forEach(el=>el.remove());});
    room.on(LK.RoomEvent.Disconnected,()=>{
      lkRoom=null;setLkUI(false);setStat('Standby');
      toast('LiveKit voice agent disconnected');
    });
    await room.connect(data.url,data.token);
    await room.localParticipant.setMicrophoneEnabled(!muted);
    lkRoom=room;
    setLkUI(true);
    setStat('LiveKit voice agent active');
    toast('Connected to LiveKit voice agent');
  }catch(e){
    setLkUI(false);setStat('Standby');
    toast('LiveKit connect failed: '+e.message.slice(0,80));
  }finally{lkConnecting=false;}
}

async function disconnectLiveKit(){
  if(lkRoom){try{await lkRoom.disconnect();}catch(e){}}
  lkRoom=null;
  document.querySelectorAll('[data-lk-track]').forEach(el=>el.remove());
  setLkUI(false);
}

