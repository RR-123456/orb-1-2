<script id="pragon-perf">
/* PRAGON PERF — in-page balancers: frame pacing, auto-lite mode, background keep-alive,
   write batching, idle scheduling, closed-tool memory release. Never touches app logic. */
(function(){
  var P=window.PragonPerf={level:'full',gapFactor:1,hidden:document.hidden,focused:true,_last:0,_mode:'auto',_lastSwitch:0};
  try{P.focused=document.hasFocus();}catch(e){}
  try{P._mode=localStorage.getItem('pragon.perf')||'auto';}catch(e){}
  function recalc(){var g=P.hidden?0:(!P.focused?66:(P.level==='lite'?33:0));P.gapFactor=Math.max(1,Math.round((g||16.7)/16.7));}
  function setLevel(l,why){
    if(P.level===l)return;
    if(performance.now()-P._lastSwitch<8000&&why!=='init')return; /* hysteresis: never flap */
    P.level=l;P._lastSwitch=performance.now();document.documentElement.dataset.perf=l;recalc();
    try{console.info('[PragonPerf] level ->',l,why||'');}catch(e){}
  }
  P.setMode=function(m){P._mode=m;try{localStorage.setItem('pragon.perf',m);}catch(e){}
    if(m==='full')setLevel('full','user');else if(m==='lite')setLevel('lite','user');};
  /* frame pacing: hidden = no frames, unfocused = ~15fps, lite = ~30fps */
  P.skipFrame=function(now){
    if(P.hidden)return true;
    var gap=!P.focused?66:(P.level==='lite'?33:0);
    if(!gap)return false;
    if(now-P._last<gap-2)return true;
    P._last=now;return false;
  };
  document.addEventListener('visibilitychange',function(){P.hidden=document.hidden;recalc();});
  window.addEventListener('blur',function(){P.focused=false;recalc();});
  window.addEventListener('focus',function(){P.focused=true;recalc();});
  /* helpers */
  var q=new Map(),qr=0;
  P.raf=function(key,fn){q.set(key,fn);if(qr)return;qr=requestAnimationFrame(function(){qr=0;var j=Array.from(q.values());q.clear();for(var i=0;i<j.length;i++){try{j[i]();}catch(e){console.error(e);}}});};
  P.debounce=function(fn,ms){var t=0;return function(){var a=arguments,c=this;clearTimeout(t);t=setTimeout(function(){fn.apply(c,a);},ms);};};
  P.idle=function(fn,timeout){if(window.requestIdleCallback)return requestIdleCallback(fn,{timeout:timeout||1500});return setTimeout(fn,1);};
  /* auto-lite signals (only when mode is auto) */
  function auto(){return P._mode==='auto';}
  try{
    if(P._mode==='lite')setLevel('lite','init');
    else if(auto()){
      var weak=(navigator.deviceMemory&&navigator.deviceMemory<=2)||(navigator.hardwareConcurrency&&navigator.hardwareConcurrency<=2)||(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches);
      if(weak)setLevel('lite','init');
      if(navigator.getBattery)navigator.getBattery().then(function(b){var f=function(){if(auto()&&!b.charging&&b.level<=0.2)setLevel('lite','low battery');};f();b.addEventListener('levelchange',f);b.addEventListener('chargingchange',f);}).catch(function(){});
    }
  }catch(e){}
  /* frame-time probe: sustained slow frames -> lite; sustained smooth -> full */
  var last=0,ema=16.7,slow=0,calm=0;
  (function probe(t){
    requestAnimationFrame(probe);
    if(P.hidden||!P.focused){last=0;return;}
    if(last){var d=t-last;if(d<250){ema=ema*0.9+d*0.1;}
      if(auto()){
        if(ema>30){slow++;calm=0;if(slow>90&&P.level==='full')setLevel('lite','slow frames');}
        else if(ema<19&&P.level==='lite'){calm++;slow=0;if(calm>1200)setLevel('full','smooth again');}
        else{slow=0;}
      }}
    last=t;
  })(0);
  try{
    if(window.PerformanceObserver){var lt=[];new PerformanceObserver(function(l){var n=performance.now();
      l.getEntries().forEach(function(e){if(e.duration>80)lt.push(n);});
      lt=lt.filter(function(x){return n-x<5000;});
      if(auto()&&lt.length>=5)setLevel('lite','long tasks');}).observe({entryTypes:['longtask']});}
  }catch(e){}
  /* keep-alive: a held Web Lock keeps the tab out of aggressive background freezing;
     a Worker heartbeat (its timers are NOT throttled like page timers) re-links a dead socket while hidden */
  try{if(navigator.locks&&navigator.locks.request)navigator.locks.request('pragon-keepalive',{mode:'shared'},function(){return new Promise(function(){});});}catch(e){}
  try{
    var w=new Worker(URL.createObjectURL(new Blob(['setInterval(function(){postMessage(1)},10000)'],{type:'text/javascript'})));
    w.onmessage=function(){try{if(document.hidden&&typeof ws!=='undefined'&&(!ws||ws.readyState>1)&&typeof connectWS==='function')connectWS();}catch(e){}};
  }catch(e){}
  /* memory: release tool iframes that have been closed for 10 min (Scheduler excluded: it runs reminder timers) */
  var closedAt={};
  setInterval(function(){
    ['customdraw','pulse','adgen','compass'].forEach(function(k){
      var ov=document.getElementById(k+'-overlay'),fr=document.getElementById(k+'-frame');
      if(!ov||!fr||!fr.getAttribute('src'))return;
      if(ov.classList.contains('open')){closedAt[k]=0;return;}
      if(!closedAt[k]){closedAt[k]=Date.now();return;}
      if(Date.now()-closedAt[k]>600000){try{fr.contentWindow.location.replace('about:blank');}catch(e){}fr.removeAttribute('src');closedAt[k]=0;}
    });
  },60000);
  recalc();
})();
