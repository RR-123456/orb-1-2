  }catch(e){/* backend unreachable — fall through to direct call below */}
  // Fallback: direct-to-Ollama chat, unchanged — keeps GHOST working even
  // if the Python backend isn't running.
  const msgs=buildMsgs(txt);
  const r=await fetch(host+'/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({model:gmodel,messages:[{role:'system',content:GHOST_SYS+'\n\nFORGE_MODE: '+forgeMode},...msgs],stream:false})});
  if(r.status===404)throw new Error(`Model "${gmodel}" not installed. Run: ollama pull ${gmodel}`);
  if(!r.ok)throw new Error('Ollama HTTP '+r.status);
