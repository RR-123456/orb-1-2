<script>

// ══════ FLOATING PANELS: Voice Shifter (orb > Voice) and API Panel (orb > System / "open API panel") ══════
function _fp(id,force){const el=document.getElementById(id);if(!el)return;
  const on=force===undefined?!el.classList.contains('open'):!!force;
  if(on&&typeof zenMode!=='undefined'&&zenMode){toast('Locked in Zen Mode');return false;}
  if(on)document.querySelectorAll('.fpanel.sec.open').forEach(x=>{if(x.id!==id)x.classList.remove('open');});
  el.classList.toggle('open',on);
  try{spOpen=!!document.querySelector('.spf.open');}catch(e){} /* spOpen now means a settings-derived panel is open */
  return on;}

function spPanel(id,force){
  const on=_fp(id,force);
  if(!on)return on;
  try{spLoadSaved();}catch(e){}
  try{
    if(id==='spf-devices'&&ws&&ws.readyState===1)ws.send(JSON.stringify({type:'list_audio_devices'}));
    if(id==='spf-call'&&ws&&ws.readyState===1)ws.send(JSON.stringify({type:'calls_action',action:'status'}));
    if(id==='spf-keywords')kwRender();
    if(id==='spf-integration'){pluginRender();integrationRender();integratorSettingsRender();}
    if(id==='spf-history')spRenderChats();
  }catch(e){console.warn('[spPanel]',id,e);}
  return on;
}
function toggleVoicePanel(f){return _fp('vs-panel',f);}
function toggleApiPanel(f){return _fp('api-panel',f);}
function interfaceMode(){
  const T=f=>{try{f()}catch(e){}};
  T(()=>document.getElementById('orb-ui').contentWindow.postMessage({pragonCmd:'interface'},'*'));
  ['p7-camModule','p7-chatModule'].forEach(id=>T(()=>document.getElementById(id).classList.add('p7-hidden')));
  ['p7-camToggle','p7-chatToggle'].forEach(id=>T(()=>document.getElementById(id).classList.remove('active')));
  T(()=>{if(logOpen)toggleLog();});
  T(()=>{if(sideOpen){sideOpen=false;$('lp').classList.remove('open');$('stog').classList.remove('po');}});
  T(()=>document.querySelectorAll('.fpanel.open').forEach(x=>x.classList.remove('open')));
  T(()=>{if(forgeOpen)hideForge();});
  T(()=>{if(spOpen){spOpen=false;$('sp').classList.remove('open');const q=$('sp-panel');if(q)q.style.transform='translateX(300px)';}});
  T(()=>{if(filesPanelOpen)toggleFilesPanel();});
  T(()=>openOrbLauncher(null));
  [closeCustomDraw,closeClickExec,closeScheduler,closeKsx,closePulse,closeAdGen,closeCompass,closeGallery,closeFileView,closeLiveUpdates].forEach(f=>T(f));
  T(()=>document.body.classList.remove('in-open'));toast('Interface mode');
}
function tryPanelCmd(txt){
  const t=(txt||'').trim();let m;
  if((m=/^(?:please\s+|hey\s+\w+[,\s]+)?(open|show|close|hide)\s+(?:the\s+|my\s+)?api\s*(?:panel|keys?|settings)\s*[.!]?$/i.exec(t))){
    const on=/^(open|show)$/i.test(m[1]);if(toggleApiPanel(on)===on)toast(on?'API panel opened':'API panel closed');return true;}
  if((m=/^(?:please\s+)?(open|show|close|hide)\s+(?:the\s+|my\s+)?voice\s*(?:shifter|panel|settings)\s*[.!]?$/i.exec(t))){
    const on=/^(open|show)$/i.test(m[1]);if(toggleVoicePanel(on)===on)toast(on?'Voice Shifter opened':'Voice Shifter closed');return true;}
  if((m=/^(?:please\s+|hey\s+\w+[,\s]+)?(?:do\s+(?:a\s+)?)?spin\s+((?:(?:anti-?clockwise|counter-?clockwise|clockwise|right|left|r|l)\b[\s,]*(?:and\s+|then\s+)?)+)[.!]?$/i.exec(t))){
    const pat=(m[1].match(/anti-?clockwise|counter-?clockwise|clockwise|right|left|\br\b|\bl\b/gi)||[]).map(w=>/^(anti|counter|l)/i.test(w)?'L':'R').join('');
    try{document.getElementById('orb-ui').contentWindow.postMessage({pragonCmd:'spin',pat},'*')}catch(e){}return true;}
  if((m=/^(?:please\s+|hey\s+\w+[,\s]+)?pulse(?:\s+(once|twice|thrice|\d+)(?:\s+times?)?)?[.!]?$/i.exec(t))){
    const w=(m[1]||'1').toLowerCase(),n=w==='once'?1:w==='twice'?2:w==='thrice'?3:Math.max(1,Math.min(6,parseInt(w,10)||1));
    try{document.getElementById('orb-ui').contentWindow.postMessage({pragonCmd:'pulse',n},'*')}catch(e){}return true;}
  if(/^(?:please\s+|hey\s+\w+[,\s]+)?(?:(?:go|switch)\s+(?:to|into)\s+|enter\s+|activate\s+|open\s+|enable\s+|start\s+|turn\s+on\s+)?(?:the\s+)?["'\u201c]?interface\s+mode["'\u201d]?(?:\s+on)?\s*[.!]?$/i.test(t)){interfaceMode();return true;}
  if((m=/^(?:please\s+|hey\s+\w+[,\s]+)?(get|open|show|bring\s+up|pull\s+up|close|hide)\s+(?:the\s+|my\s+)?["'\u201c\u2018]?chat\s*(?:module|box|window)["'\u201d\u2019]?\s*[.!]?$/i.exec(t))){
    const on=!/^(close|hide)$/i.test(m[1]);
    if(typeof zenMode!=='undefined'&&zenMode){toast('Locked in Zen Mode');return true;}
    const cm=document.getElementById('p7-chatModule'),cb=document.getElementById('p7-chatToggle');
    if(cm&&cb){if(cm.classList.contains('p7-hidden')===on)cb.click();toast(on?'Chat module opened':'Chat module closed');}
    return true;}
  return false;
}


// ══════ ENGINE SETTINGS PANEL (G.H.O.S.T / J.A.R.V.I.S / F.R.I.D.A.Y config, formerly the left panel) ══════
const _ENG_BOX={ollama:'og',jarvis:'gg',friday:'fp'};let _engTab='jarvis';
function engTab(k,p){
  if(p){if(p==='pragon')return;k=p;}
  if(!_ENG_BOX[k])return;_engTab=k;
  Object.keys(_ENG_BOX).forEach(x=>{const b=document.getElementById(_ENG_BOX[x]);if(b)b.style.display=x===k?'block':'none';
    document.getElementById('et-'+x)?.classList.toggle('active',x===k);});
  if(k==='friday'&&window.J&&J.refreshRagDocs)try{J.refreshRagDocs();}catch(e){}
}
function toggleEnginePanel(f){const on=_fp('eng-panel',f);if(on)engTab(provider!=='pragon'?provider:_engTab);return on;}
// ══════ ORB LAUNCHER: Settings / Tools / Connections / Clock (from the hand-drawn plan) ══════
const _click=id=>()=>document.getElementById(id)?.click();
const ORB_LAUNCH={
  Settings:[
    ['Profile',()=>spPanel('spf-profile')],
    ['Persona',()=>spPanel('spf-persona')],
    ['Voice Shifter',()=>toggleVoicePanel(true)],
    ['What PRAGON Remembers',()=>PW.open('memory')],
    ['Devices',()=>spPanel('spf-devices')],
    ['Integration',()=>spPanel('spf-integration')],
    ['API Panel',()=>toggleApiPanel(true)],
    ['Save All',()=>PragonSave.saveAll(document.getElementById('saveall-btn'))],
    ['sec','Library'],
    ['Pragon Gallery',()=>openGallery()],
    ['Custom Draw (output)',()=>openCustomDraw()],
    ['sec','Language'],
    ['langs'],
    ['History',()=>spPanel('spf-history')],
    ['Clear History',()=>{if(confirm('Clear chat history?'))clearHistory();}],
    ['Engine Settings',()=>toggleEnginePanel(true)],
    ['sec','Panels'],
    ['Panel Look',()=>_fp('look-panel')],
    ['Arrange panels',()=>{openOrbLauncher(null);hudArrange();}],
    ['Close all panels',()=>hudCloseAll()]
  ],
  Tools:[
    ['Music Player',()=>_fp('mus-panel')],
    ['Pragon Mini System',()=>PW.open('minisys')],
    ['Pragon Notepad',()=>PW.open('notepad')],
    ['Key Shortcut Executer',()=>openKsx()],
    ['Click Executer',()=>openClickExec()],
    ['Compass',()=>openCompass()],
    ['Pulse',()=>openPulse()],
    ['Flight View',()=>openFlightView()],
    ['Ad Forge',()=>openAdGen()],
    ['Pragon Archiver',()=>PW.open('archiver')],
    ['Forge',()=>toggleForge()],
    ['Forge Mode',()=>_fp('fm-panel',true)],
    ['Custom Forge (CustomDraw)',()=>openCustomDraw()],
    ['Keywords',()=>spPanel('spf-keywords')]
  ],
  Connections:[
    ['Phone View + Live View',()=>spPanel('spf-phone')],
    ['PRAGON Call',()=>spPanel('spf-call')],
    ['PRAGON WhatsApp',()=>spPanel('spf-wa')],
    ['Camera',_click('p7-camToggle'),true,'p7-camToggle'],
    ['Chat Box',_click('p7-chatToggle')],
    ['Typer',()=>J.toggleTyper('active'),true,'p7-typerToggle'],
    ['Typer → Notepad',()=>J.toggleTyper('notepad'),true,'p7-typerNote'],
    ['PRAGON Status',()=>_fp('st-panel',true)],
    ['Reconnect PRAGON',()=>reconnectPragon()]
  ],
  Clock:[
    ['Clock',()=>_fp('clk-panel')],
    ['Scheduler',()=>openScheduler()],
    ['Ping (silent alarm)',()=>PW.open('ping')],
    ['Live Updates',()=>openLiveUpdates()]
  ]
};
let _olCur=null;
function openOrbLauncher(name){
  const pn=document.getElementById('ol-panel'),body=document.getElementById('ol-body');
  if(!pn||!body)return;
  if(!name||name===_olCur){pn.classList.remove('open');_olCur=null;clearInterval(window._olSync);return;}
  if(zenMode){toast('Locked in Zen Mode');return;}
  const items=ORB_LAUNCH[name];if(!items)return;
  body.innerHTML='';
  const q=document.createElement('input');q.type='text';q.className='olsearch';q.placeholder='Search all menus…';q.autocomplete='off';q.setAttribute('aria-label','Search menus');
  const list=document.createElement('div'),res=document.createElement('div');res.style.display='none';
  q.oninput=()=>{const t=q.value.trim().toLowerCase();res.innerHTML='';
    if(!t){res.style.display='none';list.style.display='';return;}
    list.style.display='none';res.style.display='';
    Object.keys(ORB_LAUNCH).forEach(g=>ORB_LAUNCH[g].forEach(it=>{
      if(it[0]==='sec'||it[0]==='langs'||String(it[0]).toLowerCase().indexOf(t)<0)return;
      const b=document.createElement('button');b.className='olbtn';b.textContent=it[0]+'  ·  '+g;
      b.onclick=()=>{try{it[1]();}catch(e){toast('Not available: '+it[0]);}if(!it[2])openOrbLauncher(null);};res.appendChild(b);}));
    if(!res.children.length){const d=document.createElement('div');d.className='olsec';d.textContent='No match';res.appendChild(d);}};
  body.appendChild(q);body.appendChild(res);
  items.forEach(it=>{
    if(it[0]==='sec'){const d=document.createElement('div');d.className='olsec';d.textContent=it[1];list.appendChild(d);return;}
