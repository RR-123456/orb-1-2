  // before we cleared it for the expanded preview.
  const sideEl=document.querySelector('#tp .tp-side');
  if(sideEl){
    const saved=parseInt(localStorage.getItem('pragon-tp-side-w'),10);
    sideEl.style.width=(saved&&saved>=110&&saved<=400)?saved+'px':'';
