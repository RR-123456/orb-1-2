.fpanel{position:fixed;top:64px;width:250px;max-width:calc(100vw - 32px);max-height:calc(100vh - 130px);z-index:30;display:none;flex-direction:column;background:rgba(0,0,0,.92);border:1px solid var(--border);border-radius:4px;backdrop-filter:blur(20px);box-shadow:0 8px 30px rgba(0,0,0,.5)}
