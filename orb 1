  [0,5],[5,6],[6,7],[7,8],
  [5,9],[9,10],[10,11],[11,12],
  [9,13],[13,14],[14,15],[15,16],
  [13,17],[17,18],[18,19],[19,20],
  [0,17]
];

/* Converts a "per ~33ms step" smoothing factor (the original tuning assumption, back when
   positions only updated once per camera frame at ~30fps) into a continuous rate, then
   reapplies it for the actual elapsed time. This keeps motion feeling the same regardless
   of the display's refresh rate or the camera's actual frame rate. */
function smoothingAlpha(baseFactor, dt){
  const clamped = Math.min(Math.max(baseFactor, 0.0001), 0.999);
  const rate = -Math.log(1 - clamped) / 33;
  return 1 - Math.exp(-rate * dt);
}

function computeCoverTransform(){
  const rect = viewport.getBoundingClientRect();
  const cw = rect.width, ch = rect.height;
  const vw = video.videoWidth || 1, vh = video.videoHeight || 1;
  const scale = Math.max(cw/vw, ch/vh);
  const rw = vw*scale, rh = vh*scale;
  const ox = (cw-rw)/2, oy = (ch-rh)/2;
  return { scale, rw, rh, ox, oy, cw, ch };
}
function sizeCanvasToContainer(){
  if(!video.videoWidth) return;
  const rect = viewport.getBoundingClientRect();
  const dpr = Math.min(window.devicePixelRatio || 1, 2); // cap at 2x — 3x+ retina scaling costs perf with no visible gain here
  canvas.width = Math.round(rect.width * dpr);
  canvas.height = Math.round(rect.height * dpr);
  canvas.style.width = rect.width + 'px';
  canvas.style.height = rect.height + 'px';
  coverT = computeCoverTransform();
  coverT.dpr = dpr;
}
