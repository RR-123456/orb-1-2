function fgGetSearchMatches(){
  if(!FS.searchQ)return[];
  try{const pat=new RegExp(FS.searchQ.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'),FS.caseSens?'g':'gi');const code=FS.files[FS.activeFile];const matches=[];let r;while((r=pat.exec(code))!==null){matches.push({start:r.index,end:r.index+r[0].length});if(matches.length>500)break;}return matches;}
  catch{return[];}
}
function fgNavSearch(dir){const matches=fgGetSearchMatches();if(!matches.length)return;FS.searchIdx=(FS.searchIdx+dir+matches.length)%matches.length;const m=matches[FS.searchIdx];if(!cm)return;cm.setSelection(cm.posFromIndex(m.start),cm.posFromIndex(m.end));cm.scrollIntoView(null,60);fgUpdateSearchUI();}
function fgUpdateSearchUI(){const matches=fgGetSearchMatches();const el=$('fg-search-match');if(el)el.textContent=matches.length?`${Math.min(FS.searchIdx+1,matches.length)}/${matches.length}`:'0';}

async function callForgeJarvis(prompt,maxTok=1000){
  const key=getKey();if(!key)throw new Error('No Jarvis API key');
  const gm=getModel();
  const r=await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${gm}:generateContent?key=${key}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({contents:[{role:'user',parts:[{text:prompt}]}],generationConfig:{maxOutputTokens:maxTok}})});
  const d=await r.json();if(d.error)throw new Error(d.error.message);
  return d.candidates?.[0]?.content?.parts?.[0]?.text??'';
}
