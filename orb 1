#demospin:active{transform:translateX(-50%) scale(.96)}
</style>
<script>
(function(){
  var steps=[
    {n:'Spin R R L',w:'RRL'},
    {n:'Spin L L R',w:'LLR'},
    {n:'Pulse x2',w:'pulse'},
    {n:'Loading',w:'loading',stop:8000},
    {n:'Success',w:'success'},
    {n:'Error',w:'error'}
  ],i=0,b=document.getElementById('demospin'),tm=null;
  b.addEventListener('click',function(){
    var st=steps[i];i=(i+1)%steps.length;
    clearTimeout(tm);
    try{
      var o=document.getElementById('orb-ui').contentWindow.orb;
      if(!o||!o.demo)throw new Error('orb not ready');
      o.demo(st.w);
      b.innerHTML='&#9654; '+st.n;
      if(st.stop)tm=setTimeout(function(){try{o.demo('idle')}catch(e){}},st.stop);
    }catch(e){b.innerHTML='&#9888; '+e.message;}
  });
})();
</script>

