/* ── DRAG & DROP ── */
#drop-overlay{position:fixed;inset:0;z-index:200;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.88);backdrop-filter:blur(8px);border:3px dashed rgba(18,144,255,.35);animation:fs .25s ease;flex-direction:column;gap:18px;pointer-events:none}
