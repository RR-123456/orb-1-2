}

function serializeLandmarks(lm){
  return lm.map(p => [parseFloat(p.x.toFixed(5)), parseFloat(p.y.toFixed(5)), parseFloat(p.z.toFixed(5))]);
}

function normalizeLandmarks(lm){
  const n = lm.length;
  let cx=0, cy=0, cz=0;
  for(const p of lm){ cx+=p.x; cy+=p.y; cz+=p.z; }
  cx/=n; cy/=n; cz/=n;
  let sum=0;
  for(const p of lm){
    const dx=p.x-cx, dy=p.y-cy, dz=p.z-cz;
    sum += dx*dx + dy*dy + dz*dz;
  }
  const scale = Math.sqrt(sum/n) || 1;
  return lm.map(p => ({ x:(p.x-cx)/scale, y:(p.y-cy)/scale, z:(p.z-cz)/scale }));
}

function compareFaceMeshes(current, master){
  const n = current.length;
  if(n !== master.length) return Infinity;
  let total = 0;
  for(let i=0;i<n;i++){
    const dx = current[i].x - master[i].x;
    const dy = current[i].y - master[i].y;
    const dz = current[i].z - master[i].z;
    total += dx*dx + dy*dy + dz*dz;
  }
  return Math.sqrt(total / n);
}

function setAuthState(state){
