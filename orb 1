<style id="pragon-hud">
/* ═══ PRAGON HUD WIDGETS — the JARVIS demo's widget look (title tab, cut-corner glass, haze glow), in PRAGON blue ═══ */
:root{--hz:18,144,255;--hzr:1;--hzs:1;--wa:.22;--wb:10px;--gt:16,72,140;--gt2:4,18,38;--tab1:#1290ff;--tab2:#8fcaff;--tabtx:#021326;--ptx:#d6e8ff;--pdim:#8aa6c8;--pline:110,180,255}
.fpanel{--wl:0;background:none!important;border:0!important;border-radius:0!important;box-shadow:none!important;-webkit-backdrop-filter:none!important;backdrop-filter:none!important;overflow:visible!important;font-family:var(--ours);color:var(--ptx)}
.fpanel.open{animation:hudIn .18s ease-out}
@keyframes hudIn{from{opacity:0;transform:scale(.94)}to{opacity:1;transform:none}}
@media(prefers-reduced-motion:reduce){.fpanel.open{animation:none}}
.fpanel .fphead{align-self:flex-start;flex:none;width:max-content;min-width:112px;max-width:100%;height:17px;gap:14px;padding:2px 20px 2px 10px;border:0;
 background:linear-gradient(90deg,var(--tab1),var(--tab2));color:var(--tabtx);font-family:var(--ours);font-size:9px;font-weight:700;letter-spacing:.16em;
 cursor:grab;touch-action:none;user-select:none;-webkit-user-select:none;clip-path:polygon(0 0,calc(100% - 9px) 0,100% 100%,0 100%)}
.fpanel .fphead:active{cursor:grabbing}
.fpanel .fphead button{color:var(--tabtx);font-size:13px;opacity:.7;padding:0 2px}
.fpanel .fphead button:hover,.fpanel .fphead button:focus-visible{color:#b3200a;opacity:1;outline:none}
.fpanel .fpbody{padding:12px 14px 14px;min-height:0;border-top:1px solid rgba(var(--pline),.55);
 background:linear-gradient(105deg,transparent 48%,rgba(150,205,255,calc(var(--wa)*.35)) 62%,transparent 78%),linear-gradient(160deg,rgba(var(--gt),calc(var(--wa)*.85)),rgba(var(--gt2),var(--wa)));
 -webkit-backdrop-filter:blur(var(--wb)) saturate(1.2);backdrop-filter:blur(var(--wb)) saturate(1.2);text-shadow:0 1px 8px rgba(0,0,0,.45);
 box-shadow:inset 0 0 0 1px rgba(150,205,255,calc(.12 + var(--wa)*.1)),
  inset 0 0 calc((12px + var(--wl)*30px)*var(--hzr)) calc(2px + var(--wl)*8px) rgba(var(--hz),calc((.38 + var(--wl)*.62)*var(--hzs))),
  inset 0 0 calc(var(--wl)*8px) 1px rgba(190,225,255,calc((.14 + var(--wl)*.7)*var(--hzs)));
 clip-path:polygon(0 0,calc(100% - 10px) 0,100% 10px,100% calc(100% - 18px),calc(100% - 18px) 100%,6px 100%,0 calc(100% - 6px))}
.fpanel .fpbody::-webkit-scrollbar{width:4px;height:4px}.fpanel .fpbody::-webkit-scrollbar-thumb{background:rgba(var(--pline),.5)}
.fpanel .fpbody input:not([type=range]):not([type=checkbox]):not([type=radio]):not([type=file]):not([type=color]),.fpanel .fpbody select,.fpanel .fpbody textarea{background:rgba(2,10,22,.42);border:1px solid rgba(var(--pline),.3);border-radius:2px;color:var(--ptx);font-family:var(--ours);font-size:11px;outline:none}
.fpanel .fpbody input:focus,.fpanel .fpbody select:focus,.fpanel .fpbody textarea:focus{border-color:rgb(var(--pline))}
.fpanel .fpbody input::placeholder,.fpanel .fpbody textarea::placeholder{color:var(--pdim)}
.fpanel select option{background:#06101e;color:var(--ptx)}
.fpanel .olbtn,.fpanel .tbtn,.fpanel .hbtn,.fpanel .fg-ibtn{display:block;width:100%;text-align:left;background:rgba(18,144,255,.16);border:1px solid rgba(var(--pline),.3);border-radius:2px;color:#dcecff;font-family:var(--ours);font-size:11px;font-weight:700;letter-spacing:.04em;text-transform:none;padding:6px 10px;margin:0 0 5px;cursor:pointer}
.fpanel .tbtn{text-align:center}
.fpanel .olbtn:hover,.fpanel .tbtn:hover,.fpanel .hbtn:hover,.fpanel .fg-ibtn:hover,.fpanel .olbtn:focus-visible,.fpanel .hbtn:focus-visible{background:rgba(18,144,255,.42);color:#fff;border-color:rgb(var(--pline));outline:none}
.fpanel .olbtn.active{background:rgba(18,144,255,.38);border-color:rgb(var(--pline));color:#fff;box-shadow:0 0 8px rgba(var(--hz),.35)}
.fpanel .pill{font-family:var(--ours);font-size:10.5px;letter-spacing:.03em;padding:4px 10px;border-radius:2px;color:var(--ptx);background:rgba(140,200,255,.08);border:1px solid rgba(var(--pline),.3)}
.fpanel .pill:hover{background:rgba(18,144,255,.3);border-color:rgb(var(--pline));color:#fff}
.fpanel .pill.active{background:rgba(18,144,255,.4);border-color:rgb(var(--pline));color:#fff}
.fpanel .pills,.fpanel .olpills{gap:5px}
.fpanel .lph,.fpanel .olsec{font-family:var(--ours);font-size:9.5px;font-weight:700;letter-spacing:.14em;color:var(--pdim);border-bottom:1px solid rgba(var(--pline),.18)}
.fpanel .lf label{font-family:var(--ours);font-size:10px;letter-spacing:.04em;color:var(--pdim);text-transform:none}
.fpanel .lf input,.fpanel .lf select{font-family:var(--ours);font-size:11px}
.fpanel .cstat{font-family:var(--ours);font-size:10.5px;color:var(--pdim)}
.fpanel .fg-toggle,.fpanel label{font-family:var(--ours)}
.fpanel input[type=range]{accent-color:#1290ff}
.fpanel .olsearch{width:100%;margin:0 0 8px;padding:6px 10px}
.hud-time{font-size:34px;font-weight:700;text-align:center;letter-spacing:.08em;text-shadow:0 0 12px rgb(var(--hz));text-transform:uppercase;font-variant-numeric:tabular-nums}
.hud-date{text-align:center;color:var(--pdim);font-size:10px;letter-spacing:.1em;text-transform:uppercase;margin-top:2px}
.mus-trk{display:flex;gap:12px;align-items:center;margin-bottom:8px}
.mus-art{width:54px;height:54px;flex:none;display:grid;place-items:center;font-size:22px;color:#fff;border:1px solid rgba(180,220,255,.4);background:linear-gradient(135deg,#1290ff,#0a3f8a 60%,#021326)}
.mus-trk b{display:block;font-size:13px;color:#fff;max-width:190px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mus-trk span{font-size:10px;color:var(--pdim)}
.mus-bars{display:flex;gap:3px;align-items:flex-end;height:26px;margin:4px 0 8px}
.mus-bars i{flex:1;background:var(--tab1);height:12%;opacity:.85;transition:height .08s}
.mus-prog{height:4px;background:rgba(255,255,255,.18);cursor:pointer;margin-bottom:4px}
.mus-prog div{height:100%;width:0;background:var(--tab2);box-shadow:0 0 8px var(--tab1)}
.mus-tm{display:flex;justify-content:space-between;color:var(--pdim);font-size:10px;margin-bottom:8px}
.mus-ctl{display:flex;gap:6px;margin-bottom:8px}
.mus-ctl .hbtn{width:auto;flex:1;text-align:center;margin:0;padding:4px 0}
.mus-ctl .hbtn.on{background:rgba(18,144,255,.5);border-color:rgb(var(--pline));color:#fff}
.hud-rg{display:block;font-size:10.5px;color:var(--pdim);margin:0 0 6px}.hud-rg output{color:var(--ptx);float:right}.hud-rg input{width:100%}
.hud-ls{max-height:120px;overflow:auto;margin-top:6px}
.hud-li{display:flex;justify-content:space-between;gap:8px;align-items:center;font-size:11px;padding:5px 2px;border-bottom:1px solid rgba(var(--pline),.15);cursor:pointer}
.hud-li:hover{color:#fff}.hud-li.cur{color:var(--tab2);font-weight:700}
.hud-li span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.hud-li button{background:none;border:0;color:var(--pdim);cursor:pointer;font-size:14px}
.hud-cl{display:flex;align-items:center;justify-content:space-between;font-size:11px;color:var(--ptx);margin:0 0 6px}
.hud-cl input[type=color]{width:46px;height:24px;padding:1px;background:none;border:1px solid rgba(var(--pline),.3);border-radius:2px;cursor:pointer}
/* inline-styled tiny text in the old panels -> readable HUD type */
.fpanel .fpbody [style*="font-size:7px"],.fpanel .fpbody [style*="font-size:8px"]{font-size:10px!important;font-family:var(--ours)!important;letter-spacing:.03em!important}
.fpanel .fpbody [style*="font-size:9px"]{font-size:11.5px!important;font-family:var(--ours)!important;letter-spacing:.03em!important}
.fpanel .fpbody [style*="color:rgba(18,144,255,.8)"],.fpanel .fpbody [style*="color:rgba(18,144,255,.6)"]{color:var(--ptx)!important}
.fpanel .fpbody [style*="color:rgba(18,144,255,.3"],.fpanel .fpbody [style*="color:rgba(18,144,255,.4"],.fpanel .fpbody [style*="color:rgba(18,144,255,.5"],.fpanel .fpbody [style*="color:rgba(18,144,255,.25"]{color:var(--pdim)!important}
.fpanel .fpbody textarea,.fpanel .fpbody select,.fpanel .fpbody input:not([type=range]):not([type=checkbox]):not([type=radio]):not([type=file]):not([type=color]){font-family:var(--ours)!important;color:var(--ptx)!important;background:rgba(2,10,22,.42)!important;border:1px solid rgba(var(--pline),.3)!important;border-radius:2px!important;font-size:11px!important}
.fpanel .fg-toggle{background:rgba(var(--pline),.15);border-color:rgba(var(--pline),.35)}.fpanel .fg-toggle.on{background:rgba(18,144,255,.7);border-color:rgb(var(--pline))}
</style>

</head>
