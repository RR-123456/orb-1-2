function callSharedJarvis(messages,systemPrompt,maxTokens=4096){
  const key=getKey();if(!key)throw new Error('Jarvis API Key missing — paste it in Engine');
  const gm=getModel();
  const contents=messages.map(m=>({role:m.role==='assistant'?'model':'user',parts:[{text:m.content}]}));
  const body={contents,generationConfig:{maxOutputTokens:maxTokens,temperature:0.4}};
  if(systemPrompt)body.systemInstruction={parts:[{text:systemPrompt}]};
  return fetch(`https://generativelanguage.googleapis.com/v1beta/models/${gm}:generateContent?key=${key}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
    .then(r=>{if(!r.ok)return r.json().then(e=>{throw new Error(e?.error?.message||'HTTP '+r.status)});return r.json();})
    .then(d=>d?.candidates?.[0]?.content?.parts?.[0]?.text||'No response.');
}
async function queryJarvis(txt){const msgs=buildMsgs(txt);const rep=await callSharedJarvis(msgs,FORGE_SYS+'\n\nFORGE_MODE: '+forgeMode,4096);recordReply(rep);return rep;}

function extractCode(text){
  const htmlMatch=text.match(/```html\s*([\s\S]*?)```/i);if(htmlMatch)return{type:'html',code:htmlMatch[1].trim()};
  const codeMatch=text.match(/```(\w+)?\s*([\s\S]*?)```/);if(codeMatch)return{type:codeMatch[1]||'text',code:codeMatch[2].trim()};
  if(text.trim().toLowerCase().startsWith('<!doctype')||text.trim().startsWith('<html'))return{type:'html',code:text.trim()};
  return null;
}
function shouldRenderInForge(text,mode){
  if(mode==='html')return true;if(mode==='code')return false;
  if(text.trim().toLowerCase().startsWith('<!doctype'))return true;
  if(text.trim().startsWith('<html'))return true;
  if(/```html/i.test(text))return true;
  return false;
}

// ── Main ask() for Ollama / Jarvis engines (PRAGON engine bypasses this) ──
// txt: enriched text (may include attachment dump) used for normal chat.
// rawTxt: clean user-typed text only (no attachment dump) — used as the
// actual prompt for image generation so a giant base64 blob never ends up
// inside the model prompt. att: the raw pendingAttachment object (if any)
// captured at send-time, used as the reference image for image-to-image.
async function askEngine(txt,rawTxt,att){
  if(busy)return;busy=true;setStat('Processing…');
  rawTxt=rawTxt||txt;
  txt=langLockText(txt);
  const refImage=(att&&att.type==='image'&&att.data)?att.data:null;

  if(isImageRequest(rawTxt)){
    try{
      setStat('Synthesizing image…');
      toast(refImage?'Synthesizing image from reference, Sir…':'Synthesizing image, Sir…');
      addImageLoadingMsg();
      let result;
      try {
        result = await callJarvisImageGen(rawTxt,refImage);
      } catch(e) {
        removeImageLoadingMsg();
        addMsg('assistant',' ' + e.message);
        return;
      }
      removeImageLoadingMsg();addImageMsg(result.base64,result.mimeType,rawTxt); speak('Image synthesized, Sir.');
      setStat('Standby');toast('Image ready, Sir.');
    }catch(e){
      removeImageLoadingMsg();addMsg('assistant',' Image generation failed: '+e.message);
      toast('Image error: '+e.message.slice(0,50));setStat('Error — check Engine');
    }finally{busy=false;}
    return;
  }

  if(isFileRequest(txt)){
    const fileType=detectFileType(txt);
    try{
      setStat('Generating file…');toast('Generating '+fileType.toUpperCase()+', Sir…');addMsg('assistant','Generating your '+fileType.toUpperCase()+' file, Sir…');
      // FRIDAY is a RAG-first engine — ground generated files in whatever's
      // been ingested about this topic, same context her chat replies use.
      let genPrompt=txt;
      if(provider==='friday'){
        const ragContext=await ragRetrieve(rawTxt);
        if(ragContext)genPrompt=ragAugment(txt,ragContext);
      }
      const data=await callFileGen(genPrompt,fileType);
      const fileInfo=await buildAndSaveFile(data,txt);
      addFileCard(fileInfo);
      speak(fileType.toUpperCase()+' file saved to your Library, Sir.');
      setStat('Standby');toast('File saved to Library');
    }catch(e){
      addMsg('assistant',' File generation failed: '+e.message);
      toast('File error: '+e.message.slice(0,50));setStat('Error — check Engine');
    }finally{busy=false;}
    return;
  }

  try{
    const rep=provider==='jarvis'?await queryJarvis(txt):provider==='friday'?await queryFriday(txt):await queryGhost(txt);
    const goToForge=shouldRenderInForge(rep,forgeMode);
    let displayText=rep;
    if(goToForge){
      const extracted=extractCode(rep);
      const htmlCode=extracted&&extracted.type==='html'?extracted.code:(rep.trim().startsWith('<!doctype')||rep.trim().startsWith('<html')?rep.trim():null);
      if(htmlCode){
        FS.files.html=htmlCode;FS.histories.html=[...FS.histories.html,htmlCode].slice(-50);FS.histIdxs.html=FS.histories.html.length-1;FS.compiled={html:htmlCode};
        if(forgeMounted){fgActivateFile('html');FS.activeViewTab='preview';fgUpdateVtabs();forgeCompile();}
                addMsg('assistant','Code generated, Sir.');addCodeModule('html',assistantName());
        speak('Code ready, Sir. Open F.O.R.G.E to view it.');
        toast('Code ready — open F.O.R.G.E to view');displayText=null;
      }else if(extracted){
        const lang=extracted.type;const fileKey=lang==='css'?'css':lang==='javascript'||lang==='js'?'js':'html';
        FS.files[fileKey]=extracted.code;FS.histories[fileKey]=[...FS.histories[fileKey],extracted.code].slice(-50);FS.histIdxs[fileKey]=FS.histories[fileKey].length-1;
        if(forgeMounted){fgActivateFile(fileKey);forgeCompile();}
        addMsg('assistant','Code generated, Sir.');addCodeModule(fileKey,assistantName());
        toast('Code ready — open F.O.R.G.E to view');displayText=null;
      }
    }
        if(displayText!==null){addMsg('assistant',displayText);speak(displayText);}
    setStat('Standby');
   }catch(e){
    addMsg('assistant',' '+e.message);speak('I ran into an error, Sir.');
    toast('Error: '+e.message.slice(0,50));setStat('Error — check Engine');
  }finally{busy=false;}
}

