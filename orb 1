function buildMsgs(txt){gHistory.forEach(m=>{if(m.role==='user')m.content=stripLangLock(m.content);});gHistory.push({role:'user',content:txt});if(gHistory.length>30)gHistory=gHistory.slice(-30);return gHistory;}
function recordReply(txt){gHistory.push({role:'assistant',content:txt});}

async function queryOllama(txt){
  const host=$('ohost').value.trim()||'http://localhost:11434';
  const msgs=buildMsgs(txt);
  const r=await fetch(host+'/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({model,messages:[{role:'system',content:FORGE_SYS+'\n\nFORGE_MODE: '+forgeMode},...msgs],stream:false})});
  if(r.status===404)throw new Error(`Model "${model}" not installed. Run: ollama pull ${model}`);
  if(!r.ok)throw new Error('Ollama HTTP '+r.status);
  const d=await r.json();const rep=d?.message?.content||'No response.';recordReply(rep);return rep;
}
// ── RAG (ragsystem) retrieval for FRIDAY ────────────────────────────────
// Talks to the standalone "Universal RAG System" (FastAPI service, default
// http://localhost:8000) that ingests uploaded files (docs/spreadsheets/
// images/audio/video/code) into a local ChromaDB store. This only calls
// its retrieval-only /retrieve endpoint — FRIDAY's own Gemma model still
// writes the final answer (in FRIDAY's voice), just grounded in whatever
// relevant chunks come back. Purely additive: if RAG is off, unreachable,
// or has nothing relevant, FRIDAY behaves exactly as before.
function ragHost(){return ($('frag-host')?.value.trim())||localStorage.getItem('jfr_rag_host')||'http://localhost:8000';}
function ragEnabled(){return $('frag-enabled')?$('frag-enabled').checked:localStorage.getItem('jfr_rag_on')==='1';}
async function ragRetrieve(question){
  if(!ragEnabled())return '';
  try{
    const r=await fetch(ragHost()+'/retrieve',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({question,top_k:5}),signal:AbortSignal.timeout(8000)});
    if(!r.ok)return '';
    const d=await r.json();
    const chunks=d?.chunks||[];
    if(!chunks.length)return '';
    return chunks.map(c=>`--- From ${c.source_file} ---\n${c.text}`).join('\n\n');
  }catch(e){return '';/* RAG service unreachable — fail silent, don't block chat */}
}
function ragAugment(txt,context){
  if(!context)return txt;
  return `KNOWLEDGE BASE CONTEXT (from your uploaded files, may or may not be relevant):\n\n${context}\n\n---\n\nUser question: ${txt}`;
}
async function queryFriday(txt){
  const host=$('fhost').value.trim()||'http://localhost:11434';
  const fmodel=$('fmodel').value.trim()||'gemma3';
  const ragContext=await ragRetrieve(txt);
  const sendTxt=ragAugment(txt,ragContext);
  // Preferred path: route through the PRAGON backend so FRIDAY gets memory,
  // voice-command tools, the autonomous action agent, agentic core (morning
  // brief / deadlines / etc.), and screen vision — the same tools PRAGON has.
  try{
    const br=await fetch('/friday/act',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text:sendTxt,host,model:fmodel})});
    if(br.ok){
      const bd=await br.json();
      if(bd&&bd.reply){recordReply(bd.reply);return bd.reply;}
    }
    // non-200 (e.g. 503 backend not ready) — fall through to direct call below
  }catch(e){/* backend unreachable — fall through to direct call below */}
  // Fallback: original direct-to-Ollama chat, unchanged — keeps FRIDAY working
  // even if the Python backend isn't running. gHistory keeps the user's raw
  // text (not the RAG-augmented version) so context blocks don't pile up in
  // conversation memory across turns; only this one outgoing call is augmented.
  const msgs=buildMsgs(txt);
  const sendMsgs=msgs.slice(0,-1).concat([{role:'user',content:sendTxt}]);
  const r=await fetch(host+'/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({model:fmodel,messages:[{role:'system',content:FRIDAY_SYS+'\n\nFORGE_MODE: '+forgeMode},...sendMsgs],stream:false})});
  if(r.status===404)throw new Error(`Model "${fmodel}" not installed. Run: ollama pull ${fmodel}`);
  if(!r.ok)throw new Error('Ollama HTTP '+r.status);
  const d=await r.json();const rep=d?.message?.content||'No response.';recordReply(rep);return rep;
}
