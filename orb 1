function testVoice(kind){
  if(kind==='engine'){
    if(ws&&ws.readyState===1){ws.send(JSON.stringify({type:'test_voice'}));toast('Playing a sample from the P.R.A.G.O.N engine...');}
    else toast('Engine not connected');
    return;
  }
  // Speak a sample with the system voice / rate / pitch currently chosen in the Voice Shifter.
  const synth=window.speechSynthesis;
  if(!synth){toast('This browser has no speech support');return;}
  try{synth.cancel();synth.resume();}catch(e){}
  const u=new SpeechSynthesisUtterance('Hello, I am Pragon. Voice test. All systems operational.');
  const voices=synth.getVoices();
  const sel=$('vsel')?.value;
  let v=null;
  if(sel&&sel.startsWith('voice_')){v=voices[parseInt(sel.split('_')[1])]||null;}
  if(!v){
    const lp=(currentLang||'en-US').split('-')[0];
    v=voices.find(x=>x.lang.toLowerCase()===(currentLang||'en-US').toLowerCase())||voices.find(x=>x.lang.toLowerCase().startsWith(lp))||voices.find(x=>x.lang.startsWith('en'))||null;
  }
  if(v){u.voice=v;u.lang=v.lang;}else{u.lang=currentLang||'en-US';}
  u.rate=parseFloat($('vrate')?.value)||1.0;
  u.pitch=parseFloat($('vpitch')?.value)||0.9;
  u.volume=1;
  u.onstart=()=>toast('Speaking with '+(v?v.name:'default voice'));
  u.onerror=e=>{
    const err=(e&&e.error)||'unknown';
    toast('Voice failed ('+err+')'+((v&&!v.localService)?' - online voices need internet. Pick a local voice (no "Online") in the list.':''));
  };
  setTimeout(()=>{try{synth.speak(u);}catch(e){toast('Voice failed: '+e.message);}},80);
}

// ══════ FORGE / OLLAMA / JARVIS ENGINE ══════
let provider='pragon',model='llama3.2',forgeMode='auto',busy=false,gHistory=[];

/* ══════ ZEN MODE ══════
   Ships locked by default on every load. While active: CAM / CHAT / Tools
   topbar buttons and the Engine switcher are disabled and PRAGON is forced
   as the only provider. Unlocks (for the current session) by typing or
   speaking the phrase below — re-locks automatically on next reload. */
let zenMode = true;
const ZEN_UNLOCK_PHRASE = 'pragon daddy home';
const ZEN_LOCK_IDS = ['p7-camToggle','p7-chatToggle','stog','p-friday','p-ollama','p-jarvis','forge-toggle','sp-tog'];

function zenNormalize(s){ return (s||'').toLowerCase().replace(/[^a-z\s]/g,'').replace(/\s+/g,' ').trim(); }

function tryZenUnlock(text){
  if(!zenMode) return false;
  if(zenNormalize(text) === ZEN_UNLOCK_PHRASE){ exitZenMode(); return true; }
  return false;
}

function enterZenMode(){
  zenMode = true;
  if(provider !== 'pragon') J.setProvider('pragon');
  ZEN_LOCK_IDS.forEach(id=>{ const el=$(id); if(el){ el.classList.add('zen-locked'); el.setAttribute('aria-disabled','true'); } });
  $('p7-camModule')?.classList.add('p7-hidden');
  $('p7-chatModule')?.classList.add('p7-hidden');
  if(sideOpen){ sideOpen=false; $('lp')?.classList.remove('open'); $('stog')?.classList.remove('po'); }
  if(forgeOpen) hideForge();
  document.querySelectorAll('.fpanel.open').forEach(x=>x.classList.remove('open'));
  if(spOpen){ spOpen=false; $('sp')?.classList.remove('open'); const sppanel=$('sp-panel'); if(sppanel) sppanel.style.transform='translateX(300px)'; }
}

function exitZenMode(){
  zenMode = false;
  ZEN_LOCK_IDS.forEach(id=>{ const el=$(id); if(el){ el.classList.remove('zen-locked'); el.removeAttribute('aria-disabled'); } });
  toast('Zen Mode off — full engine & tools access restored');
}
let currentLang=localStorage.getItem('jlang')||'en-US';
// Language mode: dynamic (LIVE, default) follows whatever language the user uses; locked (EN/TA/HI/TE) forces one language.
let langLocked=localStorage.getItem('jlangLock')==='1';
const LANG_NAMES={'en':'English','ta':'Tamil','hi':'Hindi','te':'Telugu'};
function detectLang(t){
  const s=t||'';
  if(/[\u0B80-\u0BFF]/.test(s))return 'ta-IN';
  if(/[\u0900-\u097F]/.test(s))return 'hi-IN';
  if(/[\u0C00-\u0C7F]/.test(s))return 'te-IN';
  return 'en-US';
}
// Extra instruction appended to what the AI sees (never shown in the chat).
function langLockText(t){
  if(!langLocked)return t;
  const n=LANG_NAMES[(currentLang||'en-US').split('-')[0]]||'English';
  return t+'\n\n[LANGUAGE LOCK: write your entire reply in '+n+' only, even if earlier messages or the user were in another language. Do not use any other language.]';
}
function sendLangToBackend(){
  try{
    if(ws&&ws.readyState===1){
      const code=(currentLang||'en-US').split('-')[0];
      ws.send(JSON.stringify({type:'set_lang',locked:langLocked,name:LANG_NAMES[code]||'English'}));
    }
  }catch(e){}
}
function stripLangLock(t){return (t||'').replace(/\n\n\[LANGUAGE LOCK:[^\]]*\]/g,'');}
function syncLangButtons(){
  document.querySelectorAll('.lang-btn').forEach(b=>b.classList.remove('active'));
  if(langLocked){($('lang-'+(currentLang||'en-US').split('-')[0])||$('lang-en'))?.classList.add('active');}
  else{$('lang-live')?.classList.add('active');}
}
function getKey(){return $('gkey')?.value.trim()||'';}
function getModel(){return $('gmodel')?.value.trim()||'gemini-3.5-flash';}
function getImgModel(){return $('imgmodel')?.value.trim()||'gemini-3.1-flash-image';}

const IMG_KEYWORDS=/\b(create|generate|make|draw|render|show|synthesize|produce|design|paint|illustrate)\b[\s\S]{0,30}?(image|img|picture|photo|pic|illustration|artwork|art|wallpaper|poster|thumbnail|portrait|scene|visual)\b|\b(image|picture|photo)\s+of\b/i;
const IMG_KEYWORDS2=/^(draw|paint|render|illustrate|visualize)\s+/i;
function isImageRequest(txt){return IMG_KEYWORDS.test(txt)||IMG_KEYWORDS2.test(txt);}

// ══════ FILE GENERATION (auto-detect \u2192 Library) ══════
const FILE_KEYWORDS=/\b(create|generate|make|write|build|draft|save|export)\b[\s\S]{0,40}?\b(file|document|doc|report|script|program|spreadsheet|sheet|zip|archive|bundle|resume|invoice|webpage|website|batch)\b/i;
function detectFileType(txt){
  const t=txt.toLowerCase();
  if(/\bzip\b|\barchive\b|\bbundle\b/.test(t))return 'zip';
  if(/\bpdf\b/.test(t))return 'pdf';
  if(/\bcsv\b/.test(t))return 'csv';
  if(/\bxlsx?\b|\bexcel\b|\bspreadsheet\b/.test(t))return 'xlsx';
  if(/\.py\b|\bpython\s+(script|code|program|file)\b/.test(t))return 'py';
  if(/\bjson\b/.test(t))return 'json';
  if(/\.bat\b|\bbatch\s+(file|script)\b/.test(t))return 'bat';
  if(/\.js\b|\bjavascript\b/.test(t))return 'js';
  if(/\bhtml\b|\bwebsite\b|\bweb\s?page\b/.test(t))return 'html';
  if(/\bword\b|\bdocx?\b|\bdocument\b/.test(t))return 'doc';
  return 'txt';
}
function isFileRequest(txt){return !isImageRequest(txt)&&FILE_KEYWORDS.test(txt);}

async function callFileGen(prompt,fileType){
  const r=await fetch('/api/generate-file',{
    method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({prompt,file_type:fileType,model:provider,key:getKey()})
  });
  const data=await r.json();
  if(!data.ok)throw new Error(data.error||'Generation failed');
  return data;
}

function _slugFilename(prompt,ext){
  const base=prompt.trim().toLowerCase().replace(/[^a-z0-9]+/g,'_').replace(/^_+|_+$/g,'').slice(0,40)||'generated';
  return base+'_'+Date.now()+'.'+ext;
}

async function buildAndSaveFile(data,prompt){
  const ft=data.file_type;
  let blob,name,libType;

  if(ft==='zip'){
    let items;
    try{items=JSON.parse(data.content);}catch(e){throw new Error('Model did not return a valid file bundle.');}
    const zip=new JSZip();
    items.forEach(f=>zip.file(f.filename||'file.txt',f.content||''));
    blob=await zip.generateAsync({type:'blob'});
    name=_slugFilename(prompt,'zip');libType='archive';
  }else if(ft==='pdf'){
    const {jsPDF}=window.jspdf;const doc=new jsPDF();
    doc.setFont('courier');doc.setFontSize(12);
    const lines=doc.splitTextToSize(data.content,170);
    doc.text(lines,20,20);
    blob=doc.output('blob');name=_slugFilename(prompt,'pdf');libType='pdf';
  }else if(ft==='xlsx'||ft==='csv'){
    const ws=XLSX.read(data.content,{type:'string'}).Sheets.Sheet1||XLSX.utils.aoa_to_sheet(data.content.split('\n').map(r=>r.split(',')));
    const wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,ws,'Sheet1');
    const out=XLSX.write(wb,{bookType:'xlsx',type:'array'});
    blob=new Blob([out],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'});
    name=_slugFilename(prompt,'xlsx');libType='sheet';
  }else if(ft==='doc'){
    const html='<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40"><head><meta charset="utf-8"></head><body>'+
      data.content.split('\n').map(l=>l.startsWith('#')?'<h2>'+l.replace(/^#+\s*/,'')+'</h2>':'<p>'+l+'</p>').join('')+'</body></html>';
    blob=new Blob(['\ufeff',html],{type:'application/msword'});
    name=_slugFilename(prompt,'doc');libType='doc';
  }else{
    const mimeMap={py:'text/x-python',js:'text/javascript',html:'text/html',bat:'text/plain',json:'application/json',txt:'text/plain'};
    blob=new Blob([data.content],{type:mimeMap[ft]||'text/plain'});
    name=_slugFilename(prompt,ft);libType=(ft==='txt'||ft==='json')?'text':'code';
  }

  const url=URL.createObjectURL(blob);
  return {name,url,libType,size:blob.size};
}

