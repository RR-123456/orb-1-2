/* ================= AIR MOUSE HELPERS ================= */

function dispatchMouse(el, type, x, y){
  if(!el) return;
  const ev = new MouseEvent(type, {
    bubbles: true,
    cancelable: true,
    view: window,
    clientX: x,
    clientY: y,
    screenX: x,
    screenY: y,
    pointerType: 'hand',
    isPrimary: true
  });
  el.dispatchEvent(ev);
}

function updateAirMouseTarget(index, thumb){
  if(!index || !thumb){ airMouseTargetActive = false; return; }

  targetCursorX = (1 - index.x) * window.innerWidth;
  targetCursorY = index.y * window.innerHeight;

  targetCursorX = Math.max(0, Math.min(window.innerWidth, targetCursorX));
  targetCursorY = Math.max(0, Math.min(window.innerHeight, targetCursorY));

  const dx = thumb.x - index.x;
  const dy = thumb.y - index.y;
  isPinching = Math.sqrt(dx*dx + dy*dy) < PINCH_THRESHOLD;
  airMouseTargetActive = true;
}

/* Runs every rAF tick (independent of camera frame rate) so the cursor glides smoothly
   toward the latest target instead of jumping once per camera frame. */
function renderAirMouse(dt){
  if(!airMouseTargetActive) return;
  const a = smoothingAlpha(CURSOR_SMOOTH, dt);
  cursorX += (targetCursorX - cursorX) * a;
  cursorY += (targetCursorY - cursorY) * a;

  airCursor.style.left = cursorX + 'px';
  airCursor.style.top = cursorY + 'px';
  airCursor.classList.toggle('p7-pinching', isPinching);

  pinchEl = document.elementFromPoint(cursorX, cursorY);

  if(!wasPinching && isPinching){
    if(pinchEl) dispatchMouse(pinchEl, 'mousedown', cursorX, cursorY);
  }else if(wasPinching && !isPinching){
    if(lastPinchEl){
      dispatchMouse(lastPinchEl, 'mouseup', cursorX, cursorY);
      dispatchMouse(lastPinchEl, 'click', cursorX, cursorY);
    }
  }else{
    if(pinchEl) dispatchMouse(pinchEl, 'mousemove', cursorX, cursorY);
  }

  lastPinchEl = pinchEl;
  wasPinching = isPinching;
}

/* ================= RENDERING ================= */

function toPx(lm){
  return { x: coverT.ox + lm.x*coverT.rw, y: coverT.oy + lm.y*coverT.rh };
}
/* Mirrored, viewport-local coordinates — for DOM elements placed over the (CSS-mirrored) feed. */
function toDisplayPx(lm){
  return { x: coverT.cw - (coverT.ox + lm.x*coverT.rw), y: coverT.oy + lm.y*coverT.rh };
}

/* ================= AR TEMPLATES ================= */
/* A template dragged into the camera feed anchors to the tracked hand, like an AR sticker.
   Dragged outside the feed, it becomes a normal floating widget anywhere on the page. */
let showTemplates = true;
const toggleTemplate = document.getElementById('p7-toggleTemplate');
const templateChips = document.querySelectorAll('.p7-template-chip');
let templateInstances = [];
let tplIdCounter = 0;
let currentAnchor = null; // viewport-local {x,y}, mirrored — TARGET, updated each camera frame a hand is seen
let renderAnchor = null;  // viewport-local {x,y} — smoothed toward currentAnchor every rAF tick
let grabbedTemplate = null;
let wasPinchingTemplate = false;
let grabTargetX = null, grabTargetY = null;   // latest pinch midpoint while dragging (TARGET, per camera frame)
let grabRenderX = null, grabRenderY = null;   // smoothed drag position, updated every rAF tick
const GRAB_RADIUS = 46; // px — how close a pinch must start to a template to grab it

toggleTemplate.addEventListener('click', ()=>{
  showTemplates = !showTemplates;
  toggleTemplate.classList.toggle('active', showTemplates);
  templateInstances.forEach(inst => inst.el.classList.toggle('p7-hidden-layer', !showTemplates));
});

function isInsideViewport(clientX, clientY){
  const r = viewport.getBoundingClientRect();
  return clientX >= r.left && clientX <= r.right && clientY >= r.top && clientY <= r.bottom;
}
function setModeClasses(inst){
  inst.el.classList.toggle('p7-mode-ar', inst.mode === 'ar');
  inst.el.classList.toggle('p7-mode-free', inst.mode === 'free');
}
function placeInstance(inst, clientX, clientY){
  if(isInsideViewport(clientX, clientY)){
    inst.mode = 'ar';
    setModeClasses(inst);
    const r = viewport.getBoundingClientRect();
    const localX = clientX - r.left, localY = clientY - r.top;
    if(currentAnchor){
      inst.offsetX = localX - currentAnchor.x;
      inst.offsetY = localY - currentAnchor.y;
    }
  }else{
    inst.mode = 'free';
    setModeClasses(inst);
  }
  inst.el.style.left = clientX + 'px';
  inst.el.style.top = clientY + 'px';
}
function createTemplateInstance(symbol, clientX, clientY){
  const el = document.createElement('div');
  el.className = 'p7-ar-template';
  el.textContent = symbol;
  el.dataset.id = 'tpl-' + (tplIdCounter++);
  if(!showTemplates) el.classList.add('p7-hidden-layer');
  document.body.appendChild(el);
  const inst = { el, mode:'free', offsetX:0, offsetY:0, symbol };
  templateInstances.push(inst);
  placeInstance(inst, clientX, clientY);
  return inst;
}
function wireInstanceDrag(inst){
  let dragging = false;
  inst.el.addEventListener('pointerdown', (e)=>{
    e.stopPropagation();
    dragging = true;
    inst.el.classList.add('p7-dragging');
    inst.el.setPointerCapture(e.pointerId);
  });
  inst.el.addEventListener('pointermove', (e)=>{
    if(!dragging) return;
    placeInstance(inst, e.clientX, e.clientY);
  });
  function endDrag(){
    if(!dragging) return;
    dragging = false;
    inst.el.classList.remove('p7-dragging');
  }
  inst.el.addEventListener('pointerup', endDrag);
  inst.el.addEventListener('pointercancel', endDrag);
  inst.el.addEventListener('dblclick', (e)=>{
    e.stopPropagation();
    inst.el.remove();
    templateInstances = templateInstances.filter(i => i !== inst);
  });
}
templateChips.forEach(chip => {
  chip.addEventListener('pointerdown', (e)=>{
    e.preventDefault();
    e.stopPropagation();
    const symbol = chip.dataset.symbol;
    const inst = createTemplateInstance(symbol, e.clientX, e.clientY);
    inst.el.classList.add('p7-dragging');
    function onMove(ev){ placeInstance(inst, ev.clientX, ev.clientY); }
    function onUp(ev){
      placeInstance(inst, ev.clientX, ev.clientY);
      inst.el.classList.remove('p7-dragging');
      window.removeEventListener('pointermove', onMove);
      window.removeEventListener('pointerup', onUp);
      wireInstanceDrag(inst);
    }
    window.addEventListener('pointermove', onMove);
    window.addEventListener('pointerup', onUp);
  });
});
function updateArTemplates(dt){
  if(!currentAnchor) return;
  if(!renderAnchor) renderAnchor = { x: currentAnchor.x, y: currentAnchor.y };
  const a = smoothingAlpha(CURSOR_SMOOTH, dt);
  renderAnchor.x += (currentAnchor.x - renderAnchor.x) * a;
  renderAnchor.y += (currentAnchor.y - renderAnchor.y) * a;
  if(!templateInstances.length) return;
  const r = viewport.getBoundingClientRect();
  templateInstances.forEach(inst => {
    if(inst.mode !== 'ar' || inst === grabbedTemplate) return;
    inst.el.style.left = (r.left + renderAnchor.x + inst.offsetX) + 'px';
    inst.el.style.top = (r.top + renderAnchor.y + inst.offsetY) + 'px';
  });
}
function releaseGrabbedTemplate(){
  if(grabbedTemplate){
    grabbedTemplate.el.classList.remove('p7-dragging');
    grabbedTemplate = null;
  }
  grabTargetX = null; grabTargetY = null;
  grabRenderX = null; grabRenderY = null;
}
/* Runs every rAF tick: smoothly moves the currently-grabbed template toward the latest
   pinch midpoint, instead of snapping to it once per camera frame. */
function renderGrabbedTemplateFollow(dt){
  if(!grabbedTemplate || grabTargetX === null) return;
  if(grabRenderX === null){ grabRenderX = grabTargetX; grabRenderY = grabTargetY; }
  const a = smoothingAlpha(CURSOR_SMOOTH, dt);
  grabRenderX += (grabTargetX - grabRenderX) * a;
  grabRenderY += (grabTargetY - grabRenderY) * a;
  grabbedTemplate.el.style.left = grabRenderX + 'px';
  grabbedTemplate.el.style.top = grabRenderY + 'px';
}
/* Pinch (thumb+index) near a placed AR template grabs it; holding the pinch drags it
   with your hand; opening your fingers drops it wherever the pinch was released. */
function updateTemplatePinchDrag(index, thumb){
  if(!index || !thumb || !coverT){
    releaseGrabbedTemplate();
    wasPinchingTemplate = false;
    return;
  }
  const dx = thumb.x - index.x, dy = thumb.y - index.y;
  const pinchingNow = Math.sqrt(dx*dx + dy*dy) < PINCH_THRESHOLD;

  const midNorm = { x:(thumb.x+index.x)/2, y:(thumb.y+index.y)/2 };
  const midLocal = toDisplayPx(midNorm);
  const r = viewport.getBoundingClientRect();
  const midClientX = r.left + midLocal.x;
  const midClientY = r.top + midLocal.y;

  if(pinchingNow && !wasPinchingTemplate){
    let nearest = null, nearestDist = GRAB_RADIUS;
    templateInstances.forEach(inst => {
      if(inst.mode !== 'ar') return;
      const rect = inst.el.getBoundingClientRect();
      const d = Math.hypot((rect.left+rect.width/2) - midClientX, (rect.top+rect.height/2) - midClientY);
      if(d < nearestDist){ nearestDist = d; nearest = inst; }
    });
    if(nearest){
      grabbedTemplate = nearest;
      grabbedTemplate.el.classList.add('p7-dragging');
      // Start the render position at the grab point itself, not the template's old resting spot —
      // avoids a visible snap/jump at the instant of grabbing.
      grabRenderX = midClientX; grabRenderY = midClientY;
      grabTargetX = midClientX; grabTargetY = midClientY;
    }
  }else if(pinchingNow && grabbedTemplate){
    grabTargetX = midClientX;
    grabTargetY = midClientY;
  }else if(!pinchingNow && wasPinchingTemplate && grabbedTemplate){
    placeInstance(grabbedTemplate, midClientX, midClientY);
    releaseGrabbedTemplate();
  }
  wasPinchingTemplate = pinchingNow;
}
function drawHand(landmarks, drawPinch=false){
  ctx.save();
  ctx.strokeStyle = 'rgba(18,144,255,0.85)';
  ctx.fillStyle = '#1290ff';
  ctx.lineWidth = 1.4;
  ctx.shadowColor = '#1290ff';
  ctx.shadowBlur = 6;
  ctx.beginPath();
  for(const [a,b] of HAND_CONNECTIONS){
    const p1 = toPx(landmarks[a]), p2 = toPx(landmarks[b]);
    ctx.moveTo(p1.x, p1.y);
    ctx.lineTo(p2.x, p2.y);
  }
  ctx.stroke();
  landmarks.forEach((lm,i)=>{
    const p = toPx(lm);
    const r = i===0 ? 4 : 2.4;
    ctx.beginPath();
    ctx.rect(p.x-r, p.y-r, r*2, r*2);
    ctx.fill();
  });

  if(drawPinch && mouseMode){
    const t = toPx(landmarks[4]);
    const i = toPx(landmarks[8]);
    ctx.strokeStyle = isPinching ? 'rgba(18,144,255,0.9)' : 'rgba(18,144,255,0.25)';
    ctx.lineWidth = isPinching ? 2 : 1;
    ctx.setLineDash(isPinching ? [] : [3,3]);
    ctx.beginPath();
    ctx.moveTo(t.x, t.y);
    ctx.lineTo(i.x, i.y);
    ctx.stroke();
    ctx.setLineDash([]);

    const mx = (t.x+i.x)/2, my = (t.y+i.y)/2;
    ctx.fillStyle = isPinching ? '#1290ff' : 'rgba(18,144,255,0.3)';
    ctx.beginPath();
    ctx.arc(mx, my, isPinching ? 5 : 3, 0, Math.PI*2);
    ctx.fill();
  }
  ctx.restore();
}
function drawFaceMesh(landmarks, connections){
  ctx.save();
  ctx.strokeStyle = 'rgba(18,144,255,0.4)';
  ctx.lineWidth = 0.6;
  ctx.beginPath();
  for(const c of connections){
    const p1 = toPx(landmarks[c.start]), p2 = toPx(landmarks[c.end]);
    ctx.moveTo(p1.x, p1.y);
    ctx.lineTo(p2.x, p2.y);
  }
  ctx.stroke();
  ctx.restore();
}

function renderLoop(){
  if(!running) return;
  const now = performance.now();
  const dt = lastTickTime !== null ? Math.min(now - lastTickTime, 100) : 16.67; // cap dt to avoid a huge jump after a tab was backgrounded
  lastTickTime = now;

  // Auto-resize canvas if viewport dimensions changed (e.g. during fullscreen transition)
  if(coverT){
    const rect = viewport.getBoundingClientRect();
    if(Math.abs(rect.width - coverT.cw) > 2 || Math.abs(rect.height - coverT.ch) > 2){
      sizeCanvasToContainer();
    }
  }

  if(video.currentTime !== lastTime && coverT){
    lastTime = video.currentTime;
    const dpr = coverT.dpr || 1;
    ctx.setTransform(dpr,0,0,dpr,0,0);
    ctx.clearRect(0,0,coverT.cw,coverT.ch);

    const timestamp = now;
    let handRes, faceRes;
    try{
      handRes = handLandmarker.detectForVideo(video, timestamp);
      faceRes = faceLandmarker.detectForVideo(video, timestamp);
    }catch(err){
      console.error('Detection error, skipping frame:', err);
      rafId = requestAnimationFrame(renderLoop);
      return;
    }

    const nHands = handRes.landmarks ? handRes.landmarks.length : 0;
    const nFaces = faceRes.faceLandmarks ? faceRes.faceLandmarks.length : 0;
    handsVal.textContent = nHands;
    facesVal.textContent = nFaces;
    lastCounts.hands = nHands;
    lastCounts.faces = nFaces;

    let filteredIndex = null, filteredThumb = null;
    if(nHands === 0){
      resetTrackingFilters();
    }else{
      const rawIndex = handRes.landmarks[0][8];
      const rawThumb = handRes.landmarks[0][4];
      filteredIndex = { x: filters.indexX.filter(rawIndex.x, now), y: filters.indexY.filter(rawIndex.y, now) };
      filteredThumb = { x: filters.thumbX.filter(rawThumb.x, now), y: filters.thumbY.filter(rawThumb.y, now) };
      if(coverT){
        const rawAnchor = handRes.landmarks[0][9]; // middle-finger MCP: stable palm-center point
        const fx = filters.anchorX.filter(rawAnchor.x, now);
        const fy = filters.anchorY.filter(rawAnchor.y, now);
        currentAnchor = toDisplayPx({ x: fx, y: fy });
      }
    }
    updateTemplatePinchDrag(filteredIndex, filteredThumb);

    /* ---- AUTHENTICATION GATE ---- */
    let authorized = true;
    if(masterFace){
      if(nFaces > 0){
        const currentNorm = normalizeLandmarks(faceRes.faceLandmarks[0]);
        const masterNorm = masterFace.landmarks.map(p => ({x:p[0], y:p[1], z:p[2]}));
        const dist = compareFaceMeshes(currentNorm, masterNorm);
        if(dist < 0.18){
          authMatchStreak++; authMismatchStreak = 0;
          if(authState !== 'UNLOCKED' && authMatchStreak >= AUTH_STREAK_REQUIRED) setAuthState('UNLOCKED');
        }else{
          authMismatchStreak++; authMatchStreak = 0;
          if(authState !== 'DENIED' && authMismatchStreak >= AUTH_STREAK_REQUIRED) setAuthState('DENIED');
        }
        authorized = (authState === 'UNLOCKED');
      }else{
        authMatchStreak = 0; authMismatchStreak = 0;
        if(authState !== 'SCANNING' && authState !== 'DENIED') setAuthState('SCANNING');
        authorized = (authState === 'UNLOCKED');
      }
    }else{
      if(authState !== 'NONE') setAuthState('NONE');
      authorized = true;
    }

    if(authorized){
      if(showFace && nFaces > 0){
        const conns = FaceLandmarker.FACE_LANDMARKS_TESSELATION;
        faceRes.faceLandmarks.forEach(lm => drawFaceMesh(lm, conns));
      }
      if(showHand && nHands > 0){
        handRes.landmarks.forEach((lm, idx) => drawHand(lm, idx===0));
      }
      if(mouseMode && nHands > 0){
        updateAirMouseTarget(filteredIndex, filteredThumb);
      }else if(mouseMode){
        airMouseTargetActive = false;
        if(wasPinching && lastPinchEl){
          dispatchMouse(lastPinchEl, 'mouseup', cursorX, cursorY);
        }
        isPinching = false; wasPinching = false;
        airCursor.classList.remove('p7-pinching');
      }
    }else{
      airMouseTargetActive = false;
      if(mouseMode && wasPinching && lastPinchEl){
        dispatchMouse(lastPinchEl, 'mouseup', cursorX, cursorY);
        isPinching = false; wasPinching = false;
        airCursor.classList.remove('p7-pinching');
      }
    }

    frameCount++;
    if(now - fpsWindowStart >= 500){
      const fps = Math.round((frameCount*1000)/(now-fpsWindowStart));
      fpsVal.textContent = fps;
      lastCounts.fps = fps;
      frameCount = 0;
      fpsWindowStart = now;
    }
  }

  /* ---- Smooth interpolation: runs every rAF tick, independent of camera frame rate ---- */
  updateArTemplates(dt);
  renderGrabbedTemplateFollow(dt);
  if(mouseMode) renderAirMouse(dt);

  rafId = requestAnimationFrame(renderLoop);
}

