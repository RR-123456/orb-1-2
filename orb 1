/* ================= PRECISION FILTERING ================= */
/* One-Euro filter: cuts jitter on slow movement while staying responsive on fast movement,
   which is what makes the tracked point feel accurate instead of shaky. */
class OneEuroFilter{
  constructor(){ this.xPrev=null; this.dxPrev=0; this.tPrev=null; }
  alpha(cutoff, te){ const tau = 1/(2*Math.PI*cutoff); return 1/(1+tau/te); }
  filter(x, t){
    if(this.tPrev===null){ this.tPrev=t; this.xPrev=x; this.dxPrev=0; return x; }
    const te = Math.max((t-this.tPrev)/1000, 1/120);
    const dx = (x-this.xPrev)/te;
    const aD = this.alpha(1.0, te);
    const dxHat = aD*dx + (1-aD)*this.dxPrev;
    const cutoff = FILTER_MINCUTOFF + FILTER_BETA*Math.abs(dxHat);
    const a = this.alpha(cutoff, te);
    const xHat = a*x + (1-a)*this.xPrev;
    this.xPrev = xHat; this.dxPrev = dxHat; this.tPrev = t;
    return xHat;
  }
  reset(){ this.xPrev=null; this.dxPrev=0; this.tPrev=null; }
}
const filters = {
  indexX: new OneEuroFilter(), indexY: new OneEuroFilter(),
  thumbX: new OneEuroFilter(), thumbY: new OneEuroFilter(),
  anchorX: new OneEuroFilter(), anchorY: new OneEuroFilter()
};
function resetTrackingFilters(){
