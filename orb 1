.ksx-row{display:flex;align-items:center;gap:10px;padding:9px 12px;border:1px solid rgba(18,144,255,.15);border-radius:4px;margin-bottom:6px;background:rgba(18,144,255,.03)}
.ksx-row .ksx-n{flex:1;font-size:12px;color:var(--cyan);letter-spacing:1px;word-break:break-word}
.ksx-row .ksx-k{font-size:11px;color:rgba(18,144,255,.7);letter-spacing:1px}
.ksx-row .ksx-d{font-size:9px;color:rgba(18,144,255,.4)}
.ksx-empty{font-size:11px;color:rgba(18,144,255,.4);padding:14px 0}
#compass-overlay{position:fixed;inset:0;z-index:60;display:none;flex-direction:column;background:rgba(0,0,0,.92);backdrop-filter:blur(10px)}
#compass-overlay.open{display:flex}
#compass-overlay-bar{display:flex;align-items:center;justify-content:space-between;padding:10px 16px;border-bottom:1px solid var(--border);background:rgba(0,0,0,.9);flex-shrink:0}
