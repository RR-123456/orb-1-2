#demospin{position:fixed;bottom:92px;left:50%;transform:translateX(-50%);z-index:25;padding:7px 16px;font:600 10.5px/1 inherit;letter-spacing:2px;text-transform:uppercase;color:rgba(200,225,255,.9);background:rgba(18,40,80,.55);border:1px solid rgba(80,150,255,.45);border-radius:999px;cursor:pointer;backdrop-filter:blur(6px);transition:background .2s,border-color .2s}
