<script>(function(){var b=document.getElementById('orb-pause');if(!b)return;b.addEventListener('click',function(){try{var o=document.getElementById('orb-ui').contentWindow.orb;var p=o.pause();b.classList.toggle('paused',!!p);b.setAttribute('aria-pressed',!!p);b.setAttribute('aria-label',p?'Resume orb':'Pause orb')}catch(e){}})})();</script>
