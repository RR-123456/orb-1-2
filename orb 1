function kwRender(){
  const el=document.getElementById('kw-list');if(!el)return;
  const list=kwGetAll();
  if(!list.length){el.innerHTML='<div style="text-align:center;padding:16px;color:rgba(18,144,255,.2);font-size:8px;letter-spacing:2px">No keywords yet.</div>';return;}
  el.innerHTML=list.map((item,i)=>`<div style="padding:7px 9px;border:1px solid var(--border);border-radius:2px;margin-bottom:6px">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:6px">
