let pendingAttachment=null;
const TEXTY_EXT=['py','html','htm','js','jsx','ts','tsx','css','txt','md','json','xml','csv','yaml','yml','sh','c','cpp','h','java','go','rs','rb','php','sql','ini','conf','log','doc','docx','pdf','zip','rar','7z','tar','gz','bz2','xls','xlsx','ppt','pptx'];
const BINARY_EXT=['doc','docx','pdf','zip','rar','7z','tar','gz','bz2','xls','xlsx','ppt','pptx'];
const IMAGE_EXT=['png','jpg','jpeg','gif','webp','bmp','svg'];
function readFileAsTextP(file){return new Promise((res,rej)=>{const r=new FileReader();r.onload=()=>res(r.result);r.onerror=rej;r.readAsText(file);});}
function readFileAsDataURLP(file){return new Promise((res,rej)=>{const r=new FileReader();r.onload=()=>res(r.result);r.onerror=rej;r.readAsDataURL(file);});}
async function handleChatFile(file){
  if(!file)return;
  const ext=(file.name.split('.').pop()||'file').toLowerCase();
  const sizeKB=Math.round(file.size/1024);
  const isText=TEXTY_EXT.includes(ext) && !BINARY_EXT.includes(ext);
  const isImage=IMAGE_EXT.includes(ext);
  try{
    if(isImage){
      const data=await readFileAsDataURLP(file);
      pendingAttachment={name:file.name,ext,isText:false,type:'image',data:data};
    }else if(isText){
      const text=await readFileAsTextP(file);
      pendingAttachment={name:file.name,ext,isText:true,type:'text',content:text};
    }else{
      pendingAttachment={name:file.name,ext,isText:false,type:'binary',size:file.size,content:`[Binary file: ${file.name}]
Type: ${file.type||'Unknown'}
Size: ${sizeKB} KB`};
      const form=new FormData();
      form.append('file',file);
      form.append('filename',file.name);
      try{
        const r=await fetch('/api/upload',{method:'POST',body:form});
        const j=await r.json();
        if(j.ok){
          pendingAttachment.url=j.path;
          pendingAttachment.saved=j.saved_as;
          toast('UPLOADED: '+j.filename);
        }else{
          toast('UPLOAD FAILED');
        }
      }catch(err){
        toast('UPLOAD ERROR: '+err.message);
      }
    }
    renderAttachChip();
  }catch(e){
    toast('Could not read file: '+e.message);
  }
  $('chatFileInput').value='';
}
function renderAttachChip(){
  const row=$('attach-chip-row');
  if(!pendingAttachment){row.classList.remove('show');row.innerHTML='';return;}
  let inner=`<button class="ac-x" onclick="clearAttachment()">&times;</button><div class="ac-name">${escH(pendingAttachment.name)}</div><div class="ac-ext">${escH((pendingAttachment.ext||'file').toUpperCase())}</div>`;
  if(pendingAttachment.type==='image'){
    inner+=`<img src="${pendingAttachment.data}" style="max-height:48px;max-width:100%;margin-top:4px;border:1px solid var(--border);border-radius:2px;display:block;">`;
  }else if(pendingAttachment.type==='binary'){
