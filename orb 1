let activeFloat = null;
const camFloatBtn = document.getElementById('p7-camFloatBtn');

async function floatCamera(){
  if(!('documentPictureInPicture' in window)){
    alert('Document Picture-in-Picture is not supported in this browser. Try Chrome 116+ or Edge 116+.');
    return;
  }
  if(activeFloat){
    activeFloat.win.close();
    return;
  }
  if(camModule.classList.contains('p7-fullscreen')){
    exitFullscreen();
  }
  const bodyEl = document.getElementById('p7-camBody');
  try{
    const pipWindow = await documentPictureInPicture.requestWindow({ width: 400, height: 640 });

    const styles = [...document.styleSheets].map(sheet => {
      try{ return [...sheet.cssRules].map(r => r.cssText).join(''); } catch(e){ return ''; }
    }).join('');
    const styleEl = pipWindow.document.createElement('style');
    styleEl.textContent = styles + `
      html,body{height:100%;margin:0;background:var(--ink);overflow:hidden;}
      .pip-root{height:100%;display:flex;flex-direction:column;background:var(--card);}
      .pip-root .p7-mod-header{cursor:default;flex-shrink:0;}
      .pip-body-slot{flex:1 1 auto;min-height:0;display:flex;flex-direction:column;overflow:hidden;}
      .pip-body-slot .mod-body{max-height:none;}
    `;
    pipWindow.document.head.appendChild(styleEl);

    const root = pipWindow.document.createElement('div');
    root.className = 'pip-root';
    root.innerHTML = `
      <div class="p7-mod-header">
        <div class="p7-brand">
          <div class="p7-brand-mark"></div>
          <div class="p7-brand-text"><h1>CAMERA MODULE</h1><p>MODULE-7 &middot; OPTICAL TRACKING</p></div>
        </div>
      </div>
      <div class="pip-body-slot"></div>`;
    pipWindow.document.body.appendChild(root);

    const placeholder = document.createElement('div');
    placeholder.style.display = 'none';
    bodyEl.parentNode.insertBefore(placeholder, bodyEl);
    root.querySelector('.pip-body-slot').appendChild(bodyEl);

    camFloatBtn.classList.add('active');
    fsBtn.disabled = true;
    if(running) requestAnimationFrame(()=> sizeCanvasToContainer());

    activeFloat = { win: pipWindow, placeholder, bodyEl };

    pipWindow.addEventListener('pagehide', () => {
      placeholder.parentNode.insertBefore(bodyEl, placeholder.nextSibling);
      placeholder.remove();
      camFloatBtn.classList.remove('active');
      fsBtn.disabled = false;
      activeFloat = null;
      if(running) requestAnimationFrame(()=> sizeCanvasToContainer());
    });
  }catch(err){
    console.error('PiP error:', err);
  }
}

camFloatBtn.addEventListener('click', (e)=>{ e.stopPropagation(); floatCamera(); });

/* ================= CAMERA BACKGROUND MODE =================
   When the feed is live, the viewport (video + tracking overlay) is lifted out of the panel into #p7-bgcam, a full-screen layer under the orb.
   Its edges fade out (vignette) and the orb thins its background dots to match (orb.setCamera, via postMessage). It drops back into the panel
   for anything that needs it in there: fullscreen, picture-in-picture float, the ACCESS DENIED overlay, or when the camera stops. */
const BG_AUTOSTART = true;   // opening Camera from the orb menu also starts the feed (false = wait for ACTIVATE MODULE)
const bgCam = document.getElementById('p7-bgcam');
const bgFrame = document.getElementById('p7-bgframe');
const orbFrame = document.getElementById('orb-ui');
const vpHome = viewport.parentNode;
let bgOn = false, bgCloseT = null;

function bgGeom(){
  const s = Math.min(window.innerWidth, window.innerHeight);
  return { m: Math.round(s*0.05), f: Math.round(s*0.16) };   // inset from the screen edge, vignette width
}
function bgSend(on){
  const g = bgGeom();
  bgCam.style.setProperty('--bgm', g.m+'px');
  bgCam.style.setProperty('--bgf', g.f+'px');
  try{ orbFrame.contentWindow.postMessage({ pragonCmd:'camvig', on, m:g.m, f:g.f }, '*'); }catch(e){}
}
function bgWanted(){
  const c = camModule.classList;
  // starting = ACTIVATE pressed / auto-start in progress (button disabled while models load), so the open animation can begin right away
  return (running || startBtn.disabled) && !c.contains('p7-hidden') && !c.contains('p7-denied') && !c.contains('p7-fullscreen') && !activeFloat;
}
let bgCollapsedByUs = false;
function bgEnter(){
  if(bgOn) return;
  bgOn = true;
  clearTimeout(bgCloseT);
  camModule.classList.add('p7-bgmode');
  if(!camModule.classList.contains('p7-collapsed')){ camModule.classList.add('p7-collapsed'); bgCollapsedByUs = true; }   // title bar only, like the reference video; click it to expand
  document.body.classList.add('p7-bgon');
  bgCam.classList.add('p7-on');
  orbFrame.style.background = 'transparent';   // let the layer underneath show through the orb document
  orbFrame.style.colorScheme = 'dark';          // must match the orb document's color-scheme, or browsers force an opaque backdrop behind the iframe
  bgSend(true);
}
function bgAttach(){
  // feed is live: lift the viewport into the background layer and fade it in
  if(viewport.parentNode === bgFrame) return;
  bgFrame.appendChild(viewport);
  if(video.paused) video.play().catch(()=>{});  // re-parenting pauses media elements
  requestAnimationFrame(()=>{
    sizeCanvasToContainer();
    requestAnimationFrame(()=>{ sizeCanvasToContainer(); bgCam.classList.add('p7-open'); });
  });
}
function bgLeave(instant){
  if(!bgOn) return;
  bgOn = false;
  bgCam.classList.remove('p7-open');
  bgSend(false);
  const done = ()=>{
    if(bgOn) return;
    if(viewport.parentNode !== vpHome) vpHome.appendChild(viewport);
    camModule.classList.remove('p7-bgmode');
    if(bgCollapsedByUs){ camModule.classList.remove('p7-collapsed'); bgCollapsedByUs = false; }
    document.body.classList.remove('p7-bgon');
    bgCam.classList.remove('p7-on');
    orbFrame.style.background = '';
    orbFrame.style.colorScheme = '';
    if(running && video.paused) video.play().catch(()=>{});
    requestAnimationFrame(()=> sizeCanvasToContainer());
  };
  clearTimeout(bgCloseT);
  if(instant) done(); else bgCloseT = setTimeout(done, 1300);
}
function bgSync(){
  const want = bgWanted();
  if(want && !bgOn) bgEnter();
  else if(!want && bgOn){
    const c = camModule.classList;
    bgLeave(c.contains('p7-fullscreen') || c.contains('p7-denied') || !!activeFloat);
  }
  if(bgOn && running && viewport.parentNode !== bgFrame) bgAttach();
}
let bgWasHidden = camModule.classList.contains('p7-hidden');
new MutationObserver(()=>{
  const hidden = camModule.classList.contains('p7-hidden');
  if(bgWasHidden && !hidden && BG_AUTOSTART && !running && !startBtn.disabled) startBtn.click();
  bgWasHidden = hidden;
  bgSync();
}).observe(camModule, { attributes:true, attributeFilter:['class'] });
video.addEventListener('playing', ()=> setTimeout(bgSync, 40));   // hand off as soon as the first frame plays
setInterval(bgSync, 100);   // picks up `running` / float changes, which have no class to observe
window.addEventListener('resize', ()=>{ if(bgOn) bgSend(true); });
startBtn.addEventListener('click', ()=> setTimeout(bgSync, 0));
</script>

<script>
/* ══════ P.R.A.G.O.N MODULE-7 : CHAT LOGIC ══════ */
(function(){
const messagesScroll = document.getElementById('p7-messagesScroll');
const msgEmpty = document.getElementById('p7-msgEmpty');
const chatInput = document.getElementById('p7-chatInput');
const sendBtn = document.getElementById('p7-sendBtn');
const chipRow = document.getElementById('p7-chipRow');
const chipRowWrap = document.getElementById('p7-chipRowWrap');
const chipHideBtn = document.getElementById('p7-chipHideBtn');
const chipShowBtn = document.getElementById('p7-chipShowBtn');

let isProcessing = false;

const screenReadBtn = document.getElementById('p7-screenReadBtn');
const screenReadBtnInline = document.getElementById('p7-screenReadBtnInline');
const screenAttachTag = document.getElementById('p7-screenAttachTag');
const screenClearBtn = document.getElementById('p7-screenClearBtn');

function copyChat(){
  const lines = Array.from(document.querySelectorAll('#p7-messagesScroll .p7msg'))
    .map(m => (m.classList.contains('p7-user') ? 'YOU: ' : 'MODULE-7: ') + m.textContent.trim());
  navigator.clipboard?.writeText(lines.join('\n')).catch(()=>{});
}
document.getElementById('p7-chatCopyBtn').addEventListener('click', (e)=>{
  e.stopPropagation();
  copyChat();
  e.currentTarget.style.color = '#1290ff';
  setTimeout(()=> e.currentTarget.style.color = '', 700);
});

chipHideBtn.addEventListener('click', ()=>{
  chipRowWrap.classList.add('p7-hidden');
  chipShowBtn.classList.remove('p7-hidden');
});
chipShowBtn.addEventListener('click', ()=>{
  chipRowWrap.classList.remove('p7-hidden');
  chipShowBtn.classList.add('p7-hidden');
});

const modeTrigger = document.getElementById('p7-modeTrigger');
const modeMenu = document.getElementById('p7-modeMenu');
const modeLabel = document.getElementById('p7-modeLabel');
const attachTag = document.getElementById('p7-attachTag');

let mode = 'Quick';
const URL_RE = /https?:\/\/[^\s]+/i;

[modeTrigger, chatInput, sendBtn, chipRow, screenReadBtn, screenReadBtnInline, screenClearBtn].forEach(el=>{
  el.addEventListener('click', e=> e.stopPropagation());
});

modeTrigger.addEventListener('click', ()=> modeMenu.classList.toggle('p7-open'));
document.addEventListener('click', ()=> modeMenu.classList.remove('p7-open'));
modeMenu.querySelectorAll('.p7-dropdown-item').forEach(item=>{
  item.addEventListener('click', ()=>{
    mode = item.dataset.mode;
    modeLabel.textContent = mode;
    modeMenu.querySelectorAll('.p7-dropdown-item').forEach(i=>i.classList.remove('p7-selected'));
    item.classList.add('p7-selected');
  });
});

function addMessage(text, who){
  msgEmpty?.remove();
  const div = document.createElement('div');
  div.className = 'p7msg ' + who;
  div.textContent = text;
  messagesScroll.appendChild(div);
  messagesScroll.scrollTop = messagesScroll.scrollHeight;
  return div;
}

async function callJarvisChat(userText){
  // Reuses PRAGON's own Jarvis key + model ( Engine API Key / Chat Model)
  // and its shared request helper, so this widget always talks to the same
  // Jarvis backend/account as the rest of the app.
  const sys = mode === 'Quick'
    ? "You are a helpful assistant embedded in a small chat widget. Answer in one short sentence, plain text, no markdown."
    : "You are a helpful assistant embedded in a small chat widget. Answer helpfully in 2-4 short sentences, plain text, no markdown.";
  const note = URL_RE.test(userText)
    ? "\n\n(The user pasted a link. You cannot browse it — answer from what they've written, and if you need the page contents, say so.)"
    : "";
  return await callSharedJarvis([{ role:'user', content:userText }], sys + note, 512);
}

async function callJarvisVision(userText, image){
  // Same PRAGON Jarvis key/model as callJarvisChat, but sends the screenshot
  // as an inline image part alongside the question (callSharedJarvis is
  // text-only and shared with FORGE, so this builds its own request body).
  const key = getKey();
  if(!key) throw new Error('Jarvis API Key missing — paste it in Engine');
  const gm = getModel();
  const sys = (mode === 'Quick'
    ? "You are a helpful assistant embedded in a small chat widget. Answer in one short sentence, plain text, no markdown."
    : "You are a helpful assistant embedded in a small chat widget. Answer helpfully in 2-4 short sentences, plain text, no markdown.")
    + " The user has attached a screenshot of their tab/screen. Look at it carefully — read any visible text, UI, code, or images — and answer based on what's actually shown.";

  const body = {
    contents: [{
      role: 'user',
      parts: [
        { inline_data: { mime_type: image.mediaType, data: image.data } },
        { text: userText }
      ]
    }],
    generationConfig: { maxOutputTokens: 512, temperature: 0.4 },
    systemInstruction: { parts: [{ text: sys }] }
  };

  const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${gm}:generateContent?key=${key}`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body)
  });
  if(!res.ok){
    const e = await res.json().catch(()=>({}));
    throw new Error(e?.error?.message || 'HTTP ' + res.status);
  }
  const data = await res.json();
  return data?.candidates?.[0]?.content?.parts?.[0]?.text || 'No response.';
}

/* ── SCREEN READ (auto-scroll capture) ── */
let pendingScreenshot = null; // { data, mediaType }

function clearScreenshot(){
  pendingScreenshot = null;
  screenAttachTag.style.display = 'none';
  screenReadBtn.classList.remove('active');
  screenReadBtnInline.classList.remove('active');
}

async function captureScreen(){
  if(!navigator.mediaDevices?.getDisplayMedia){
    addMessage("Screen capture isn't supported in this browser. Try Chrome or Edge.", 'p7-bot');
    return;
  }
  let stream;
  try{
    stream = await navigator.mediaDevices.getDisplayMedia({
      video: { cursor: 'never' },
      // No preferCurrentTab/selfBrowserSurface here on purpose: those bias the
      // picker toward sharing whatever tab this script runs in. Since this is
      // called from the floating PiP chat window, that biased it toward
      // sharing the chatbox itself instead of showing the normal
      // screen/window/tab chooser.
      surfaceSwitching: 'exclude'
    });
  }catch(err){
    // user cancelled the picker — no need to show an error
    return;
  }

  try{
    const video = document.createElement('video');
    video.srcObject = stream;
    video.muted = true;
    await video.play();
    // let one frame render so videoWidth/Height are populated
    await new Promise(r => requestAnimationFrame(r));

    const grabFrame = () => {
      const c = document.createElement('canvas');
      c.width = video.videoWidth;
      c.height = video.videoHeight;
      c.getContext('2d').drawImage(video, 0, 0, c.width, c.height);
      return c;
    };

    // Auto-scroll through the shared tab, grabbing a frame at each step,
    // so the capture covers the whole page — not just what's visible.
    // (Only scrolls this document; if the user shared a different window
    // or their entire screen, we simply grab one frame there instead.)
    const scroller = document.scrollingElement || document.documentElement;
    const startY = scroller.scrollTop;
    const viewportH = window.innerHeight;
    const fullH = scroller.scrollHeight;
    const isTabShare = fullH > viewportH + 4;
    const steps = isTabShare ? Math.min(Math.ceil(fullH / viewportH), 12) : 1;

    if(isTabShare) scroller.scrollTo(0, 0);
    await new Promise(r => setTimeout(r, 220)); // let the share/scroll settle before first grab

    const frames = [];
    for(let i = 0; i < steps; i++){
      await new Promise(r => setTimeout(r, 180)); // let repaint catch up with the scroll
      frames.push(grabFrame());
      if(i < steps - 1) scroller.scrollTo(0, Math.min(fullH, (i + 1) * viewportH));
    }

    if(isTabShare) scroller.scrollTo(0, startY); // put the page back where the user left it

    // stitch every frame into one tall screenshot
    const w = frames[0].width, h = frames[0].height;
    const stitched = document.createElement('canvas');
    stitched.width = w;
    stitched.height = h * frames.length;
    const sctx = stitched.getContext('2d');
    frames.forEach((f, i) => sctx.drawImage(f, 0, i * h));

    const dataUrl = stitched.toDataURL('image/jpeg', 0.78);
    pendingScreenshot = { data: dataUrl.split(',')[1], mediaType: 'image/jpeg' };

    screenAttachTag.style.display = 'block';
    screenReadBtn.classList.add('active');
    screenReadBtnInline.classList.add('active');
    addMessage(
      frames.length > 1
        ? `Got it — scrolled and captured the full page in ${frames.length} sections. What do you want to know?`
        : 'Got it — I can see your screen now. What do you want to know?',
      'p7-bot'
    );
  }catch(err){
    console.error('Screen capture error:', err);
    addMessage("Couldn't capture the screen just now.", 'p7-bot');
  }finally{
    stream.getTracks().forEach(t => t.stop()); // one-shot: stop sharing right after grabbing frames
  }
}

screenReadBtn.addEventListener('click', (e)=>{
  e.stopPropagation();
  captureScreen();
});
screenReadBtnInline.addEventListener('click', (e)=>{
  e.stopPropagation();
  captureScreen();
});
screenClearBtn.addEventListener('click', (e)=>{
  e.stopPropagation();
  clearScreenshot();
});

async function handleSend(text){
  if(!text.trim() || isProcessing) return;

  isProcessing = true;
  addMessage(text, 'p7-user');
  chatInput.value = '';

  const usingImage = pendingScreenshot;
  const thinkingMsg = addMessage(usingImage ? 'looking at your screen…' : 'thinking…', 'p7-bot');
  thinkingMsg.classList.add('p7-thinking');

  if(URL_RE.test(text) && !usingImage){
    attachTag.classList.add('p7-show');
    attachTag.textContent = ' link noted';
  }

  try{
    const answer = usingImage
      ? await callJarvisVision(text, usingImage)
      : await callJarvisChat(text);
    thinkingMsg.textContent = answer;
    thinkingMsg.classList.remove('p7-thinking');
  }catch(e){
    thinkingMsg.textContent = ' ' + (e.message || "Couldn't reach Jarvis just now.");
    thinkingMsg.classList.remove('p7-thinking');
  }finally{
    isProcessing = false;
    attachTag.classList.remove('p7-show');
  }
}

sendBtn.addEventListener('click', ()=> handleSend(chatInput.value));
chatInput.addEventListener('keydown', (e)=>{ if(e.key==='Enter') handleSend(chatInput.value); });
chipRow.addEventListener('click', (e)=>{
  const chip = e.target.closest('.p7-chip');
  if(!chip) return;
  handleSend(chip.textContent);
});

/* ── FLOAT (Picture-in-Picture) ── */
let activeFloat = null;
const chatFloatBtn = document.getElementById('p7-chatFloatBtn');

async function floatChat(){
  if(!('documentPictureInPicture' in window)){
    alert('Document Picture-in-Picture is not supported in this browser. Try Chrome 116+ or Edge 116+.');
    return;
  }
  if(activeFloat){
    activeFloat.win.close();
    return;
  }
  const bodyEl = document.getElementById('p7-chatBody');
  try{
    const pipWindow = await documentPictureInPicture.requestWindow({ width: 400, height: 600 });

    const styles = [...document.styleSheets].map(sheet => {
      try{ return [...sheet.cssRules].map(r => r.cssText).join(''); } catch(e){ return ''; }
    }).join('');
    const styleEl = pipWindow.document.createElement('style');
    styleEl.textContent = styles + `
      html,body{height:100%;margin:0;background:#050508;overflow:hidden;}
      .p7-pip-root{height:100%;display:flex;flex-direction:column;background:#0a0a0f;}
      .p7-pip-root .p7-mod-header{cursor:default;flex-shrink:0;}
      .p7-pip-body-slot{flex:1 1 auto;min-height:0;display:flex;flex-direction:column;overflow:hidden;}
      .p7-pip-body-slot .p7-mod-body{max-height:none;}
    `;
    pipWindow.document.head.appendChild(styleEl);

    const root = pipWindow.document.createElement('div');
    root.className = 'p7-pip-root';
    root.innerHTML = `
      <div class="p7-mod-header">
        <div class="p7-brand">
          <div class="p7-brand-mark"></div>
          <div class="p7-brand-text"><h1>CHAT BOX</h1><p>P.R.A.G.O.N &middot; MODULE-7</p></div>
        </div>
      </div>
      <div class="p7-pip-body-slot"></div>`;
    pipWindow.document.body.appendChild(root);

    const placeholder = document.createElement('div');
    placeholder.style.display = 'none';
    bodyEl.parentNode.insertBefore(placeholder, bodyEl);
    root.querySelector('.p7-pip-body-slot').appendChild(bodyEl);

    chatFloatBtn.classList.add('active');

    activeFloat = { win: pipWindow, placeholder, bodyEl };

    pipWindow.addEventListener('pagehide', () => {
      placeholder.parentNode.insertBefore(bodyEl, placeholder.nextSibling);
      placeholder.remove();
      chatFloatBtn.classList.remove('active');
      activeFloat = null;
    });
  }catch(err){
    console.error('PiP error:', err);
  }
}

chatFloatBtn.addEventListener('click', (e)=>{ e.stopPropagation(); floatChat(); });
})();
</script>

<script>
// ── DRAG & DROP ──
(function(){
  const dropOverlay=document.getElementById('drop-overlay');
  let dragCounter=0;
  ['dragenter','dragover','dragleave','drop'].forEach(evt=>{
    document.body.addEventListener(evt,e=>{e.preventDefault();e.stopPropagation();},false);
  });
  document.body.addEventListener('dragenter',e=>{
    dragCounter++;
    const types=e.dataTransfer.types;
    if(types && (Array.from(types).includes('Files') || (types.contains && types.contains('Files')))){
      dropOverlay.classList.add('active');
    }
  });
  document.body.addEventListener('dragleave',e=>{
    dragCounter--;
    if(dragCounter<=0){
      dropOverlay.classList.remove('active');
      dragCounter=0;
    }
  });
  document.body.addEventListener('drop',e=>{
    dragCounter=0;
    dropOverlay.classList.remove('active');
    const files=e.dataTransfer.files;
    if(!files.length) return;
    for(const file of files){ handleChatFile(file); }
  });
})();
</script>

<script id="pragon-hud-js">
/* ══════ PRAGON HUD WIDGETS: drag, front-on-press, haze glow, Clock, Music Player, Panel Look, Arrange / Close all ══════ */
(function(){
const $=id=>document.getElementById(id);
const panels=()=>Array.from(document.querySelectorAll('.fpanel'));
let zTop=31;

/* press a panel -> bring it to the front */
document.addEventListener('pointerdown',e=>{
  const p=e.target.closest&&e.target.closest('.fpanel');
  if(p&&p.classList.contains('open')){zTop=Math.min(58,zTop+1);p.style.zIndex=zTop;}
},true);

/* drag a panel by its title tab */
document.addEventListener('pointerdown',e=>{
  const h=e.target.closest&&e.target.closest('.fphead');
  if(!h||e.target.closest('button')||innerWidth<=700)return;
  const w=h.parentNode,r=w.getBoundingClientRect(),sx=e.clientX,sy=e.clientY;
  w.style.left=r.left+'px';w.style.top=r.top+'px';w.style.right='auto';w.style.bottom='auto';
  const mv=ev=>{
    const x=Math.max(0,Math.min(innerWidth-w.offsetWidth,r.left+ev.clientX-sx));
    const y=Math.max(0,Math.min(innerHeight-w.offsetHeight,r.top+ev.clientY-sy));
    w.style.left=x+'px';w.style.top=y+'px';};
  const up=()=>{removeEventListener('pointermove',mv);removeEventListener('pointerup',up);removeEventListener('pointercancel',up);};
  addEventListener('pointermove',mv);addEventListener('pointerup',up);addEventListener('pointercancel',up);
  e.preventDefault();
});

/* haze glow: a panel lights up when you press something in it; Voice Shifter follows the voice, Music follows the music */
const gl={};let musLvl=0;
function glow(id,v,d){gl[id]={t0:performance.now(),d:(d||1.2)*1000,v:v||1};}
window.hudGlow=glow;
document.addEventListener('click',e=>{
  const p=e.target.closest&&e.target.closest('.fpanel');
  if(p&&p.id&&e.target.closest('button,label.hbtn')&&!e.target.closest('.fphead'))glow(p.id,.9,1.2);
},true);

/* ── Clock ── */
function clkTick(){const d=new Date(),t=$('hud-time'),dt=$('hud-date');if(!t||!dt)return;
  t.textContent=d.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
  dt.textContent=d.toLocaleDateString([],{weekday:'long',day:'numeric',month:'long'});}
clkTick();setInterval(()=>{if($('clk-panel')&&$('clk-panel').classList.contains('open'))clkTick();},1000);

/* ── Music Player: plays audio files from your computer (nothing is uploaded anywhere) ── */
const M={list:[],i:-1,a:new Audio(),ctx:null,an:null,buf:null,playing:false,sparkle:false};
const bars=$('mus-bars');if(bars)for(let k=0;k<20;k++)bars.appendChild(document.createElement('i'));
const fmt=s=>{s=Math.max(0,Math.floor(s||0));return Math.floor(s/60)+':'+('0'+s%60).slice(-2);};
const orbApi=()=>{try{return $('orb-ui').contentWindow.orb;}catch(e){return null;}};
function musPaint(){
  const t=M.list[M.i];
  $('mus-t').textContent=t?t.name:'No track';
  $('mus-a').textContent=t?(M.i+1)+' of '+M.list.length:'Add songs from your computer to begin';
  $('mus-pt').textContent=fmt(M.a.currentTime);$('mus-dt').textContent=fmt(M.a.duration);
  $('mus-pf').style.width=(M.a.duration?M.a.currentTime/M.a.duration*100:0)+'%';
  $('mus-pp').textContent=M.playing?'⏸':'▶';$('mus-pp').setAttribute('aria-label',M.playing?'Pause':'Play');
  $('mus-list').innerHTML='';
  M.list.forEach((x,k)=>{const d=document.createElement('div');d.className='hud-li'+(k===M.i?' cur':'');
    const n=document.createElement('span');n.textContent=x.name;d.appendChild(n);
    const r=document.createElement('button');r.type='button';r.textContent='×';r.setAttribute('aria-label','Remove');
    r.onclick=ev=>{ev.stopPropagation();musRemove(k);};d.appendChild(r);
    d.onclick=()=>musLoad(k,true);$('mus-list').appendChild(d);});
}
function musGraph(){
  if(M.ctx)return;
  try{M.ctx=new (window.AudioContext||window.webkitAudioContext)();
    const src=M.ctx.createMediaElementSource(M.a);M.an=M.ctx.createAnalyser();M.an.fftSize=128;
    src.connect(M.an);M.an.connect(M.ctx.destination);M.buf=new Uint8Array(M.an.frequencyBinCount);}catch(e){M.ctx=null;}
}
function musLoad(k,go){
  if(k<0||k>=M.list.length)return;
  M.i=k;M.a.src=M.list[k].url;M.a.load();musPaint();
  if(go)musPlay(true);
}
function musPlay(on){
  if(!M.list.length){toast('Add songs first');return;}
  if(M.i<0)M.i=0,M.a.src=M.list[0].url;
  if(on){musGraph();if(M.ctx&&M.ctx.state==='suspended')M.ctx.resume();
    M.a.play().then(()=>{M.playing=true;musPaint();}).catch(()=>{M.playing=false;musPaint();toast('Could not play this file');});}
  else{M.a.pause();M.playing=false;musPaint();}
}
function musSkip(n){if(!M.list.length)return;musLoad((M.i+n+M.list.length)%M.list.length,M.playing||n!==0);}
function musRemove(k){
  const was=k===M.i;try{URL.revokeObjectURL(M.list[k].url);}catch(e){}
  M.list.splice(k,1);
  if(!M.list.length){M.a.pause();M.a.removeAttribute('src');M.i=-1;M.playing=false;}
  else if(was){M.i=Math.min(k,M.list.length-1);musLoad(M.i,M.playing);}
  else if(k<M.i)M.i--;
  musPaint();
}
$('mus-file').onchange=e=>{
  const fs=Array.from(e.target.files||[]).filter(f=>/^audio\//.test(f.type)||/\.(mp3|wav|ogg|m4a|flac|aac|opus)$/i.test(f.name));
  fs.forEach(f=>M.list.push({name:f.name.replace(/\.[^.]+$/,''),url:URL.createObjectURL(f)}));
  e.target.value='';
  if(fs.length&&M.i<0)musLoad(0,false);else musPaint();
};
$('mus-pp').onclick=()=>musPlay(!M.playing);
$('mus-next').onclick=()=>musSkip(1);$('mus-prev').onclick=()=>musSkip(-1);
$('mus-prog').onclick=e=>{const r=e.currentTarget.getBoundingClientRect();if(M.a.duration)M.a.currentTime=(e.clientX-r.left)/r.width*M.a.duration;musPaint();};
$('mus-vol').oninput=e=>{M.a.volume=e.target.value/100;$('mus-vo').textContent=e.target.value;};
M.a.volume=.8;
$('mus-sp').onclick=function(){M.sparkle=!M.sparkle;this.classList.toggle('on',M.sparkle);this.setAttribute('aria-pressed',M.sparkle);const o=orbApi();try{o&&o.setMusicGlow(M.sparkle);}catch(e){}};
M.a.addEventListener('ended',()=>musSkip(1));
M.a.addEventListener('timeupdate',()=>{if($('mus-panel').classList.contains('open')){$('mus-pt').textContent=fmt(M.a.currentTime);$('mus-dt').textContent=fmt(M.a.duration);$('mus-pf').style.width=(M.a.duration?M.a.currentTime/M.a.duration*100:0)+'%';}});
M.a.addEventListener('pause',()=>{if(M.playing&&!M.a.ended){M.playing=false;musPaint();}});
musPaint();

/* ── Panel Look: opacity, blur, haze, colours (saved in this browser) ── */
const LK_KEY='pragon_hud_look',LK_DEF={wa:22,wb:10,hr:100,hs:100,tab:'#1290ff',glass:'#10488c',haze:'#1290ff',text:'#d6e8ff'};
let LK=Object.assign({},LK_DEF);
try{Object.assign(LK,JSON.parse(localStorage.getItem(LK_KEY)||'{}'));}catch(e){}
const rgb=h=>{h=(h||'#000000').replace('#','');if(h.length===3)h=h.replace(/./g,'$&$&');const n=parseInt(h,16)||0;return[n>>16&255,n>>8&255,n&255];};
const hex=a=>'#'+a.map(v=>('0'+Math.round(v).toString(16)).slice(-2)).join('');
const mix=(a,b,t)=>a.map((v,i)=>v+(b[i]-v)*t);
function lkApply(save){
  const r=document.documentElement.style;
  r.setProperty('--wa',(LK.wa/100).toFixed(2));r.setProperty('--wb',LK.wb+'px');
  r.setProperty('--hzr',(LK.hr/100).toFixed(2));r.setProperty('--hzs',(LK.hs/100).toFixed(2));
  r.setProperty('--hz',rgb(LK.haze).join(','));
  r.setProperty('--tab1',LK.tab);r.setProperty('--tab2',hex(mix(rgb(LK.tab),[255,255,255],.45)));
  r.setProperty('--gt',rgb(LK.glass).join(','));r.setProperty('--gt2',mix(rgb(LK.glass),[0,0,0],.75).map(Math.round).join(','));
  r.setProperty('--ptx',LK.text);
  if(save)try{localStorage.setItem(LK_KEY,JSON.stringify(LK));}catch(e){}
}
function lkSync(){
  [['lk-wa','wa'],['lk-wb','wb'],['lk-hr','hr'],['lk-hs','hs']].forEach(([id,k])=>{const el=$(id);el.value=LK[k];const o=el.parentNode.querySelector('output');if(o)o.textContent=(k==='hr'||k==='hs')?(LK[k]/100).toFixed(1):LK[k];});
  [['lk-c-tab','tab'],['lk-c-glass','glass'],['lk-c-haze','haze'],['lk-c-text','text']].forEach(([id,k])=>{$(id).value=LK[k];});
}
[['lk-wa','wa'],['lk-wb','wb'],['lk-hr','hr'],['lk-hs','hs']].forEach(([id,k])=>{$(id).addEventListener('input',e=>{LK[k]=+e.target.value;const o=e.target.parentNode.querySelector('output');if(o)o.textContent=(k==='hr'||k==='hs')?(LK[k]/100).toFixed(1):LK[k];lkApply(true);});});
[['lk-c-tab','tab'],['lk-c-glass','glass'],['lk-c-haze','haze'],['lk-c-text','text']].forEach(([id,k])=>{$(id).addEventListener('input',e=>{LK[k]=e.target.value;lkApply(true);});});
$('lk-reset').onclick=()=>{LK=Object.assign({},LK_DEF);lkApply(true);lkSync();};
lkApply(false);lkSync();

/* ── Arrange / Close all ── */
window.hudArrange=function(){
  if(innerWidth<=700)return;
  const open=panels().filter(p=>p.classList.contains('open')),H=innerHeight-90,pd=12,ys=[64,64];
  open.forEach(p=>{
    const w=p.offsetWidth,h=p.offsetHeight;let c=ys[0]<=ys[1]?0:1;
    if(ys[c]+h>H&&ys[1-c]+h<=H)c=1-c;
    p.style.left=(c?innerWidth-pd-w:pd)+'px';p.style.top=ys[c]+'px';p.style.right='auto';p.style.bottom='auto';ys[c]+=h+10;});
};
window.hudCloseAll=function(){
  panels().forEach(x=>x.classList.remove('open'));
  try{_olCur=null;}catch(e){}try{clearInterval(window._olSync);}catch(e){}try{spOpen=false;}catch(e){}
};

/* ── typed / spoken commands (explicit wording only, so nothing PRAGON already handles is intercepted) ── */
window.tryHudCmd=function(txt){
  const t=(txt||'').trim();let m;
  if((m=/^(?:please\s+)?(open|show|close|hide)\s+(?:the\s+|my\s+)?(clock\s+(?:widget|panel)|music\s+(?:widget|panel)|panel\s+look)\s*[.!]?$/i.exec(t))){
    const on=/^(open|show)$/i.test(m[1]),k=m[2].toLowerCase(),id=k.indexOf('clock')===0?'clk-panel':k.indexOf('music')===0?'mus-panel':'look-panel';
    _fp(id,on);return true;}
  if(/^(?:please\s+)?(?:arrange|tidy|organi[sz]e)\s+(?:the\s+|my\s+)?(?:panels|widgets)\s*[.!]?$/i.test(t)){hudArrange();toast('Panels arranged');return true;}
  if(/^(?:please\s+)?close\s+(?:all|every)\s+(?:the\s+)?(?:panels|widgets)\s*[.!]?$/i.test(t)){hudCloseAll();toast('Panels closed');return true;}
  return false;
};

/* ── one animation loop: haze levels + music bars ── */
function loop(){
  const now=performance.now();
  if(M.an&&M.playing){
    M.an.getByteFrequencyData(M.buf);let sum=0;const n=M.buf.length;for(let k=0;k<n;k++)sum+=M.buf[k];
    musLvl=Math.min(1,sum/n/255*2.2);
    if($('mus-panel').classList.contains('open')&&bars){const c=bars.children,step=Math.max(1,Math.floor(n/c.length));
      for(let k=0;k<c.length;k++)c[k].style.height=(8+M.buf[k*step]/255*92)+'%';}
    if(M.sparkle){const o=orbApi();try{o&&o.setLevel(musLvl);}catch(e){}}
  }else{musLvl=0;if(bars&&bars.firstChild&&bars.firstChild.style.height!=='12%')Array.from(bars.children).forEach(b=>b.style.height='12%');}
  panels().forEach(p=>{
    if(!p.classList.contains('open'))return;
    let v=0;const g=gl[p.id];
    if(g){const k=1-(now-g.t0)/g.d;if(k>0)v=g.v*k*k;else delete gl[p.id];}
    try{if(p.id==='vs-panel')v=Math.max(v,Math.min(1,smoothVol*ORB_LEVEL_GAIN));}catch(e){}
    if(p.id==='mus-panel')v=Math.max(v,musLvl);
    p.style.setProperty('--wl',v.toFixed(3));
  });
  requestAnimationFrame(loop);
}
requestAnimationFrame(loop);
})();
</script>

<script src="/pw/static/pw.js" defer></script>
<script id="pragon-save">
/* PRAGON SAVE ALL — one button saves the whole UI to pragon_brain/ui_state.json on the PRAGON backend.
   The backend injects that file into the page before any script runs, so PRAGON reopens exactly as saved. */
const PragonSave=(function(){
  const SKIP_KEY=/token|secret|passw|api[_-]?key|authorization|pragon\.unsaved\.backup|^pv_device/i;
  const SKIP_ID=/^(txti|chatFileInput|plugin-file-input|sp-phoneview-)/;
  let dirty=false, busy=false;
  const $$=(q)=>Array.from(document.querySelectorAll(q));
  function mark(d){dirty=d;['saveall-btn','saveall-btn2'].forEach(id=>{const b=document.getElementById(id);if(b)b.classList.toggle('dirty',d);});}
  /* any settings edit or storage write since the last save lights the button */
  try{const _si=Storage.prototype.setItem;Storage.prototype.setItem=function(k,v){try{if(this===window.localStorage&&!SKIP_KEY.test(k)&&this.getItem(k)!==String(v))mark(true);}catch(e){}return _si.apply(this,arguments);};}catch(e){}
  document.addEventListener('change',e=>{if(e.target.closest&&e.target.closest('.spf,#clickexec-overlay'))mark(true);},true);
  document.addEventListener('input',e=>{if(e.target.closest&&e.target.closest('.spf'))mark(true);},true);

  function collect(){
    const ls={};
    for(let i=0;i<localStorage.length;i++){const k=localStorage.key(i);if(!SKIP_KEY.test(k))ls[k]=localStorage.getItem(k);}
    const fields={};
    $$('input[id],select[id],textarea[id]').forEach(el=>{
      if(SKIP_ID.test(el.id)||['password','file','button','submit','hidden'].includes(el.type))return;
      if(el.closest('iframe'))return;
      fields[el.id]=(el.type==='checkbox'||el.type==='radio')?{c:el.checked}:{v:el.value};
    });
    const toggles={};
    $$('.fg-toggle[id]').forEach(el=>{toggles[el.id]=el.classList.contains('on');});
    const layout={theme:document.documentElement.dataset.theme||null,perf:(window.PragonPerf&&PragonPerf._mode)||'auto',
                  settingsOpen:!!document.querySelector('.spf.open')};
    return {v:1,saved_at:Date.now(),ls,fields,toggles,layout};
  }

  function apply(S){
    if(!S)return;
    const f=S.fields||{};
    Object.keys(f).forEach(id=>{const el=document.getElementById(id);if(!el)return;
      if(el.type==='checkbox'||el.type==='radio'){el.checked=!!f[id].c;}
      else if(el.tagName==='SELECT'){if(Array.from(el.options).some(o=>o.value===f[id].v))el.value=f[id].v;}
      else{el.value=f[id].v;}
      if(el.type==='range')el.dispatchEvent(new Event('input',{bubbles:true})); /* refresh slider labels only */
    });
    const t=S.toggles||{};
    Object.keys(t).forEach(id=>{const el=document.getElementById(id);if(el)el.classList.toggle('on',!!t[id]);});
    if(S.layout&&S.layout.theme){document.documentElement.dataset.theme=S.layout.theme;}
    if(S.layout&&S.layout.perf&&window.PragonPerf)PragonPerf._mode=S.layout.perf;
  }

  async function saveAll(btn){
    if(busy)return;busy=true;if(btn)btn.classList.add('busy');
    try{
      /* Profile / Persona forms only mirror stored values after Settings has been opened (spLoadSaved).
         Commit them silently ONLY then, so an unopened (empty) form can never blank saved data. */
      if(typeof spOpen!=='undefined'&&spOpen){
        const _t=window.toast;window.toast=function(){};
        try{if(typeof spSaveProfile==='function')spSaveProfile();if(typeof spSavePersona==='function')spSavePersona();}catch(e){}
        finally{window.toast=_t;}
      }
      try{if(window.PW&&PW.saveAll)await PW.saveAll();}catch(e){}
      await new Promise(r=>setTimeout(r,320)); /* let debounced persisters (tool windows) write */
      const state=collect();
      const body=JSON.stringify(state);
      const r=await fetch('/api/ui-state/save',{method:'POST',headers:{'Content-Type':'application/json'},body});
      const j=await r.json();
      if(j.ok){mark(false);toast('Saved — PRAGON will reopen exactly like this ('+Math.max(1,Math.round(j.bytes/1024))+' KB)');}
      else toast('Save failed: '+(j.error||'unknown error'));
    }catch(e){toast('Save failed: '+e.message);}
    finally{busy=false;if(btn)btn.classList.remove('busy');}
  }

  /* re-apply the saved form values once the page and the backend have filled in their own defaults */
  function init(){const S=window.__PRAGON_SAVED__;if(!S||!S.ls)return;apply(S);setTimeout(()=>apply(S),1500);}
  if(document.readyState==='complete')init();else window.addEventListener('load',init);
  return {saveAll,collect,apply,get dirty(){return dirty;}};
})();
window.PragonSave=PragonSave;
</script>
