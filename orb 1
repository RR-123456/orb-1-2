function syncJarvisLogs(){
  try{
    const KEY='pragon_jarvis_logs';
    const arr=JSON.parse(localStorage.getItem(KEY)||'[]');
    const lastTs=parseInt(localStorage.getItem(KEY+'_last_ts')||'0',10);
    let maxTs=lastTs;
    arr.forEach(entry=>{
      if(entry.ts>lastTs){
        addPragonJarvisLogEntry(entry.title,entry.sub,entry.content);
        if(entry.ts>maxTs)maxTs=entry.ts;
      }
    });
    if(maxTs>lastTs)localStorage.setItem(KEY+'_last_ts',String(maxTs));
  }catch(e){/* ignore parse/storage errors */}
}
