#file-view-content{flex:1;margin:0;padding:16px;overflow:auto;font-family:var(--mono);font-size:11.5px;line-height:1.6;color:rgba(230,245,255,.88);white-space:pre-wrap;word-break:break-word}
#file-view-img{flex:1;width:100%;object-fit:contain;background:#050508;display:none}
#files-btn{position:relative;background:none;border:1px solid var(--border);color:rgba(18,144,255,.5);cursor:pointer;font-family:var(--mono);font-size:8px;letter-spacing:2px;padding:5px 10px;border-radius:3px;transition:all .25s;margin-left:8px;display:flex;align-items:center;gap:5px}
#files-btn:hover{color:var(--cyan);border-color:var(--cyan)}
#files-btn svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:1.5}
#files-badge{position:absolute;top:-5px;right:-5px;min-width:16px;height:16px;border-radius:50%;background:var(--cyan);color:#000;font-family:var(--mono);font-size:9px;font-weight:700;display:flex;align-items:center;justify-content:center;padding:0 4px;box-shadow:0 0 8px rgba(18,144,255,.4)}

#sp-chat-list{max-height:200px;overflow-y:auto}
#sp .lph,.spf .lph{margin-top:8px}
.spf{width:290px}

/* ── PRELOADER ── */
#init{position:fixed;inset:0;z-index:50;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:24px;background:#000;transition:opacity .8s;padding-bottom:80px}
