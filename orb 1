#ibtn:hover{background:rgba(18,144,255,.12);border-color:#1290ff;box-shadow:0 0 28px rgba(18,144,255,.2)}

/* ══════ P.R.A.G.O.N MODULE-7 (CAMERA + CHAT) ══════ */
#topbar .p7-topbtn{
  background:none;border:1px solid var(--border);color:rgba(18,144,255,.5);cursor:pointer;
  font-family:var(--mono);font-size:8px;letter-spacing:2px;padding:5px 10px;border-radius:3px;
  transition:all .25s;margin-left:8px;display:flex;align-items:center;gap:5px;
}
#topbar .p7-topbtn:hover{color:var(--cyan);border-color:var(--cyan);background:rgba(18,144,255,.08)}
#topbar .p7-topbtn.active{color:var(--cyan);border-color:var(--cyan);background:rgba(18,144,255,.1);box-shadow:0 0 10px rgba(18,144,255,.15)}
#topbar .p7-topbtn svg{width:11px;height:11px;stroke:currentColor;flex-shrink:0}

.p7-module{
  position:fixed; bottom:26px; right:26px; width:380px; max-width:calc(100vw - 32px); max-height:calc(100vh - 52px);
  background:#0a0a0f; border:1px solid rgba(18,144,255,.28); border-radius:14px;
  box-shadow:0 24px 70px rgba(0,0,0,.6), 0 2px 0 rgba(255,255,255,.02) inset;
  display:flex; flex-direction:column; overflow:hidden; z-index:900;
  animation:p7-pop-in .32s cubic-bezier(.2,.9,.25,1); font-family:'IBM Plex Mono',var(--mono),monospace; color:#e0e0e0;
}
.p7-module.p7-hidden{display:none;}
#p7-chatModule{right:calc(26px + 380px + 16px);}
@keyframes p7-pop-in{from{opacity:0; transform:translateY(14px) scale(.96);} to{opacity:1; transform:translateY(0) scale(1);}}
.p7-mod-header{display:flex; align-items:center; justify-content:space-between; padding:12px 14px; border-bottom:1px solid rgba(18,144,255,.12); flex-shrink:0; cursor:grab; user-select:none; touch-action:none;}
.p7-mod-header:hover{background:#0d1117;}
.p7-module.p7-dragging{transition:none !important; cursor:grabbing; box-shadow:0 30px 90px rgba(0,0,0,.7);}
.p7-module.p7-dragging .p7-mod-header{cursor:grabbing;}
.p7-brand{display:flex; align-items:center; gap:9px;}
.p7-brand-mark{width:40px;height:40px; border:1px solid rgba(18,144,255,.45); border-radius:50%; position:relative; flex-shrink:0; overflow:hidden; background:#000 url('data:image/png;base64,') center/cover no-repeat; box-shadow:0 0 8px rgba(18,144,255,.35);}
.p7-brand-mark::before{content:""; position:absolute; top:50%; left:50%; width:6px;height:6px; background:#1290ff; border-radius:50%; transform:translate(-50%,-50%); box-shadow:0 0 8px #1290ff, 0 0 16px rgba(18,144,255,.55); animation:p7-pulse-dot 2.4s ease-in-out infinite; z-index:2;}
@keyframes p7-pulse-dot{0%,100%{opacity:1;} 50%{opacity:.35;}}
.p7-brand-text h1{margin:0; font-size:13px; font-weight:600; letter-spacing:.1em; color:#1290ff; text-shadow:0 0 6px rgba(18,144,255,.55), 0 0 12px rgba(18,144,255,.3);}
.p7-brand-text p{margin:1px 0 0; font-size:8.5px; color:#073a66; letter-spacing:.1em; text-shadow:0 0 4px rgba(18,144,255,.2);}
.p7-header-actions{display:flex; align-items:center; gap:6px;}
.p7-icon-btn{width:26px;height:26px; border-radius:7px; border:1px solid transparent; background:transparent; display:flex; align-items:center; justify-content:center; cursor:pointer; color:#8899a6;}
.p7-icon-btn:hover{background:#050508; border-color:rgba(18,144,255,.28); color:#e0e0e0;}
.p7-icon-btn.active{color:#1290ff; border-color:#073a66; background:rgba(18,144,255,.08);}
.p7-icon-btn svg{width:14px;height:14px; stroke:currentColor;}
.p7-chevron{transition:transform .25s ease;}
.p7-module.p7-collapsed .p7-chevron{transform:rotate(-90deg);}
.p7-mod-body{display:flex; flex-direction:column; min-height:0; flex:1 1 auto; overflow-y:auto; overflow-x:hidden; scrollbar-width:thin; scrollbar-color:rgba(18,144,255,.28) transparent;}
.p7-mod-body::-webkit-scrollbar{width:6px;}
.p7-mod-body::-webkit-scrollbar-track{background:transparent;}
.p7-mod-body::-webkit-scrollbar-thumb{background:rgba(18,144,255,.28); border-radius:3px;}
.p7-mod-body::-webkit-scrollbar-thumb:hover{background:#073a66;}
.p7-module.p7-collapsed .p7-mod-body{max-height:0; overflow:hidden;}
.p7-viewport-wrap{padding:10px;}
.p7-viewport{position:relative; background:#000; border:1px solid rgba(18,144,255,.28); border-radius:10px; aspect-ratio:1/1; overflow:hidden;}
.p7-viewport video{position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transform:scaleX(-1); opacity:0; transition:opacity .6s ease;}
.p7-viewport video.p7-live{opacity:1;}
.p7-viewport canvas{position:absolute; inset:0; width:100%; height:100%; transform:scaleX(-1);}
.p7-bracket{position:absolute; width:16px;height:16px; border-color:#1290ff; opacity:.85; z-index:5; pointer-events:none;}
.p7-bracket.p7-tl{top:8px;left:8px;border-top:2px solid;border-left:2px solid;}
.p7-bracket.p7-tr{top:8px;right:8px;border-top:2px solid;border-right:2px solid;}
.p7-bracket.p7-bl{bottom:8px;left:8px;border-bottom:2px solid;border-left:2px solid;}
.p7-bracket.p7-br{bottom:8px;right:8px;border-bottom:2px solid;border-right:2px solid;}
.p7-scanline{position:absolute; left:0; right:0; height:2px; background:linear-gradient(90deg, transparent, #1290ff, transparent); box-shadow:0 0 10px #1290ff, 0 0 20px rgba(18,144,255,.55); top:0; opacity:0; z-index:4; pointer-events:none;}
.p7-scanline.p7-active{animation:p7-scan 2.6s ease-in-out infinite;}
@keyframes p7-scan{0%{top:0%;opacity:0;} 8%{opacity:.9;} 50%{top:98%;opacity:.9;} 58%{opacity:0;} 100%{top:0%;opacity:0;}}
.p7-idle-panel{position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:12px; z-index:6; text-align:center; padding:20px;}
.p7-idle-panel.p7-hidden{display:none;}
.p7-idle-panel p{margin:0; max-width:250px; font-size:10.5px; color:#8899a6; letter-spacing:.03em; line-height:1.6;}
.p7-idle-icon{width:44px;height:44px; border:1px solid rgba(18,144,255,.28); border-radius:50%; display:flex; align-items:center; justify-content:center;}
.p7-idle-icon svg{width:19px;height:19px; stroke:#8899a6;}
.p7-btn{font-family:inherit; font-size:10.5px; letter-spacing:.1em; font-weight:600; background:transparent; color:#1290ff; border:1px solid #073a66; padding:9px 16px; border-radius:8px; cursor:pointer; transition:all .15s ease; text-shadow:0 0 4px rgba(18,144,255,.2);}
.p7-btn:hover{background:rgba(18,144,255,.08); border-color:#1290ff; box-shadow:0 0 12px rgba(18,144,255,.15);}
.p7-btn:active{transform:translateY(1px);}
.p7-btn.p7-danger{color:#ff3366; border-color:#6b2c26;}
.p7-btn.p7-danger:hover{background:rgba(224,90,79,.08); border-color:#ff3366;}
.p7-btn.p7-small{padding:6px 10px; font-size:9px;}
.p7-strip{display:flex; align-items:center; justify-content:space-between; gap:6px; padding:9px 10px; font-size:9px; letter-spacing:.06em; color:#8899a6;}
.p7-strip .p7-cell span{color:#1290ff; text-shadow:0 0 4px rgba(18,144,255,.2);}
.p7-layer-row{display:flex; gap:8px; padding:0 10px 10px;}
.p7-layer-pill{flex:1; display:flex; align-items:center; gap:6px; border:1px solid rgba(18,144,255,.28); border-radius:8px; padding:7px 9px; cursor:pointer; font-size:9.5px; letter-spacing:.05em; color:#8899a6; background:#0d1117; transition:all .15s ease;}
.p7-layer-pill .p7-dot{width:7px;height:7px;border-radius:2px; background:#8899a6; flex-shrink:0;}
.p7-layer-pill.active{color:#1290ff; border-color:#073a66; text-shadow:0 0 4px rgba(18,144,255,.15);}
.p7-layer-pill.active .p7-dot{background:#1290ff; box-shadow:0 0 6px #1290ff, 0 0 10px rgba(18,144,255,.55);}

/* ══════ MODULE-7 CAMERA: extra rules for auth-gate, fullscreen, settings, AR templates, air-mouse ══════ */
body.p7-air-mouse-active *{cursor:none !important;}

.p7-module.p7-denied{
  border-color: rgba(255,51,102,.6);
  box-shadow:0 24px 70px rgba(0,0,0,.6), 0 0 30px rgba(255,51,102,.15), 0 2px 0 rgba(255,255,255,.02) inset;
}
/* Fullscreen state */
.p7-module.p7-fullscreen{
  position:fixed; top:0; left:0; right:auto; bottom:auto; width:100vw; height:100vh;
  max-width:none; max-height:none; border-radius:0; border:none; z-index:9999; animation:none; transition:none;
}
.p7-module.p7-fullscreen .p7-mod-body{max-height:none; overflow:hidden; height:100vh; flex:1 1 auto;}
.p7-module.p7-fullscreen .p7-viewport-wrap{padding:0; flex:1 1 auto; min-height:0; display:flex; flex-direction:column;}
.p7-module.p7-fullscreen .p7-viewport{border-radius:0; border:none; flex:1 1 auto; min-height:0; aspect-ratio:auto;}
.p7-module.p7-fullscreen .p7-mod-header{
  position:absolute; top:0; left:0; right:0; z-index:20; background:rgba(10,10,15,.8); backdrop-filter:blur(10px);
  border-bottom:1px solid rgba(18,144,255,.12); opacity:0; transition:opacity .2s ease;
}
.p7-module.p7-fullscreen:hover .p7-mod-header,
.p7-module.p7-fullscreen .p7-mod-header:hover{opacity:1;}
.p7-module.p7-fullscreen .p7-strip,
.p7-module.p7-fullscreen .p7-master-row,
.p7-module.p7-fullscreen .p7-layer-row{
  position:absolute; z-index:20; background:rgba(10,10,15,.8); backdrop-filter:blur(10px);
  border:1px solid rgba(18,144,255,.12); border-radius:10px; opacity:0; transition:opacity .2s ease; pointer-events:none;
}
.p7-module.p7-fullscreen .p7-strip{top:60px; left:14px; padding:8px 12px; gap:14px;}
.p7-module.p7-fullscreen .p7-master-row{top:60px; right:14px; padding:8px 12px;}
.p7-module.p7-fullscreen .p7-layer-row{bottom:14px; left:50%; transform:translateX(-50%); padding:8px 12px; flex-wrap:nowrap; white-space:nowrap;}
.p7-module.p7-fullscreen:hover .p7-strip,
.p7-module.p7-fullscreen:hover .p7-master-row,
.p7-module.p7-fullscreen:hover .p7-layer-row,
.p7-module.p7-fullscreen .p7-strip:hover,
.p7-module.p7-fullscreen .p7-master-row:hover,
.p7-module.p7-fullscreen .p7-layer-row:hover{opacity:1; pointer-events:auto;}
/* ══════ CAMERA BACKGROUND MODE ══════
   Once the feed is live it fills the screen BEHIND the orb (layer sits just under #orb-ui). The feed's edges fade out (vignette) and the orb's dot
   grid thins out to match (see orb.setCamera). Module-7's panel stays on top as a compact control panel. */
#p7-bgcam{position:fixed; inset:0; z-index:0; pointer-events:none; visibility:hidden;
  background:radial-gradient(circle at 50% 46%, #17191f 0, #090a0c calc(max(100vw,100vh)*.65)), #0a0b0d;}
#p7-bgcam.p7-on{visibility:visible;}
#p7-bgframe{position:absolute; inset:var(--bgm,30px); opacity:0; transition:opacity .45s ease;
  -webkit-mask-image:linear-gradient(to right,transparent 0,#000 var(--bgf,90px),#000 calc(100% - var(--bgf,90px)),transparent 100%),linear-gradient(to bottom,transparent 0,#000 var(--bgf,90px),#000 calc(100% - var(--bgf,90px)),transparent 100%);
  -webkit-mask-composite:source-in;
  mask-image:linear-gradient(to right,transparent 0,#000 var(--bgf,90px),#000 calc(100% - var(--bgf,90px)),transparent 100%),linear-gradient(to bottom,transparent 0,#000 var(--bgf,90px),#000 calc(100% - var(--bgf,90px)),transparent 100%);
  mask-composite:intersect;}
#p7-bgcam.p7-open #p7-bgframe{opacity:1; transition:opacity .9s ease .35s;}
#p7-bgcam .p7-viewport{position:absolute; inset:0; width:100%; height:100%; aspect-ratio:auto; border:none; border-radius:0; background:transparent; pointer-events:none;}
#p7-bgcam .p7-bracket,#p7-bgcam .p7-scanline{display:none;}
.p7-module.p7-bgmode .p7-viewport-wrap{display:none;}
body.p7-bgon #orb-pause{opacity:0; pointer-events:none;}
/* visible Camera button (the topbar one is hidden) — opens/closes the Camera module, glows while it is open */
#p7-camFab{position:fixed; left:18px; bottom:18px; z-index:5; width:40px; height:40px; padding:0; border-radius:50%; cursor:pointer;
  display:grid; place-items:center; color:#1290ff; background:rgba(10,12,18,.72); border:1px solid rgba(18,144,255,.4);
  backdrop-filter:blur(6px); -webkit-backdrop-filter:blur(6px); opacity:.75; transition:opacity .2s, box-shadow .2s, border-color .2s;}
#p7-camFab:hover{opacity:1; border-color:#1290ff; box-shadow:0 0 12px rgba(18,144,255,.4);}
#p7-camFab.active{opacity:1; border-color:#1290ff; box-shadow:0 0 14px rgba(18,144,255,.55); background:rgba(18,144,255,.18);}
#p7-zenOff{position:fixed; left:68px; bottom:18px; z-index:5; height:40px; padding:0 14px; border-radius:20px; cursor:pointer; display:none; align-items:center; gap:8px;
  font:600 11px/1 var(--mono,monospace); letter-spacing:.08em; color:#ffb020; background:rgba(10,12,18,.72); border:1px solid rgba(255,176,32,.45);
  backdrop-filter:blur(6px); -webkit-backdrop-filter:blur(6px); opacity:.8; transition:opacity .2s, box-shadow .2s;}
#p7-zenOff.on{display:flex;}
#p7-zenOff:hover{opacity:1; box-shadow:0 0 12px rgba(255,176,32,.4);}
#p7-zenOff svg{width:16px; height:16px; stroke:currentColor; fill:none; stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round;}
#p7-camFab svg{width:20px; height:20px; stroke:currentColor; fill:none; stroke-width:1.6; stroke-linecap:round; stroke-linejoin:round;}

.p7-module.p7-denied .p7-brand-mark::before{
  background:#ff3366; box-shadow:0 0 10px #ff3366, 0 0 20px rgba(255,51,102,.5);
  animation:p7-pulse-dot-denied 1.2s ease-in-out infinite;
}
@keyframes p7-pulse-dot-denied{0%,100%{opacity:1;} 50%{opacity:.2;}}
.p7-module.p7-denied .p7-brand-text h1{color:#ff3366; text-shadow: 0 0 6px rgba(255,51,102,.5), 0 0 12px rgba(255,51,102,.3);}

.p7-module.p7-denied .p7-viewport{border-color: rgba(255,51,102,.6); animation: p7-denied-pulse 1.5s ease-in-out infinite;}
@keyframes p7-denied-pulse{
