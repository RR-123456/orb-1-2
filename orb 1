.olpills{display:flex;gap:4px;flex-wrap:wrap;margin-bottom:4px}
/* FORGE PANEL */
#forge-wrap{position:fixed;top:64px;left:50%;transform:translateX(-50%);width:calc(100vw - 40px);max-width:1400px;bottom:90px;z-index:15;display:none;flex-direction:column;background:rgba(0,0,0,.88);border:1px solid var(--border);border-radius:4px;backdrop-filter:blur(20px);overflow:hidden;transition:all .4s}
