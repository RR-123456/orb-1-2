}

/* ================= MASTER FACE LOGIC ================= */

function updateMasterUI(){
  if(masterFace){
    masterInfo.innerHTML = '<strong>MASTER STORED</strong> &mdash; ' + masterFace.landmarks.length + ' points';
    saveMasterBtn.style.display = 'none';
